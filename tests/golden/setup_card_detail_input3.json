{"ok": true, "html": "<div style='margin-top:0;padding:0.75rem 0.85rem;border:1px solid var(--color-border);border-radius:8px;background:var(--color-surface-raised);font-size:0.95rem;line-height:1.5;'>\n          <p id=\"audio3_moved_note\" class=\"helptext\" style=\"text-align:left;margin:0 0 0.75rem;\">Bluetooth was moved here from Input 2 by the update.</p>\n          \n          <div style=\"display:flex;align-items:center;gap:0.75rem;margin-bottom:0.5rem;\">\n            <label class=\"output-toggle\" style=\"margin:0;\">\n              <input type=\"checkbox\" name=\"audio3_enabled\" checked onchange=\"btServicesToggle(this)\">\n              <span class=\"switch\"></span>\n            </label>\n            <span>Enable</span>\n          </div>\n          <p class=\"helptext\" style=\"text-align:left;margin:0 0 0.5rem;\">Connect a Bluetooth device (such as a turntable with Bluetooth output) as an audio input.</p>\n          <div id=\"audio3_settings\" style=\"display:block;\">\n            \n            <p id=\"btAdapterRow\" style=\"margin:0.5rem 0;font-size:0.9rem;\">Adapter: No Bluetooth adapter found \u2014 plug in a USB adapter, or enable the onboard device below.</p>\n            <div style=\"display:flex;align-items:center;gap:.75rem;margin-top:.5rem;\">\n              <label class=\"output-toggle\" style=\"margin:0;\">\n                <input type=\"checkbox\" id=\"btOnboardToggle\"\n                  onchange=\"btOnboardToggleChanged(this.checked)\">\n                <span class=\"switch\"></span>\n              </label>\n              <span>Use onboard bluetooth device</span>\n            </div>\n            <div id=\"btOnboardHelp\" style=\"font-size:0.75rem;color:#888;margin-top:0.25rem;\">\n              A USB Bluetooth adapter is strongly recommended: Bluetooth audio can break up on the onboard radio while streaming over Wi-Fi. Changing this restarts the appliance.\n            </div>\n            <div id=\"btAdapterGatedRow\" style=\"margin:0.75rem 0;opacity:0.4;pointer-events:none;\">\n              <p id=\"btPairedRow\" style=\"margin:0 0 0.5rem;\">No device paired</p>\n              <button type=\"button\" id=\"btnBtForget\" class=\"pill-btn small\" style=\"width:100%;display:none;\"\n                onclick=\"btForgetFromCard()\">Forget</button>\n              <button type=\"button\" id=\"btnBtPairNew\" class=\"pill-btn small\" style=\"width:100%;margin-top:0.5rem;\"\n                onclick=\"openBtPairingModal()\">Pair a device&hellip;</button>\n            </div>\n            <label>Input type: <select name=\"audio3_input_type\" id=\"audio3_input_type\" data-current-type=\"turntable\" data-presets='{\"turntable\": -45.0, \"cd\": -60.0, \"line\": -60.0}' onchange=\"onInputTypeChange(3, this.value)\"><option value=\"turntable\" selected>Turntable</option><option value=\"cd\">CD</option><option value=\"line\">Line</option></select></label>\n            <label><div class=\"slider-header\"><span>Sensitivity:</span><span id=\"audio3_silence_threshold_val\">-45 dB</span></div>\n            <input type=\"range\" min=\"-70\" max=\"-30\" step=\"1\" id=\"audio3_silence_threshold\" name=\"audio3_silence_threshold\" value=\"-45\" oninput=\"syncSilenceThreshold(3, this.value)\"></label>\n            <div id=\"audio3_sensitivity_note\" class=\"helptext\" style=\"text-align:left;\">\n              Further left picks up quieter audio; further right ignores more background noise.\n            </div>\n            <div class=\"helptext\" style=\"text-align:left;\">\n              Level: <span id=\"audio3_level_val\">no level</span>\n            </div>\n            \n            <div id=\"audio3_start_after_wrap\">\n              <div class=\"slider-header\">\n                <span>Start after:</span>\n                <button type=\"button\" class=\"pill-btn small\" onclick=\"startAfterReset(3)\">Reset</button>\n              </div>\n              <div class=\"value-stepper\" id=\"audio3_start_after_stepper\" role=\"group\" aria-label=\"Start after\">\n                <button type=\"button\" class=\"pill-btn\" data-step=\"-100\" aria-label=\"100 ms sooner\" onclick=\"startAfterStep(3, -100)\">&minus;100</button>\n                <button type=\"button\" class=\"pill-btn\" data-step=\"-10\" aria-label=\"10 ms sooner\" onclick=\"startAfterStep(3, -10)\">&minus;10</button>\n                <div class=\"value-stepper-value\" aria-live=\"polite\"><span id=\"audio3_start_after_val\"\n                     data-ms=\"60\">60</span><span class=\"unit\">ms</span></div>\n                <button type=\"button\" class=\"pill-btn\" data-step=\"10\" aria-label=\"10 ms later\" onclick=\"startAfterStep(3, 10)\">+10</button>\n                <button type=\"button\" class=\"pill-btn\" data-step=\"100\" aria-label=\"100 ms later\" onclick=\"startAfterStep(3, 100)\">+100</button>\n              </div>\n              <div class=\"helptext\" style=\"text-align:left;\">\n                Playback starts once the level has been above Sensitivity for this long within one second. Longer ignores more clicks and knocks; shorter cuts less from the start of a record.\n              </div>\n            </div>\n            <div id=\"audio3_sample_rate\" class=\"helptext\" style=\"text-align:left;\">\n              Sample rate: not running\n            </div>\n            <div style=\"display:flex;align-items:center;gap:0.75rem;margin-top:0.9rem;\">\n              <label class=\"output-toggle\" style=\"margin:0;\">\n                <input type=\"checkbox\" id=\"audio3_dynamic_rate_matching\" checked onchange=\"if(liveEnabled) settingsSaveField('audio3.dynamic_rate_matching', this.checked);\">\n                <span class=\"switch\"></span>\n              </label>\n              <span>Dynamic Rate Matching</span>\n            </div>\n            <div id=\"audio3_rate_matching_note\" class=\"helptext\" style=\"text-align:left;\">\n              Follows the sample rate of the source. Turn on for an optical (S/PDIF) adapter fed by a CD or DVD player.\n            </div>\n          </div>\n        </div><div id=\"audio3_preamp_card\" style=\"display:block;\"><div style='margin-top:0.75rem;padding:0.75rem 0.85rem;border:1px solid var(--color-border);border-radius:8px;background:var(--color-surface-raised);font-size:0.95rem;line-height:1.5;'>\n      <label><div class=\"slider-header\"><span>Gain:</span><span id=\"audio3_gain_db_val\">1 dB</span></div>\n      <input type=\"range\" min=\"-10\" max=\"10\" step=\"1\" id=\"audio3_gain_db\" name=\"audio3_gain_db\" value=\"1\" oninput=\"syncGain(3, this.value)\"></label>\n      <div class=\"slider-header\" style=\"margin-top:.75rem;align-items:center;\">\n        <strong>Equaliser</strong>\n      </div>\n      <div class=\"eq-bands-wrap\" style=\"margin-top:0.5rem;\">\n        <div class=\"eq-bands-row\">\n          <div class=\"eq-band\">\n            <span class=\"eq-band-freq\">40Hz</span>\n            <input\n              type=\"range\"\n              class=\"eq-band-slider\"\n              min=\"-10\"\n              max=\"10\"\n              step=\"1\"\n              id=\"audio3_eq_40hz_db\"\n              name=\"audio3_eq_40hz_db\"\n              value=\"0\"\n              aria-label=\"40Hz equaliser\"\n              oninput=\"syncEq(3, '40hz', this.value)\">\n            <span class=\"eq-band-val\" id=\"audio3_eq_40hz_db_val\">0 dB</span>\n          </div>\n          <div class=\"eq-band\">\n            <span class=\"eq-band-freq\">Bass</span>\n            <input\n              type=\"range\"\n              class=\"eq-band-slider\"\n              min=\"-10\"\n              max=\"10\"\n              step=\"1\"\n              id=\"audio3_eq_100hz_db\"\n              name=\"audio3_eq_100hz_db\"\n              value=\"0\"\n              aria-label=\"Bass equaliser\"\n              oninput=\"syncEq(3, '100hz', this.value)\">\n            <span class=\"eq-band-val\" id=\"audio3_eq_100hz_db_val\">0 dB</span>\n          </div>\n          <div class=\"eq-band\">\n            <span class=\"eq-band-freq\">Treble</span>\n            <input\n              type=\"range\"\n              class=\"eq-band-slider\"\n              min=\"-10\"\n              max=\"10\"\n              step=\"1\"\n              id=\"audio3_eq_8khz_db\"\n              name=\"audio3_eq_8khz_db\"\n              value=\"0\"\n              aria-label=\"Treble equaliser\"\n              oninput=\"syncEq(3, '8khz', this.value)\">\n            <span class=\"eq-band-val\" id=\"audio3_eq_8khz_db_val\">0 dB</span>\n          </div>\n        </div>\n      </div>\n    </div></div><div id=\"audio3_buffer_card\" style=\"display:block;\"><div style='margin-top:0.75rem;padding:0.75rem 0.85rem;border:1px solid var(--color-border);border-radius:8px;background:var(--color-surface-raised);font-size:0.95rem;line-height:1.5;'>\n          <input type=\"hidden\" name=\"bluetooth_present\" value=\"1\">\n          <label style=\"display:block;\">\n            <div class=\"slider-header\"><span>Bluetooth Audio Buffer:</span><span id=\"btBufferVal\">200 ms</span></div>\n            <input type=\"range\" id=\"btBufferRange\" min=\"100\" max=\"500\"\n              step=\"10\" value=\"200\" oninput=\"btBufferInput(this.value)\">\n            <div class=\"helptext\">Larger values ride out wireless glitches; smaller values reduce the\n              delay before you hear the needle drop.</div>\n          </label>\n        </div></div>"}