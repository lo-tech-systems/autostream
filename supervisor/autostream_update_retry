#!/usr/bin/python3
"""autostream_update_retry

Boot-time service that detects and recovers from an interrupted update caused
by a watchdog reset.  Invoked once per boot by autostream_update_retry.service,
ordered before autostream_monitor.service and autostream.service.

Recovery condition (all must hold):
  - /var/lib/autostream/update-result.env has STATUS=in_progress
  - LAST_RUN_AT in that file predates the current boot (update was interrupted)
  - /var/lib/autostream-update is a directory only root can use, and the
    marker root wrote there when the update was staged is present
  - /var/lib/autostream-update/staging/src/<dir>/autostream_install.sh exists
    and is executable
  - retry_count in the staging dir is below MAX_RETRIES

Everything root runs or reads back here comes from /var/lib/autostream-update.
update-result.env sits in a directory the service account owns, so it only
says that an update may have been interrupted; it never selects what runs.
When the staged files are absent or not trustworthy the update is marked
failed and the appliance carries on with what it has.

On recovery:
  1. Write /tmp/autostream-updating  (nginx redirect flag — sends web hits to
     the /offline/updating progress page for the duration of the retry)
  2. Increment retry_count in the staging dir
  3. Write update-result.env with a "Retrying update (attempt N of MAX)" message
     so the progress page shows meaningful status
  4. Best-effort: stop OwnTone playback and free the autostream_monitor repeat
     buffer before scheduling the heavy installer work (same helpers used by
     autostream_updater cmd_apply; typically a no-op here since this runs at
     boot before autostream_monitor.service and autostream.service start)
  5. Schedule autostream_install.sh --update via systemd-run (same mechanism
     used by autostream_updater for normal updates)

The installer's on_exit trap removes /tmp/autostream-updating on completion
(success or failure).  If the watchdog fires again during a retry the cycle
repeats until MAX_RETRIES is reached, after which the update is marked failed
and the user is asked to retry manually from the web UI.

Copyright (c) 2025-2026 Lo-tech Systems Limited. All rights reserved.
"""

from __future__ import annotations

import os
import shutil
import sys
import time
from datetime import datetime
from pathlib import Path

_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

from autostream_update_support import (
    FLOCK_BIN, UPDATE_STATE_DIR,
    _find_systemd_run, _is_pre_boot, _read_env_file, _run,
    clear_update_in_progress, free_repeat_buffer, read_update_in_progress,
    stop_owntone_playback, trusted_state_dir, valid_release_tag,
    write_file_safely,
)

# ---- Paths / constants -------------------------------------------------------
STAMP_DIR          = Path("/var/lib/autostream")
UPDATE_RESULT_FILE = STAMP_DIR / "update-result.env"
# What root runs and trusts is in the directory only root can write; the user
# whose ownership it must have is root outside the tests.
UPDATE_STATE_UID   = 0
STAGING_DIR        = UPDATE_STATE_DIR / "staging"
RELEASE_TAG_FILE   = STAGING_DIR / "release_tag"
RETRY_COUNT_FILE   = STAGING_DIR / "retry_count"
UPDATING_FLAG      = Path("/tmp/autostream-updating")
LOG_PATH           = Path("/var/log/autostream/update.log")
UPDATE_LOCK_FILE   = Path("/run/autostream-update.lock")

MAX_RETRIES = 3


# ---- Logging -----------------------------------------------------------------

def _log(msg: str) -> None:
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with LOG_PATH.open("a", encoding="utf-8") as f:
        f.write(f"[{ts}] [update-retry] {msg}\n")


# ---- State helpers -----------------------------------------------------------

def _staged_tag() -> str | None:
    """The tag of the update root staged, or None when root left no record.

    The directory must be one only root can use, and the marker in it must be
    a file root wrote there.
    """
    return read_update_in_progress(STAGING_DIR, UPDATE_STATE_UID)


def _find_installer() -> Path | None:
    """Return the staged autostream_install.sh if present and executable."""
    src_dir = STAGING_DIR / "src"
    if not src_dir.is_dir():
        return None
    for child in src_dir.iterdir():
        if not child.is_dir():
            continue
        candidate = child / "autostream_install.sh"
        if candidate.is_file() and os.access(str(candidate), os.X_OK):
            return candidate
    return None


def _read_retry_count() -> int:
    try:
        text = RETRY_COUNT_FILE.read_text(encoding="utf-8").strip()
        return max(0, int(text)) if text.isdigit() else 0
    except Exception:
        return 0


def _write_retry_count(n: int) -> None:
    write_file_safely(RETRY_COUNT_FILE, str(n) + "\n", 0o600)


def _write_update_result(status: str, message: str, percent: int, run_at: str) -> None:
    """Atomically write update-result.env (mirrors the installer's write_update_result)."""
    STAMP_DIR.mkdir(parents=True, exist_ok=True)
    content = (
        f'LAST_RUN_AT="{run_at}"\n'
        f'STATUS="{status}"\n'
        f'MESSAGE="{message}"\n'
        f'PERCENT_COMPLETE="{percent}"\n'
    )
    write_file_safely(UPDATE_RESULT_FILE, content, 0o600, (0, 0))
    if status in ("success", "failure"):
        # A final result ends the interrupted-update window.
        clear_update_in_progress(STAGING_DIR, UPDATE_STATE_UID)


def _remove_legacy_staging() -> None:
    """Remove what an older release staged in the service account's directory.

    Nothing reads it there any more, so it is not left to be mistaken for a
    staged update.  A link is unlinked; a directory is removed without
    following anything in it.
    """
    for name in ("update-staging", "update-stopped-services.env"):
        path = STAMP_DIR / name
        try:
            if path.is_symlink() or path.is_file():
                path.unlink()
            elif path.is_dir():
                shutil.rmtree(str(path), ignore_errors=True)
        except OSError as e:
            _log(f"could not remove {path}: {e}")


# ---- Main --------------------------------------------------------------------

def main() -> int:
    if os.geteuid() != 0:
        print("autostream_update_retry: must run as root", file=sys.stderr)
        return 2

    # 1. Check for an interrupted update.
    env = _read_env_file(UPDATE_RESULT_FILE)
    status    = env.get("STATUS", "")
    last_run_at = env.get("LAST_RUN_AT", "")

    if status != "in_progress":
        _remove_legacy_staging()
        _log(f"no interrupted update (status={status!r}); nothing to do")
        return 0

    if not _is_pre_boot(last_run_at):
        _log("update in_progress but not pre-boot; skipping (update may be running)")
        return 0

    # 2. Verify the staged installer is available, in the directory only root
    #    can use and with the marker root wrote there.
    try:
        trusted_state_dir(STAGING_DIR.parent, UPDATE_STATE_UID)
        staged_tag = _staged_tag()
    except (OSError, ValueError) as e:
        _log(f"update state directory not usable ({e}); cannot retry")
        staged_tag = None
    installer = _find_installer() if staged_tag is not None else None
    if installer is None:
        _log("interrupted update detected but no staged installer found; cannot retry")
        now_str = datetime.now().astimezone().isoformat(timespec="seconds")
        _write_update_result(
            "failure",
            "Update was interrupted and recovery files are unavailable. Please retry from the setup page.",
            0,
            now_str,
        )
        return 1

    # 3. Check retry cap.
    retry_count = _read_retry_count()
    if retry_count >= MAX_RETRIES:
        _log(f"retry cap reached ({retry_count}/{MAX_RETRIES}); marking update failed")
        now_str = datetime.now().astimezone().isoformat(timespec="seconds")
        _write_update_result(
            "failure",
            f"Update failed after {MAX_RETRIES} attempt(s). Please retry from the web UI.",
            0,
            now_str,
        )
        return 1

    # 4. Read candidate tag (best-effort; "unknown" is acceptable — the installer
    #    falls back gracefully and writes "unknown" to install-state.env).
    try:
        release_tag = RELEASE_TAG_FILE.read_text(encoding="utf-8").strip()
        if not release_tag:
            raise ValueError("empty")
        if not valid_release_tag(release_tag):
            raise ValueError("not a version")
    except Exception:
        release_tag = staged_tag if valid_release_tag(staged_tag) else "unknown"
        _log(f"release_tag file missing or unusable; proceeding with tag={release_tag}")

    attempt = retry_count + 1
    _log(
        f"scheduling retry: attempt={attempt}/{MAX_RETRIES} "
        f"tag={release_tag!r} installer={installer}"
    )

    # 5. Write nginx redirect flag so web hits go to /offline/updating.
    UPDATING_FLAG.touch(mode=0o644)

    # 6. Increment persisted retry count *before* firing the installer so that a
    #    second watchdog reset during this retry is counted correctly.
    _write_retry_count(attempt)

    # 7. Write update-result.env so the /offline/updating page shows retry state
    #    immediately (the installer will overwrite this with phase progress once it
    #    starts running).
    run_at = datetime.now().astimezone().isoformat(timespec="seconds")
    _write_update_result(
        "in_progress",
        f"Retrying update (attempt {attempt} of {MAX_RETRIES})",
        0,
        run_at,
    )

    # 8. Best-effort pre-update teardown: stop playback and free the repeat
    #    buffer before scheduling the installer's heavy work, mirroring
    #    autostream_updater cmd_apply's same call (see autostream_update_support
    #    for the shared implementation).  At boot, before autostream_monitor.
    #    service starts, OwnTone and the monitor are typically not even up yet,
    #    so these calls are expected to no-op via their "socket/service
    #    unavailable" paths most of the time -- harmless, never fatal.
    try:
        ok, msg = stop_owntone_playback()
        _log(f"pre-update playback stop {'ok' if ok else 'failed (continuing)'}: {msg}")
    except Exception as e:
        _log(f"pre-update playback stop raised unexpectedly (continuing): {e}")

    try:
        ok, msg = free_repeat_buffer()
        _log(f"pre-update repeat-buffer free {'ok' if ok else 'failed (continuing)'}: {msg}")
    except Exception as e:
        _log(f"pre-update repeat-buffer free raised unexpectedly (continuing): {e}")

    # 9. Schedule the installer as a transient systemd unit (same pattern as
    #    autostream_updater cmd_apply).
    systemd_run = _find_systemd_run()
    if systemd_run is None:
        _log("systemd-run not found; cannot schedule retry")
        _write_update_result("failure", "Cannot retry: systemd-run not found", 0, run_at)
        UPDATING_FLAG.unlink(missing_ok=True)
        return 1

    if not (os.path.isfile(FLOCK_BIN) and os.access(FLOCK_BIN, os.X_OK)):
        _log(f"{FLOCK_BIN} not found or not executable; cannot schedule locked retry")
        _write_update_result("failure", "Cannot retry: flock not found", 0, run_at)
        UPDATING_FLAG.unlink(missing_ok=True)
        return 1

    unit_suffix = f"{int(time.time())}-{os.getpid()}"
    unit_name   = f"autostream-update-retry-{unit_suffix}"

    cmd = [
        systemd_run,
        "--quiet",
        "--collect",
        f"--unit={unit_name}",
        "--on-active=2",
        "--property=Type=oneshot",
        "--property=After=NetworkManager.service",
        "--property=Wants=NetworkManager.service",
        f"--setenv=AUTOSTREAM_RELEASE_TAG={release_tag}",
        "--",
        FLOCK_BIN, "--exclusive", str(UPDATE_LOCK_FILE),
        str(installer),
        "--update",
    ]

    try:
        rc, out, err = _run(cmd, timeout=15)
    except Exception as exc:
        _log(f"systemd-run subprocess error: {exc}")
        _write_update_result("failure", "Failed to schedule retry", 0, run_at)
        UPDATING_FLAG.unlink(missing_ok=True)
        return 1

    if rc != 0:
        _log(f"systemd-run failed rc={rc} stderr={err!r}")
        _write_update_result("failure", "Failed to schedule retry installer", 0, run_at)
        UPDATING_FLAG.unlink(missing_ok=True)
        return 1

    _log(f"retry scheduled as transient unit {unit_name!r}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
