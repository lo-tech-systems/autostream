#!/usr/bin/env python3
"""autostream-updater

Copyright (c) 2025-2026 Lo-tech Systems Limited. All rights reserved.

Root-only helper used by the Autostream web UI.

COMMANDS
--------
  check   Check whether a newer release is available on GitHub.
          Outputs JSON: {ok, installed, candidate, update_available, apmode}

  apply   Stage the latest GitHub release and invoke autostream_install.sh
          --update via a transient systemd unit (escaping the service cgroup).
          Outputs JSON: {ok, staged_tag} on success, {ok:false, error} on failure.
          The installer owns all progress/result reporting via update-result.env.

NOTES
-----
- Must run as root.
- The installer (autostream_install.sh) is the authoritative writer of both
  install-state.env (applied version) and update-result.env (progress/result).
- This helper does not write install-state.env or update-result.env directly.
- Staging location: /var/lib/autostream/update-staging/  (root-owned, cleaned
  at the start of each apply run so stale extracts do not accumulate).
"""

from __future__ import annotations

import configparser
import errno
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import time
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, Optional, Tuple

# ---- Paths / constants ----
LOG_PATH = Path("/var/log/autostream/update.log")
APMODE_FLAG = Path("/tmp/apmode")
INSTALL_STATE_FILE = Path("/var/lib/autostream/install-state.env")
UPDATE_LOCK_FILE = Path("/run/autostream-update.lock")
FLOCK_BIN = "/usr/bin/flock"
UPDATE_RESULT_FILE = Path("/var/lib/autostream/update-result.env")
STAGING_DIR = Path("/var/lib/autostream/update-staging")
CONFIG_PATH = Path("/opt/autostream/autostream.ini")
PLAYING_SERVICE = Path("/etc/avahi/services/autostream-playing.service")

# GitHub repo
REPO_OWNER = "lo-tech-systems"
REPO_NAME = "autostream"
RELEASES_HTML = f"https://github.com/{REPO_OWNER}/{REPO_NAME}/releases"
API_LATEST = f"https://api.github.com/repos/{REPO_OWNER}/{REPO_NAME}/releases/latest"

# A conservative user-agent helps avoid 403s.
UA = "autostream-updater/1.0 (+https://github.com/lo-tech-systems/autostream)"

# systemd-run candidates
SYSTEMDRUN_CANDIDATES = (
    "/bin/systemd-run",
    "/usr/bin/systemd-run",
)


# ---- Helpers ----

def _log(msg: str) -> None:
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with LOG_PATH.open("a", encoding="utf-8") as f:
        f.write(f"[{ts}] {msg}\n")


def _run(cmd: list[str], timeout: int = 60) -> Tuple[int, str, str]:
    p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    return p.returncode, (p.stdout or "").strip(), (p.stderr or "").strip()


def _http_get(url: str, timeout: int = 20) -> Tuple[int, bytes]:
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        status = getattr(resp, "status", 200)
        return status, resp.read()


def _repo_exists() -> bool:
    """Return True if the repo releases page is reachable (not 404)."""
    try:
        req = urllib.request.Request(RELEASES_HTML, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=10) as resp:
            return getattr(resp, "status", 200) < 400
    except urllib.error.HTTPError as e:
        return False if e.code == 404 else False
    except Exception:
        return False


def _read_env_file(path: Path) -> Dict[str, str]:
    data: Dict[str, str] = {}
    text = path.read_text(encoding="utf-8")
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
            value = value[1:-1]
        data[key] = value
    return data


def _read_installed_release_tag() -> str:
    try:
        env = _read_env_file(INSTALL_STATE_FILE)
        v = str(env.get("AUTOSTREAM_RELEASE_TAG") or "").strip()
        if v:
            return v
    except FileNotFoundError:
        return "missing"
    except Exception as e:
        _log(f"read_installed_release_tag: install-state read failed: {e}")
        return "unknown"
    return "unknown"


_semver_re = re.compile(r"^v?(\d+)(?:\.(\d+))?(?:\.(\d+))?(?:[-+].*)?$")


def _version_key(v: str) -> Tuple[int, int, int, str]:
    """Return a comparison key for typical vMAJOR.MINOR.PATCH style tags."""
    m = _semver_re.match((v or "").strip())
    if not m:
        return (0, 0, 0, v or "")
    maj = int(m.group(1) or 0)
    min_ = int(m.group(2) or 0)
    pat = int(m.group(3) or 0)
    return (maj, min_, pat, v or "")


def _sanitise_release_notes(text: str, max_len: int = 200) -> str:
    """Return a sanitised plain-text summary from a GitHub release body.

    Only printable ASCII is kept so that unexpected Unicode, control characters,
    or binary content from the API cannot reach the UI or break JSON encoding.
    Multiple whitespace runs are collapsed to a single space.
    """
    cleaned = "".join(ch for ch in text if 0x20 <= ord(ch) <= 0x7E)
    cleaned = " ".join(cleaned.split())
    return cleaned[:max_len].strip()


def _github_latest_release() -> Tuple[Optional[str], Optional[str], Optional[str], Optional[str]]:
    """Return (tag_name, tarball_url, html_url, release_notes) from GitHub latest release."""
    try:
        status, raw = _http_get(API_LATEST, timeout=20)
        if status == 404:
            return None, None, None, None
        data = json.loads(raw.decode("utf-8", errors="replace"))
        tag = data.get("tag_name")
        tarball = data.get("tarball_url")
        html = data.get("html_url")
        raw_body = data.get("body") or ""
        notes = _sanitise_release_notes(str(raw_body)) if raw_body else None
        if not tag:
            return None, None, html, notes
        return str(tag), (str(tarball) if tarball else None), (str(html) if html else None), notes
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None, None, None, None
        _log(f"github_latest_release: HTTPError {e.code}")
        return None, None, None, None
    except Exception as e:
        _log(f"github_latest_release: exception {e}")
        return None, None, None, None


def _download_file(url: str, dst: Path, timeout: int = 120) -> None:
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        dst.parent.mkdir(parents=True, exist_ok=True)
        with dst.open("wb") as f:
            shutil.copyfileobj(resp, f)


def _find_systemd_run() -> Optional[str]:
    """Return an absolute path to systemd-run if available, else None."""
    for path in SYSTEMDRUN_CANDIDATES:
        if os.path.exists(path) and os.access(path, os.X_OK):
            return path
    p = shutil.which("systemd-run")
    if p and os.path.isabs(p) and os.access(p, os.X_OK):
        return p
    return None


def _update_unit_active() -> bool:
    """Return True if an autostream update installer unit is currently running.

    Raises RuntimeError on systemctl failure so callers used for admission
    control can reject the request conservatively rather than failing open.
    """
    rc, out, err = _run(
        ["systemctl", "list-units", "--state=active", "--no-legend", "--plain",
         "autostream-update-*"],
        timeout=10,
    )
    if rc != 0:
        raise RuntimeError(f"systemctl exited rc={rc}: {err!r}")
    return bool(out.strip())


# ---- Auto-update config helper ----

def _read_auto_update_config() -> bool:
    """Return True if [updates] auto_update = yes in autostream.ini."""
    p = configparser.ConfigParser()
    try:
        p.read(str(CONFIG_PATH))
        return p.getboolean("updates", "auto_update", fallback=False)
    except Exception:
        return False


# ---- Commands ----

def cmd_check() -> Dict[str, Any]:
    apmode = APMODE_FLAG.exists()

    if not _repo_exists():
        _log("check: GitHub releases page not reachable / 404")
        return {"ok": False, "error": "GitHub repo/releases not reachable (404 or network error)", "apmode": apmode}

    installed = _read_installed_release_tag()

    tag, _tarball_url, html_url, notes = _github_latest_release()
    if not tag:
        update_available = installed == "missing"
        _log(f"check: repo ok but no latest release tag; installed={installed}; update_available={update_available}")
        return {
            "ok": True,
            "installed": installed if installed != "missing" else "unknown",
            "candidate": "unknown",
            "update_available": update_available,
            "apmode": apmode,
            "source": "github",
        }

    candidate = tag.lstrip("v")

    if installed == "missing":
        update_available = True
        installed_out = "unknown"
    else:
        installed_out = installed
        update_available = _version_key(candidate) > _version_key(installed)

    _log(
        f"check: installed={installed_out} candidate={candidate} update_available={update_available} url={html_url or RELEASES_HTML}"
    )

    result: Dict[str, Any] = {
        "ok": True,
        "installed": installed_out,
        "candidate": candidate,
        "update_available": update_available,
        "apmode": apmode,
        "source": "github",
    }
    if update_available and notes:
        result["release_notes"] = notes
    return result


def cmd_apply(auto: bool = False) -> Dict[str, Any]:
    """Stage the latest GitHub release and schedule the installer via systemd-run.

    Sequence:
      1. If auto=True: skip if auto_update disabled in config, playback active,
         or no update available.
      2. Refuse if in AP mode.
      3. Resolve the latest release tag from GitHub.
      4. Clean up any previous staging directory.
      5. Download and extract the release tarball to the staging directory.
      6. Locate autostream_install.sh in the extracted tree.
      7. Schedule autostream_install.sh --update as a transient systemd unit,
         exporting AUTOSTREAM_RELEASE_TAG into the installer environment.
      8. Return {ok: True, staged_tag: <tag>} immediately.

    The installer owns all further progress reporting via update-result.env.
    The installer restarts autostream.service on completion; no explicit reboot
    is required for the update to take effect.
    """
    if auto and not _read_auto_update_config():
        _log("apply: auto mode — auto_update disabled in config, skipping")
        return {"ok": True, "skipped": True, "reason": "auto_update_disabled"}

    if auto and PLAYING_SERVICE.exists():
        _log("apply: auto mode — playback active, skipping")
        return {"ok": True, "skipped": True, "reason": "playback_active"}

    if APMODE_FLAG.exists():
        _log("apply: refused in AP mode")
        return {"ok": False, "error": "Refusing to update while in AP mode (/tmp/apmode present)."}

    # Fast-path unit check (fail-closed: any systemctl error → refuse).
    try:
        if _update_unit_active():
            _log("apply: refused — an update installer unit is already active")
            return {"ok": False, "error": "An update is already in progress. Please wait for it to complete."}
    except Exception as e:
        _log(f"apply: refused — unable to determine update unit status: {e}")
        return {"ok": False, "error": "Unable to verify update status. Please try again shortly."}

    # Version guard — skip if already at latest (all runs, including manual).
    check = cmd_check()
    if not check.get("ok"):
        _log(f"apply: version check failed: {check.get('error', 'unknown')}")
        return {"ok": False, "error": f"Version check failed: {check.get('error', 'unknown')}"}
    if not check.get("update_available"):
        _log(f"apply: already at latest ({check.get('installed')!r}) — no-op")
        return {"ok": True, "staged_tag": None}

    systemd_run = _find_systemd_run()
    if systemd_run is None:
        _log("apply: systemd-run not found; cannot schedule installer")
        return {"ok": False, "error": "systemd-run not found; cannot schedule installer"}

    if not (os.path.isfile(FLOCK_BIN) and os.access(FLOCK_BIN, os.X_OK)):
        _log(f"apply: {FLOCK_BIN} not found or not executable; cannot schedule locked installer")
        return {"ok": False, "error": f"flock not found at {FLOCK_BIN}; cannot schedule installer"}

    if not _repo_exists():
        _log("apply: GitHub releases page not reachable / 404")
        return {"ok": False, "error": "GitHub repo/releases not reachable (404 or network error)"}

    tag, tarball_url, _html_url, _notes = _github_latest_release()
    if not tag or not tarball_url:
        _log("apply: no latest release or tarball_url")
        return {"ok": False, "error": "No latest GitHub release (or missing tarball URL)"}

    _log(f"apply: staging release tag={tag} tarball={tarball_url}")

    # Acquire an exclusive non-blocking lock for the staging + scheduling window.
    # The installer is launched wrapped in `flock --exclusive` so it inherits the
    # same lock for its complete lifetime, preventing any concurrent apply() from
    # deleting or overwriting the staging directory while the installer runs.
    try:
        lock_fd = os.open(str(UPDATE_LOCK_FILE), os.O_CREAT | os.O_RDWR, 0o600)
    except OSError as e:
        _log(f"apply: failed to open update lock file: {e}")
        return {"ok": False, "error": "Failed to open update lock."}
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as e:
        os.close(lock_fd)
        if e.errno in (errno.EWOULDBLOCK, errno.EACCES):
            _log("apply: refused — update lock already held by a running installer")
            return {"ok": False, "error": "An update is already in progress. Please wait for it to complete."}
        _log(f"apply: failed to acquire update lock: {e}")
        return {"ok": False, "error": "Failed to acquire update lock."}

    try:
        # Recheck after acquiring the lock: a concurrent apply() may have passed the
        # initial unit check and then scheduled a timer during the window between that
        # check and our lock acquisition.  The timer is now active, so this catches it.
        try:
            if _update_unit_active():
                _log("apply: refused after lock — unit became active during staging window")
                return {"ok": False, "error": "An update is already in progress. Please wait for it to complete."}
        except Exception as e:
            _log(f"apply: refused — unable to recheck update unit status after lock: {e}")
            return {"ok": False, "error": "Unable to verify update status. Please try again shortly."}

        # Clean up any previous staging directory so stale extracts do not accumulate.
        if STAGING_DIR.exists():
            try:
                shutil.rmtree(str(STAGING_DIR))
                _log(f"apply: removed previous staging dir {STAGING_DIR}")
            except Exception as e:
                _log(f"apply: warning — could not remove previous staging dir: {e}")

        try:
            STAGING_DIR.mkdir(parents=True, exist_ok=True)
            os.chmod(str(STAGING_DIR), 0o700)

            tar_path = STAGING_DIR / "release.tgz"
            _log("apply: downloading release tarball")
            _download_file(tarball_url, tar_path, timeout=120)

            extract_dir = STAGING_DIR / "src"
            extract_dir.mkdir(parents=True, exist_ok=True)

            _log("apply: extracting tarball")
            with tarfile.open(tar_path, "r:gz") as tf:
                # filter='data' (Python 3.12+) strips absolute paths, '../' traversal
                # sequences, and unsafe member types (devices, setuid bits) before
                # extraction.  Without a filter, a crafted tarball could write to
                # arbitrary filesystem paths because this runs as root.
                tf.extractall(extract_dir, filter="data")

            # GitHub tarballs have a single top-level directory.
            top_dirs = [p for p in extract_dir.iterdir() if p.is_dir()]
            if len(top_dirs) == 1:
                repo_root = top_dirs[0]
            else:
                repo_root = extract_dir

            installer = repo_root / "autostream_install.sh"
            if not installer.exists():
                raise FileNotFoundError(f"autostream_install.sh not found in extracted tree at {repo_root}")

            # Ensure the installer is executable.
            os.chmod(str(installer), 0o755)

            # Validate the staging directory contains the expected structure.
            if not (repo_root / "system").is_dir():
                raise FileNotFoundError(f"Expected 'system/' directory not found in extracted tree at {repo_root}")

            _log(f"apply: staged release at {repo_root}")

            # Write the release tag to the staging dir so the boot-time retry
            # service can recover AUTOSTREAM_RELEASE_TAG after a watchdog reset.
            tag_file = STAGING_DIR / "release_tag"
            tag_file.write_text(tag + "\n", encoding="utf-8")
            os.chmod(str(tag_file), 0o600)
            _log(f"apply: wrote release_tag to {tag_file}")

        except Exception as e:
            _log(f"apply: staging failed: {e}")
            return {"ok": False, "error": "Release staging failed", "details": str(e)}

        # Schedule the installer as a transient systemd unit so it runs outside
        # the autostream.service cgroup (same pattern as factory-reset).
        # flock --exclusive wraps the installer so UPDATE_LOCK_FILE is held for
        # the installer's complete lifetime; our lock is released in the finally
        # below, at which point the flock wrapper immediately re-acquires it.
        unit_suffix = f"{int(time.time())}-{os.getpid()}"
        unit_name = f"autostream-update-{unit_suffix}"

        cmd = [
            str(systemd_run),
            "--quiet",
            "--collect",
            f"--unit={unit_name}",
            "--on-active=1",           # fire 1 second after scheduling
            "--property=Type=oneshot",
            f"--setenv=AUTOSTREAM_RELEASE_TAG={tag}",
            "--",
            FLOCK_BIN, "--exclusive", str(UPDATE_LOCK_FILE),
            str(installer),
            "--update",
        ]

        rc, out, err = _run(cmd, timeout=15)
        if rc != 0:
            _log(f"apply: systemd-run scheduling failed rc={rc} stderr='{err}'")
            return {"ok": False, "error": "Failed to schedule installer", "details": err or out}

        # Clear any stale update-result.env from the previous run so the status
        # page does not immediately show the old "success / 100%" result before
        # the new installer has written its first progress entry.
        try:
            UPDATE_RESULT_FILE.unlink(missing_ok=True)
            _log("apply: cleared stale update-result.env")
        except Exception as e:
            _log(f"apply: warning — could not clear update-result.env: {e}")

        _log(f"apply: installer scheduled as transient unit {unit_name} tag={tag}")
        return {"ok": True, "staged_tag": tag.lstrip("v")}

    finally:
        # Release our staging/scheduling lock.  The installer's flock wrapper
        # blocks on the same file and acquires it as soon as we release here.
        fcntl.flock(lock_fd, fcntl.LOCK_UN)
        os.close(lock_fd)


# ---- Entrypoint ----

def main() -> int:
    if os.geteuid() != 0:
        print(json.dumps({"ok": False, "error": "Must be run as root"}))
        return 2

    if len(sys.argv) < 2:
        print(json.dumps({"ok": False, "error": "Usage: autostream-updater [check|apply]"}))
        return 1

    cmd = sys.argv[1].strip().lower()
    if cmd == "check":
        result = cmd_check()
        print(json.dumps(result))
        return 0 if result.get("ok") else 1

    if cmd in ("apply", "install", "update"):
        auto = "--auto" in sys.argv[2:]
        result = cmd_apply(auto=auto)
        print(json.dumps(result))
        return 0 if result.get("ok") else 1

    print(json.dumps({"ok": False, "error": f"Unknown command: {cmd}"}))
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
