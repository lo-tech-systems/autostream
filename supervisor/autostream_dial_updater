HD_MARKER_NAME = "hd-kiosk"          # in the state directory
HD_STATE_URL = "http://127.0.0.1:7843/api/v1/state"
# A kiosk browser that was restarted while the board was still booting (its
# start-up wait for the page server can outlast the unit's start timeout, and
# the unit restarts itself) is accepted once it has stayed active, with no
# further restart, for this long.
KIOSK_SETTLE_S = 10
