#!/usr/bin/python3
"""autostream-admin (privileged actions)

Copyright (c) 2025-2026 Lo-tech Systems Limited. All rights reserved.

INSTALLATION LOCATION (IMPORTANT)
--------------------------------
This script must be installed OUTSIDE /opt/autostream so it cannot be replaced by the webapp
self-update process.

Recommended path:
  /usr/local/libexec/autostream/autostream-admin

Ownership/permissions (example):
  chown root:root /usr/local/libexec/autostream/autostream-admin
  chmod 0755 /usr/local/libexec/autostream/autostream-admin

LOGGING
-------
This script logs ONLY to journald via stdout/stderr (systemd captures it).
Do NOT read /opt/autostream/autostream.ini from here; treat /opt/autostream as
untrusted because it is writable by the web server and update mechanism.

COMMANDS
--------
Exactly one of:
  reboot [--delay SECONDS] [reason]
  restart-owntone
  sethostname HOSTNAME
  factory-reset

Notes:
  - [reason] is optional for reboot.
  - With --delay, the reboot is scheduled using a transient systemd timer
    (systemd-run) and this command returns immediately.
  - factory-reset schedules the full reset sequence as a transient systemd unit
    (to escape the autostream.service cgroup) and returns immediately.
    The reset sequence stops services, rotates logs, deletes runtime state,
    removes Wi-Fi connections, and reboots.

REBOOT REASONS
--------------
Valid reasons:
  AutostreamUpdate
  UserRequestNormal
  UserRequestSystemError
  NetworkDown

Rate limiting:
  NetworkDown reboots are limited to once per hour using a persistent stamp file:
    /var/lib/autostream/reboot_networkdown.stamp

FACTORY RESET
-------------
Preserved on reset:
  /boot/firmware/pin.txt (or /boot/pin.txt)
  /opt/autostream/cpuinfo

Deleted on reset (fixed allowlist — no wildcards):
  /opt/autostream/autostream.ini
  /opt/autostream/ssid
  /opt/autostream/playback_stats.json
  /opt/autostream/nowplaying_hints.json
  /opt/autostream/sdcardhealth.json
  /var/cache/owntone/songs3.db
  /etc/owntone-settings.json

Best-effort sync before deletion:
  /etc/owntone.conf -> /opt/autostream/owntone/owntone.conf (if both exist)

HOSTNAME
--------
Valid hostnames:
  - Must be 1..63 characters
  - Must be a valid hostname label (letters/digits/hyphen; not start/end hyphen; 1..63 chars)
  - Must not contain leading/trailing whitespace

NOTES
-----
- Must run as root.
- Hostname changes update /etc/hostname and /etc/hosts and attempt an mDNS
  re-announce by restarting avahi-daemon.
"""

from __future__ import annotations

import argparse
import fcntl
import shutil
import datetime as dt
import os
import re
import subprocess
import sys
import time
from pathlib import Path
from typing import Optional, Tuple

# Throw if not root
if os.geteuid() != 0:
    print("This program must be run as root", file=sys.stderr)
    sys.exit(1)


# Persistent stamp file for rate limiting NetworkDown reboots
STAMP_DIR = Path("/var/lib/autostream")
NETWORKDOWN_STAMP = STAMP_DIR / "reboot_networkdown.stamp"
NETWORKDOWN_MIN_INTERVAL_SECONDS = 3600  # 1 hour

VALID_REBOOT_REASONS = {
    "AutostreamUpdate",
    "UserRequestNormal",
    "UserRequestSystemError",
    "NetworkDown",
}

# RFC-ish hostname label validation: letters/digits/hyphen; not start/end hyphen; 1..63 chars
HOSTNAME_LABEL_RE = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$", re.IGNORECASE)

# Factory reset: volatile lock location (disappears on reboot/power loss)
FACTORY_RESET_LOCK_DIR = Path("/run/autostream")
FACTORY_RESET_LOCK_FILE = FACTORY_RESET_LOCK_DIR / "factory-reset.lock"

# Factory reset: fixed allowlist of files to delete — no wildcards, no /opt path construction
FACTORY_RESET_DELETE_FILES = (
    Path("/opt/autostream/autostream.ini"),
    Path("/opt/autostream/ssid"),
    Path("/opt/autostream/playback_stats.json"),
    Path("/opt/autostream/nowplaying_hints.json"),
    Path("/opt/autostream/sdcardhealth.json"),
    Path("/var/cache/owntone/songs3.db"),
    Path("/etc/owntone-settings.json"),
)

# Systemctl candidates
SYSTEMCTL_CANDIDATES = (
    "/bin/systemctl",
    "/usr/bin/systemctl",
)

# logrotate candidates
LOGROTATE_CANDIDATES = (
    "/usr/sbin/logrotate",
    "/usr/bin/logrotate",
    "/sbin/logrotate",
)

# nmcli candidates
NMCLI_CANDIDATES = (
    "/usr/bin/nmcli",
    "/bin/nmcli",
    "/usr/local/bin/nmcli",
)

# systemd-run candidates (for transient timers)
SYSTEMDRUN_CANDIDATES = (
    "/bin/systemd-run",
    "/usr/bin/systemd-run",
)

def find_systemctl():
    for path in SYSTEMCTL_CANDIDATES:
        if os.path.exists(path) and os.access(path, os.X_OK):
            return path
    return None

def find_systemd_run():
    """Return an absolute path to systemd-run if available, else None."""
    for path in SYSTEMDRUN_CANDIDATES:
        if os.path.exists(path) and os.access(path, os.X_OK):
            return path
    # As a last resort, try PATH lookup, but only accept an absolute result.
    p = shutil.which("systemd-run")
    if p and os.path.isabs(p) and os.access(p, os.X_OK):
        return p
    return None

def find_logrotate() -> Optional[str]:
    for path in LOGROTATE_CANDIDATES:
        if os.path.exists(path) and os.access(path, os.X_OK):
            return path
    p = shutil.which("logrotate")
    if p and os.path.isabs(p) and os.access(p, os.X_OK):
        return p
    return None


def find_nmcli() -> Optional[str]:
    for path in NMCLI_CANDIDATES:
        if os.path.exists(path) and os.access(path, os.X_OK):
            return path
    p = shutil.which("nmcli")
    if p and os.path.isabs(p) and os.access(p, os.X_OK):
        return p
    return None


def log(level: str, msg: str) -> None:
    """Log to stdout/stderr for journald capture."""
    ts = dt.datetime.now(dt.timezone.utc).astimezone().isoformat(timespec="seconds")
    line = f"{ts} {level} {msg}"
    if level in ("ERROR", "WARN"):
        print(line, file=sys.stderr, flush=True)
    else:
        print(line, file=sys.stdout, flush=True)


def run_cmd(cmd: list[str]) -> Tuple[int, str, str]:
    """Run a command returning (rc, stdout, stderr) with text decoding."""
    p = subprocess.run(cmd, capture_output=True, text=True)
    return p.returncode, (p.stdout or "").strip(), (p.stderr or "").strip()


HOSTNAMECTL_CANDIDATES = (
    "/usr/bin/hostnamectl",
    "/bin/hostnamectl",
    "/usr/local/bin/hostnamectl",
    "/usr/sbin/hostnamectl",
    "/sbin/hostnamectl",
)

def find_hostnamectl():
    """Return an absolute path to hostnamectl if available, else None."""
    for path in HOSTNAMECTL_CANDIDATES:
        if os.path.exists(path) and os.access(path, os.X_OK):
            return path
    # As a last resort, try PATH lookup, but only accept an absolute result.
    p = shutil.which("hostnamectl")
    if p and os.path.isabs(p) and os.access(p, os.X_OK):
        return p
    return None


def validate_hostname(hostname: str) -> Tuple[bool, str]:
    """Validate hostname for Linux/DNS expectations."""
    h = hostname.strip()
    if not h:
        return False, "hostname is empty"
    if len(h) > 253:
        return False, "hostname is too long (>253 chars)"

    labels = h.split(".")
    for label in labels:
        if not (1 <= len(label) <= 63):
            return False, f"label '{label}' length must be 1..63"
        if not HOSTNAME_LABEL_RE.match(label):
            return False, f"label '{label}' has invalid characters/format"
    return True, ""


def atomic_write_text(path: Path, text: str, mode: int = 0o644) -> None:
    """Atomically write a file (write temp then replace)."""
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    os.chmod(tmp, mode)
    tmp.replace(path)


def update_etc_hostname(hostname: str) -> None:
    atomic_write_text(Path("/etc/hostname"), hostname.strip() + "\n", mode=0o644)


def update_etc_hosts(hostname: str) -> None:
    """Ensure /etc/hosts has a 127.0.1.1 mapping for the hostname (Debian/Pi OS style)."""
    hosts_path = Path("/etc/hosts")
    original = hosts_path.read_text(encoding="utf-8").splitlines()

    new_lines: list[str] = []
    replaced = False

    for line in original:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            new_lines.append(line)
            continue

        m = re.match(r"^(\S+)(\s+)(.*)$", line)
        if not m:
            new_lines.append(line)
            continue

        ip = m.group(1)
        if ip == "127.0.1.1":
            remainder = m.group(3)
            comment = ""
            if "#" in remainder:
                _, after = remainder.split("#", 1)
                comment = " #" + after.strip()
            new_lines.append(f"127.0.1.1\t{hostname}{comment}".rstrip())
            replaced = True
        else:
            new_lines.append(line)

    if not replaced:
        if new_lines and new_lines[-1].strip():
            new_lines.append("")
        new_lines.append(f"127.0.1.1\t{hostname}")

    atomic_write_text(hosts_path, "\n".join(new_lines) + "\n", mode=0o644)


def rebroadcast_mdns() -> bool:
    """Restart avahi-daemon to trigger an mDNS re-announce (best effort)."""
    systemctl = find_systemctl()
    if not systemctl:
        log("WARN", "mdns: systemctl not found; cannot restart avahi-daemon")
        return False

    for unit in ("avahi-daemon.service", "avahi-daemon"):
        rc, out, err = run_cmd([str(systemctl), "restart", unit])
        if rc == 0:
            log("INFO", f"mdns: restarted {unit} successfully")
            return True
        log("WARN", f"mdns: failed restarting {unit} rc={rc} stderr='{err}' stdout='{out}'")

    return False


def set_hostname(hostname: str) -> bool:
    ok, why = validate_hostname(hostname)
    if not ok:
        log("ERROR", f"set-hostname: validation failed: {why}")
        return False

    log("INFO", f"set-hostname: received request hostname='{hostname}'")

    try:
        update_etc_hostname(hostname)
        update_etc_hosts(hostname)
        log("INFO", "set-hostname: updated /etc/hostname and /etc/hosts")
    except Exception as e:
        log("ERROR", f"set-hostname: failed updating /etc/hostname or /etc/hosts: {e!r}")
        return False

    # Keep systemd static hostname consistent (best effort).
    # We do NOT import any /opt/autostream modules.
    hostnamectl = find_hostnamectl()
    if hostnamectl is not None:
        rc, out, err = run_cmd([str(hostnamectl), "set-hostname", hostname])
        if rc == 0:
            log("INFO", "set-hostname: hostnamectl succeeded")
        else:
            log("WARN", f"set-hostname: hostnamectl failed rc={rc} stderr='{err}' stdout='{out}'")
    else:
        # Fallback runtime hostname
        rc, out, err = run_cmd(["/bin/hostname", hostname])
        if rc == 0:
            log("INFO", "set-hostname: /bin/hostname succeeded")
        else:
            log("WARN", f"set-hostname: /bin/hostname failed rc={rc} stderr='{err}' stdout='{out}'")

    mdns_ok = rebroadcast_mdns()
    log("INFO", f"set-hostname: completed (mdns_rebroadcast={'ok' if mdns_ok else 'failed'})")
    return True


def restart_owntone() -> bool:
    log("INFO", "restart-owntone: received request")
    systemctl = find_systemctl()
    if not systemctl:
        log("ERROR", "restart-owntone: systemctl not found")
        return False

    rc, out, err = run_cmd([str(systemctl), "restart", "owntone"])
    if rc == 0:
        log("INFO", "restart-owntone: success")
        return True

    log("ERROR", f"restart-owntone: failed rc={rc} stderr='{err}' stdout='{out}'")
    return False


def should_rate_limit_networkdown() -> Tuple[bool, Optional[int]]:
    """Return (rate_limited, seconds_remaining)."""
    try:
        STAMP_DIR.mkdir(parents=True, exist_ok=True)
    except Exception as e:
        log("WARN", f"reboot: cannot ensure stamp dir {STAMP_DIR} exists ({e!r}); skipping rate-limit")
        return False, None

    if not NETWORKDOWN_STAMP.exists():
        return False, None

    try:
        last = dt.datetime.fromtimestamp(NETWORKDOWN_STAMP.stat().st_mtime, tz=dt.timezone.utc)
        now = dt.datetime.now(dt.timezone.utc)
        delta = (now - last).total_seconds()
        if delta < NETWORKDOWN_MIN_INTERVAL_SECONDS:
            return True, int(NETWORKDOWN_MIN_INTERVAL_SECONDS - delta)
        return False, None
    except Exception:
        return False, None


def touch_networkdown_stamp() -> None:
    STAMP_DIR.mkdir(parents=True, exist_ok=True)
    NETWORKDOWN_STAMP.touch()


def reboot_host(reason: Optional[str]) -> bool:
    r = (reason or "").strip()
    if not r:
        r = "(no reason provided)"

    if r != "(no reason provided)" and r not in VALID_REBOOT_REASONS:
        log("ERROR", f"reboot: invalid reason '{r}' (valid: {', '.join(sorted(VALID_REBOOT_REASONS))})")
        return False

    log("INFO", f"reboot: received request reason={r}")

    if r == "NetworkDown":
        limited, remaining = should_rate_limit_networkdown()
        if limited:
            log("WARN", f"reboot: rate-limited NetworkDown (try again in ~{remaining}s)")
            return True  # handled without reboot
        try:
            touch_networkdown_stamp()
        except Exception as e:
            log("WARN", f"reboot: failed to write stamp file (continuing): {e!r}")

    reboot_bin = Path("/sbin/reboot")
    if not reboot_bin.exists():
        log("ERROR", "reboot: /sbin/reboot not found")
        return False

    rc, out, err = run_cmd([str(reboot_bin)])
    if rc == 0:
        log("INFO", "reboot: /sbin/reboot executed successfully")
        return True

    log("ERROR", f"reboot: /sbin/reboot failed rc={rc} stderr='{err}' stdout='{out}'")
    return False


def schedule_delayed_reboot(delay_s: int, reason: Optional[str]) -> bool:
    """Schedule a reboot after delay_s seconds and return immediately.

    Uses a transient systemd timer via systemd-run. This avoids keeping a sleeping
    child process around and integrates cleanly with journald.
    """
    if delay_s <= 0:
        return reboot_host(reason)

    if delay_s > 24 * 60 * 60:
        log("ERROR", f"reboot: delay too large: {delay_s}s")
        return False

    # Schedule using a transient systemd timer.
    systemd_run = find_systemd_run()
    if systemd_run is not None:
        # Use an instance-unique unit name so repeated requests don't collide.
        # Unit names must be valid systemd identifiers; keep to [a-zA-Z0-9:-_.@].
        unit_suffix = f"{int(time.time())}-{os.getpid()}"
        unit_name = f"autostream-delayed-reboot-{unit_suffix}"

        # Re-run this script without --delay so all validation/rate-limiting is
        # performed at execution time (same behaviour as the previous fork/sleep).
        script_path = os.path.realpath(sys.argv[0])
        cmd = [
            str(systemd_run),
            "--quiet",
            "--collect",
            f"--unit={unit_name}",
            f"--on-active={delay_s}",
            "--property=Type=oneshot",
            "--property=After=network-online.target",
            "--property=Wants=network-online.target",
            "--",
            script_path,
            "reboot",
        ]
        if (reason or "").strip():
            cmd.append((reason or "").strip())

        rc, out, err = run_cmd(cmd)
        if rc == 0:
            log("INFO", f"reboot: scheduled via systemd-run in ~{delay_s}s unit={unit_name} reason={reason or ''}")
            return True

        log("ERROR", f"reboot: systemd-run scheduling failed rc={rc} stderr='{err}' stdout='{out}'")
        return False

    return False

# ---------------------------------------------------------------------------
# Factory reset helpers
# ---------------------------------------------------------------------------

def _rotate_logs() -> None:
    """Force log rotation for autostream and owntone log policies (best-effort)."""
    logrotate = find_logrotate()
    if not logrotate:
        log("WARN", "factory-reset: logrotate not found; skipping log rotation")
        return
    for policy in ("/etc/logrotate.d/autostream", "/etc/logrotate.d/owntone"):
        if not os.path.exists(policy):
            log("WARN", f"factory-reset: logrotate policy not found: {policy}; skipping")
            continue
        rc, out, err = run_cmd([logrotate, "--force", policy])
        if rc == 0:
            log("INFO", f"factory-reset: log rotation succeeded for {policy}")
        else:
            log("WARN", f"factory-reset: log rotation failed for {policy} rc={rc} stderr='{err}'")


def _stop_service(name: str) -> bool:
    """Stop a systemd service (best-effort). Returns True on success."""
    systemctl = find_systemctl()
    if not systemctl:
        log("WARN", f"factory-reset: systemctl not found; cannot stop {name}")
        return False
    rc, out, err = run_cmd([systemctl, "stop", name])
    if rc == 0:
        log("INFO", f"factory-reset: stopped {name}")
        return True
    log("WARN", f"factory-reset: could not stop {name} rc={rc} stderr='{err}'")
    return False


def _stop_owntone() -> None:
    """Stop OwnTone, trying both common unit name variants."""
    for unit in ("owntone.service", "owntone"):
        if _stop_service(unit):
            return
    log("WARN", "factory-reset: owntone could not be stopped (continuing)")


def _sync_owntone_conf() -> None:
    """Copy /etc/owntone.conf -> /opt/autostream/owntone/owntone.conf if both paths exist."""
    src = Path("/etc/owntone.conf")
    dst = Path("/opt/autostream/owntone/owntone.conf")
    if src.exists() and dst.exists():
        try:
            shutil.copy2(str(src), str(dst))
            log("INFO", f"factory-reset: synced {src} -> {dst}")
        except Exception as e:
            log("WARN", f"factory-reset: could not sync owntone.conf: {e!r}")
    else:
        log("INFO", "factory-reset: owntone.conf sync skipped (source or dest file missing)")


def _delete_reset_files() -> None:
    """Delete the fixed allowlist of runtime/config files."""
    for path in FACTORY_RESET_DELETE_FILES:
        try:
            path.unlink()
            log("INFO", f"factory-reset: deleted {path}")
        except FileNotFoundError:
            log("INFO", f"factory-reset: {path} not present, skipping")
        except Exception as e:
            log("WARN", f"factory-reset: could not delete {path}: {e!r}")


def _delete_wifi_connections() -> None:
    """Enumerate and delete all saved Wi-Fi (802-11-wireless) NetworkManager connections."""
    nmcli = find_nmcli()
    if not nmcli:
        log("WARN", "factory-reset: nmcli not found; cannot delete Wi-Fi connections")
        return

    # Use multiline terse output to avoid colon-in-name ambiguity
    rc, out, err = run_cmd([nmcli, "-t", "--mode", "multiline", "-f", "NAME,TYPE", "connection", "show"])
    if rc != 0:
        log("WARN", f"factory-reset: nmcli list failed rc={rc} stderr='{err}'")
        return

    # Multiline terse format: NAME:value / TYPE:value pairs, one per line
    wifi_connections: list[str] = []
    current_name: Optional[str] = None
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("NAME:"):
            current_name = line[5:]
        elif line.startswith("TYPE:") and current_name is not None:
            conn_type = line[5:].lower()
            if "wifi" in conn_type or "wireless" in conn_type:
                wifi_connections.append(current_name)
            current_name = None

    if not wifi_connections:
        log("INFO", "factory-reset: no saved Wi-Fi connections found")
        return

    for name in wifi_connections:
        rc, out, err = run_cmd([nmcli, "connection", "delete", name])
        if rc == 0:
            log("INFO", f"factory-reset: deleted Wi-Fi connection '{name}'")
        else:
            log("WARN", f"factory-reset: failed to delete Wi-Fi connection '{name}' rc={rc} stderr='{err}'")


def _acquire_reset_lock() -> Optional[object]:
    """Create /run/autostream and acquire an exclusive non-blocking lock file.

    Returns the open file object (lock held) or None if already locked.
    The lock is released when the returned object is closed or the process exits.
    """
    try:
        FACTORY_RESET_LOCK_DIR.mkdir(parents=True, exist_ok=True)
        os.chmod(str(FACTORY_RESET_LOCK_DIR), 0o755)
    except Exception as e:
        log("WARN", f"factory-reset: could not create lock dir: {e!r}")

    try:
        lock_fd = open(str(FACTORY_RESET_LOCK_FILE), "w")
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return lock_fd
    except BlockingIOError:
        return None
    except Exception as e:
        log("WARN", f"factory-reset: lock acquisition failed: {e!r}")
        return None


def _schedule_factory_reset() -> bool:
    """Schedule factory-reset as a transient systemd unit to escape the service cgroup.

    The autostream web UI runs inside autostream.service. Stopping that service
    while still inside its cgroup would cause a deadlock. This function uses
    systemd-run to schedule the actual reset execution as a separate transient
    unit (with its own cgroup), then returns immediately so the caller can
    respond to the HTTP request before the reset begins.
    """
    systemd_run = find_systemd_run()
    if systemd_run is None:
        log("ERROR", "factory-reset: systemd-run not found; cannot schedule reset")
        return False

    script_path = os.path.realpath(sys.argv[0])
    unit_suffix = f"{int(time.time())}-{os.getpid()}"
    unit_name = f"autostream-factory-reset-{unit_suffix}"

    cmd = [
        str(systemd_run),
        "--quiet",
        "--collect",
        f"--unit={unit_name}",
        "--on-active=1",          # fire 1s after scheduling; gives caller time to respond
        "--property=Type=oneshot",
        "--",
        script_path,
        "factory-reset",
        "--execute",              # internal flag: run the actual reset sequence
    ]
    rc, out, err = run_cmd(cmd)
    if rc == 0:
        log("INFO", f"factory-reset: scheduled as transient unit {unit_name}")
        return True
    log("ERROR", f"factory-reset: systemd-run scheduling failed rc={rc} stderr='{err}'")
    return False


def _execute_factory_reset() -> bool:
    """Execute the factory reset sequence.

    Called by the transient systemd unit (--execute flag). Runs outside the
    autostream.service cgroup so it survives stopping that service.

    Sequence:
      1. Acquire reset lock (serialises concurrent attempts)
      2. Log reset request
      3. Rotate logs
      4. Stop autostream.service
         NOTE: this kills the web UI, but we are in a separate cgroup at this point.
      5. Stop autostream_wifi_watcher.service
         NOTE: if in AP mode this drops the hotspot — expected behavior.
      6. Stop owntone
      7. Sync owntone.conf (best-effort)
      8. Delete allowlisted runtime/config files
      9. Delete Wi-Fi connections
     10. Reboot
    """
    lock_fd = _acquire_reset_lock()
    if lock_fd is None:
        log("WARN", "factory-reset: already in progress (lock held); aborting")
        return False

    # Lock is held for the lifetime of this process. It is released on process
    # exit (after reboot is issued, or on failure). The /run location means it
    # disappears automatically on the subsequent reboot.

    log("INFO", "factory-reset: executing reset sequence")

    _rotate_logs()

    _stop_service("autostream.service")
    _stop_service("autostream_wifi_watcher.service")
    _stop_owntone()

    _sync_owntone_conf()
    _delete_reset_files()
    _delete_wifi_connections()

    log("INFO", "factory-reset: sequence complete; rebooting")
    reboot_bin = Path("/sbin/reboot")
    if not reboot_bin.exists():
        log("ERROR", "factory-reset: /sbin/reboot not found")
        return False

    rc, out, err = run_cmd([str(reboot_bin)])
    if rc == 0:
        log("INFO", "factory-reset: reboot initiated")
        return True

    log("ERROR", f"factory-reset: reboot failed rc={rc} stderr='{err}'")
    return False


def factory_reset(execute: bool = False) -> bool:
    """Factory reset entry point.

    When execute=False (default, called via sudo from the web UI or CGI):
      Schedules the reset as a transient systemd unit and returns immediately.

    When execute=True (called by the transient unit itself):
      Runs the full reset sequence.
    """
    if execute:
        return _execute_factory_reset()
    return _schedule_factory_reset()


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="AutoStream admin helper (run via sudo)."
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    p_reboot = subparsers.add_parser(
        "reboot",
        help="Reboot the system. Optionally provide a reason (e.g., NetworkDown).",
        description=(
            "Request a system reboot.\n\n"
            "Syntax: reboot [--delay SECONDS] [REASON]\n"
            "If --delay is provided, the reboot is scheduled in the background using a\n"
            "systemd timer (systemd-run) and this command returns immediately."
        ),
    )
    p_reboot.add_argument(
        "--delay",
        type=int,
        default=0,
        metavar="SECONDS",
        help="Delay reboot by SECONDS; returns immediately after scheduling.",
    )
    p_reboot.add_argument(
        "reason",
        nargs="?",
        default="",
        help="Optional reboot reason (e.g., NetworkDown).",
    )

    subparsers.add_parser(
        "restart-owntone",
        help="Restart the owntone service.",
    )

    p_sethostname = subparsers.add_parser(
        "sethostname",
        help="Set system hostname.",
    )
    p_sethostname.add_argument(
        "hostname",
        help="Hostname to set.",
    )

    p_factory_reset = subparsers.add_parser(
        "factory-reset",
        help="Factory reset: erase runtime state, remove Wi-Fi connections, reboot.",
        description=(
            "Schedules a factory reset as a transient systemd unit and returns immediately.\n\n"
            "The reset sequence stops services, rotates logs, deletes runtime configuration,\n"
            "removes all saved Wi-Fi connections, and reboots into AP-based setup mode.\n\n"
            "Preserved: /boot/firmware/pin.txt (or /boot/pin.txt), /opt/autostream/cpuinfo."
        ),
    )
    # --execute is used internally by the transient systemd unit. It is not
    # intended for direct use and is intentionally hidden from the help output.
    p_factory_reset.add_argument(
        "--execute",
        action="store_true",
        default=False,
        help=argparse.SUPPRESS,
    )

    args = parser.parse_args(argv)
    return args


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        log("ERROR", "must run as root")
        return 2

    args = parse_args(argv)

    try:
        if args.command == "reboot":
            ok = schedule_delayed_reboot(args.delay, args.reason)
            return 0 if ok else 1

        if args.command == "restart-owntone":
            ok = restart_owntone()
            return 0 if ok else 1

        if args.command == "sethostname":
            ok = set_hostname(args.hostname)
            return 0 if ok else 1

        if args.command == "factory-reset":
            ok = factory_reset(execute=args.execute)
            return 0 if ok else 1

        log("ERROR", "no action specified")
        return 2
    except Exception as e:
        log("ERROR", f"fatal error: {e!r}")
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
