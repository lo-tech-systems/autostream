def action_start_logrotate(actions: list) -> dict:
    sc = _find_cmd(_SYSTEMCTL_CANDIDATES)
    if not sc:
        r = {"name": "logrotate_start", "ok": False, "reason": "systemctl not found"}
        actions.append(r)
        return r
    result = _run([sc, "start", "--no-ask-password", "logrotate.service"], timeout=60)
    r = {"name": "logrotate_start", "ok": result["ok"]}
    actions.append(r)
    return r


