    pkg_count = None
    if result["ok"]:
        # Count "Remv " lines in output
        pkg_count = result["stdout_head"].count("Remv ")
    r = {"name": "apt_autoremove_simulate", "ok": result["ok"], "packages_proposed": pkg_count}
    actions.append(r)
    return r


def action_enable_logrotate_timer(actions: list) -> dict:
    sc = _find_cmd(_SYSTEMCTL_CANDIDATES)
    if not sc:
        r = {"name": "enable_logrotate_timer", "ok": False, "reason": "systemctl not found"}
        actions.append(r)
        return r
    result = _run([sc, "enable", "--now", "logrotate.timer"], timeout=30)
    r = {"name": "enable_logrotate_timer", "ok": result["ok"]}
    actions.append(r)
    return r


def _logrotate_timer_status() -> dict:
    """Return {exists, enabled, active}."""
    sc = _find_cmd(_SYSTEMCTL_CANDIDATES)
    if not sc:
        return {"exists": False, "enabled": False, "active": False}
    # Check exists
    r = _run([sc, "status", "logrotate.timer"], timeout=10)
    if r["rc"] == 4:  # unit not found
        return {"exists": False, "enabled": False, "active": False}
    exists = True
    is_r = _run([sc, "is-enabled", "logrotate.timer"], timeout=10)
    enabled = is_r["ok"]
    ia_r = _run([sc, "is-active", "logrotate.timer"], timeout=10)
    active = ia_r["ok"]
    return {"exists": exists, "enabled": enabled, "active": active}


def delete_archive_files(
    directory: str,
    *,
    min_age_days: Optional[int],
    delete_cap_bytes: int,
    bytes_deleted: list,  # single-element list used as accumulator
    actions: list,
    preserve_newest: bool = True,
    emergency: bool = False,
) -> None:
    """Delete eligible rotated archives from `directory`.

    Only deletes files that pass _is_eligible_archive.
    In emergency mode, `min_age_days` is ignored and newest is not preserved.
    """
    dir_path = Path(directory)
    if not dir_path.is_dir():
        return

    try:
        sv = os.stat(str(dir_path))
        dir_dev = sv.st_dev
    except OSError:
        return

    # Group eligible files by base name so we can preserve the newest.
    from collections import defaultdict
    by_base: dict[str, list[tuple[float, int, Path]]] = defaultdict(list)

    try:
        entries = list(dir_path.iterdir())
    except OSError:
        return

    for entry in entries:
        if entry.is_symlink():
            continue
        if not entry.is_file(follow_symlinks=False):
            continue
        try:
            st = entry.stat(follow_symlinks=False)
            if st.st_dev != dir_dev:
                continue
        except OSError:
            continue
        if not _is_eligible_archive(directory, entry.name):
            continue
        # Use the regex base (e.g. "mail.log", "mail.warn") as the group key,
        # not split(".")[0] which incorrectly merges e.g. "mail.log" and "mail.warn".
        _m = _ARCHIVE_NUMBERED_RE.match(entry.name) or _ARCHIVE_DATED_RE.match(entry.name)
        base_key = _m.group(1) if _m else entry.name
        by_base[base_key].append((st.st_mtime, st.st_size, entry))

    # Flatten and sort oldest first.
    candidates: list[tuple[float, int, Path, str]] = []
    for base, files in by_base.items():
        files_sorted = sorted(files)  # oldest first
        if preserve_newest and not emergency and len(files_sorted) > 1:
            # Exclude the newest (last in sorted list)
            files_sorted = files_sorted[:-1]
        for mtime, size, path in files_sorted:
            if min_age_days is not None and not emergency:
                age_days = (time.time() - mtime) / 86400.0
                if age_days < min_age_days:
                    continue
            candidates.append((mtime, size, path, base))

    candidates.sort()  # oldest first

    for mtime, size, path, base in candidates:
        if bytes_deleted[0] + size > delete_cap_bytes:
            break
        try:
            os.unlink(str(path))
            bytes_deleted[0] += size
            actions.append({"name": "delete_archive", "ok": True,
                            "path": str(path), "size_bytes": size})
        except OSError as e:
            actions.append({"name": "delete_archive", "ok": False,
                            "path": str(path), "error": str(e)[:200]})


