# ---------------------------------------------------------------------------
# State file
# ---------------------------------------------------------------------------

def load_state() -> dict:
    try:
        if not STATE_PATH.is_file():
            return {}
        raw = STATE_PATH.read_text(encoding="utf-8", errors="replace")
        data = json.loads(raw)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def save_state(data: dict) -> bool:
    try:
        STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp_name = tempfile.mkstemp(
            prefix=".storage-guard.", suffix=".tmp.json",
            dir=str(STATE_PATH.parent),
        )
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                json.dump(data, fh, indent=2)
                fh.flush()
                os.fsync(fh.fileno())
            os.chmod(tmp_name, 0o644)
            os.replace(tmp_name, str(STATE_PATH))
            return True
        except Exception:
            try:
                os.unlink(tmp_name)
            except OSError:
                pass
            raise
    except Exception as e:
        logging.warning("storage guard: could not save state: %s", e)
        return False


# ---------------------------------------------------------------------------
# Lock helpers
# ---------------------------------------------------------------------------

def _acquire_lock(path: Path, *, exclusive: bool, nonblocking: bool) -> Optional[int]:
    """Open and lock the file. Returns fd on success, None on failure."""
    flags = os.O_CREAT | os.O_RDWR
    try:
        fd = os.open(str(path), flags, 0o600)
    except OSError:
        return None
    flock_flags = fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH
    if nonblocking:
        flock_flags |= fcntl.LOCK_NB
    try:
        fcntl.flock(fd, flock_flags)
        return fd
    except OSError:
        os.close(fd)
        return None


# ---------------------------------------------------------------------------
# Guard log-level policy execution
# ---------------------------------------------------------------------------

def run_log_level_policy(
    *,
    disk_state: str,
    sd_health: dict,
    guard_state: dict,
    actions: list,
    now: datetime,
) -> dict:
    """Apply automatic log-level policy. Returns updated log_policy dict."""
    log_policy = dict(guard_state.get("log_policy") or {})
    if not isinstance(log_policy, dict):
        log_policy = {}

    # Fetch current API state.
    api_state = get_log_level_state()
    if api_state is None:
        logging.warning("storage guard: log-level API unavailable; skipping policy")
        return log_policy

    current_level = api_state["level"]
    current_changed_at = api_state.get("changed_at")

    # Track SD-health restriction timestamp for hysteresis / retention.
    sd_health_restricted_at: Optional[str] = log_policy.get("sd_health_restricted_at")

    # Compute automatic ceiling (passes hysteresis state).
    ceiling = compute_desired_ceiling(
        disk_state, sd_health,
        prev_sd_restricted_at=sd_health_restricted_at,
        now=now,
    )

    # Update sd_health_restricted_at.
    sd_now_restricting = _sd_health_ceiling_applies(sd_health, sd_health_restricted_at, now)
    sd_status = sd_health.get("status")
    sd_pct = sd_health.get("remaining_percent")
    if sd_now_restricting:
        # Refresh the timestamp on every valid reading that keeps restriction active
        # (both pct < 20 % and the [20 %, 25 %] hysteresis zone).  This ensures the
        # 72-hour stale-data retention window is measured from the most recent valid
        # decision, not the original trigger — so a transition from a days-long
        # hysteresis-zone run to unavailable data still grants the full 72-hour window.
        if sd_status == "valid" and isinstance(sd_pct, int):
            sd_health_restricted_at = now.strftime("%Y-%m-%dT%H:%M:%SZ")
        elif sd_health_restricted_at is None:
            sd_health_restricted_at = now.strftime("%Y-%m-%dT%H:%M:%SZ")
    else:
        sd_health_restricted_at = None

    active_reasons: list[str] = []
    if disk_state == "warning":
        active_reasons.append("disk_warning")
    elif disk_state == "critical":
        active_reasons.append("disk_critical")
    elif disk_state == "emergency":
        active_reasons.append("disk_emergency")

    if sd_now_restricting:
        active_reasons.append("low_sd_health")
        if sd_status == "valid" and isinstance(sd_pct, int) and sd_pct < SD_HEALTH_LOW_THRESHOLD:
            logging.warning(
                "storage guard: SD card health %d%% below threshold %d%%",
                sd_pct, SD_HEALTH_LOW_THRESHOLD,
            )
        else:
            logging.info("storage guard: SD card health restriction retained (hysteresis/stale)")

    guard_owns_reduction = bool(log_policy.get("guard_owns_reduction"))
    saved_level = log_policy.get("saved_level")
    saved_changed_at = log_policy.get("saved_changed_at")
    applied_level = log_policy.get("applied_level")

    # Check log-level expiry (applies regardless of changed_by).
    expiry_target = compute_expiry_target(api_state, now)
    if expiry_target is not None:
        if _level_quieter_than(expiry_target, current_level):
            reason_map = {
                ("debug", "info"): "debug_expired",
                ("spam", "info"): "spam_expired",
                ("info", "warning"): "info_expired",
            }
            reason = reason_map.get((current_level, expiry_target), "level_expired")
            logging.info(
                "storage guard: expiring %s → %s (%s)", current_level, expiry_target, reason
            )
            result = _api_put_log_level(expiry_target)
            if result and result.get("ok"):
                actions.append({"name": "log_level_expire", "ok": True,
                                "from": current_level, "to": expiry_target, "reason": reason})
                # Refresh API state after expiry change.
                api_state = get_log_level_state() or api_state
                current_level = api_state["level"]
                current_changed_at = api_state.get("changed_at")
            else:
                actions.append({"name": "log_level_expire", "ok": False,
                                "reason": reason})

    if ceiling is not None:
        # Need to apply a ceiling.
        if _level_quieter_than(ceiling, current_level):
            # Capture or update the restoration candidate.  When the guard already
            # owns the reduction and the user has since raised their chosen level
            # above the ceiling, the new selection becomes the candidate so it is
            # correctly restored once the ceiling is lifted.
            if not guard_owns_reduction:
                saved_level = current_level
                saved_changed_at = current_changed_at
                guard_owns_reduction = True
                logging.info(
                    "storage guard: capturing restoration candidate level=%s", saved_level
                )
            elif api_state.get("changed_by") == "user":
                saved_level = current_level
                saved_changed_at = current_changed_at
                logging.info(
                    "storage guard: updating restoration candidate level=%s", saved_level
                )
            # Apply ceiling.
            logging.warning(
                "storage guard: applying ceiling %s (current=%s, reasons=%s)",
                ceiling, current_level, active_reasons,
            )
            result = _api_put_log_level(ceiling)
            if result and result.get("ok"):
                applied_level = ceiling
                actions.append({"name": "log_level_ceiling", "ok": True,
                                "ceiling": ceiling, "previous": current_level,
                                "reasons": active_reasons})
            else:
                actions.append({"name": "log_level_ceiling", "ok": False,
                                "ceiling": ceiling, "reasons": active_reasons})
        else:
            # User may have changed level while guard reduction is active; update candidate.
            if guard_owns_reduction and api_state.get("changed_by") == "user":
                saved_level = current_level
                saved_changed_at = current_changed_at
    else:
        # No ceiling needed; attempt restoration if owned.
        if guard_owns_reduction and saved_level:
            # Check preconditions for restoration.
            if (
                api_state.get("changed_by") == "system"
                and current_level == applied_level
            ):
                # Apply expiry to saved candidate.
                restore_target = apply_expiry_to_saved(saved_level, saved_changed_at, now)
                if restore_target in VALID_LEVELS and restore_target != current_level:
                    logging.info(
                        "storage guard: restoring level %s → %s", current_level, restore_target
                    )
                    result = _api_put_log_level(restore_target)
                    if result and result.get("ok"):
                        guard_owns_reduction = False
                        saved_level = None
                        saved_changed_at = None
                        applied_level = None
                        actions.append({"name": "log_level_restore", "ok": True,
                                        "to": restore_target})
                    else:
                        actions.append({"name": "log_level_restore", "ok": False})
                else:
                    guard_owns_reduction = False
                    saved_level = None
                    saved_changed_at = None
                    applied_level = None
            else:
                # User action won; abandon ownership.
                guard_owns_reduction = False
                saved_level = None
                saved_changed_at = None
                applied_level = None

    return {
        "active_reasons": active_reasons,
        "guard_owns_reduction": guard_owns_reduction,
        "applied_level": applied_level,
        "saved_level": saved_level,
        "saved_changed_at": saved_changed_at,
        "sd_health_restricted_at": sd_health_restricted_at,
    }


# ---------------------------------------------------------------------------
# Cleanup orchestration
# ---------------------------------------------------------------------------

def run_cleanup(
    *,
    initial_state: str,
    actions: list,
    root_dev: int,
    guard_state: dict,
    emergency: bool = False,
) -> str:
    """Run cleanup stages appropriate for the given initial_state.

    Re-measures storage after each group and stops when recovery target is met.
    Returns the final storage state.
    """
    cap = EMERGENCY_DELETE_CAP if emergency else NORMAL_DELETE_CAP
    bytes_deleted = [0]

    def _remeasure() -> tuple[dict, str]:
        m = measure_storage()
        return m, classify_storage(m)

    current_state = initial_state

    if current_state == "normal":
        # Storage is fine, so there is nothing to reclaim. Cleanup only runs
        # from "warning" up, because it is not free: systemd-tmpfiles --clean
        # applies the distribution's age rules to /tmp and /var/tmp, deleting
        # idle runtime files that belong to whoever created them.
        return "normal"

    # Warning+ cleanup
    m = None
    if current_state in ("warning", "critical", "emergency"):
        action_start_logrotate(actions)
        action_apt_autoclean(actions)
        action_journal_vacuum(actions)
        action_tmpfiles_clean(actions)
        guard_state["last_tmpfiles_run_at"] = _utc_now_str()

        m, current_state = _remeasure()
        if has_recovered_from_warning(m):
            return current_state

    # Critical+ cleanup: branch on initial_state, not current_state.
    # Warning-stage cleanup may reduce critical to warning without reaching the
    # warning-recovery target; using current_state would incorrectly skip
    # critical-stage actions in that case.
    if initial_state in ("critical", "emergency"):
        action_apt_clean(actions)
        m, current_state = _remeasure()
        if has_recovered_from_critical(m):
            return current_state

        # Delete crash/coredump files
        for crash_dir in ("/var/lib/systemd/coredump", "/var/crash"):
            delete_crash_files(
                crash_dir,
                min_age_days=7,
                delete_cap_bytes=cap,
                bytes_deleted=bytes_deleted,
                actions=actions,
                emergency=emergency,
            )

        # Delete rotated log archives
        for directory in (
            "/var/log/autostream",
            "/var/log/nginx",
            "/var/log",
        ):
            delete_archive_files(
                directory,
                min_age_days=7,
                delete_cap_bytes=cap,
                bytes_deleted=bytes_deleted,
                actions=actions,
                preserve_newest=True,
                emergency=emergency,
            )
            m, current_state = _remeasure()
            if has_recovered_from_critical(m):
                return current_state

        action_apt_autoremove_simulate(actions)

    if emergency and not has_recovered_from_critical(m):
        action_journal_vacuum(actions, time_spec="1d", size_spec="64M")
        m, current_state = _remeasure()
        if has_recovered_from_critical(m):
            return current_state

        # Emergency: delete remaining archives including newest
        for directory in (
            "/var/log/autostream",
            "/var/log/nginx",
            "/var/log",
        ):
            delete_archive_files(
                directory,
                min_age_days=None,
                delete_cap_bytes=cap,
                bytes_deleted=bytes_deleted,
                actions=actions,
                preserve_newest=False,
                emergency=True,
            )

        # Emergency crash files regardless of age
        for crash_dir in ("/var/lib/systemd/coredump", "/var/crash"):
            delete_crash_files(
                crash_dir,
                min_age_days=None,
                delete_cap_bytes=cap,
                bytes_deleted=bytes_deleted,
                actions=actions,
                emergency=True,
            )

    m, current_state = _remeasure()
    return current_state


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> int:
    logging.basicConfig(
        level=logging.INFO,
        format="%(levelname)s: %(message)s",
        stream=sys.stdout,
    )

    now = datetime.now(timezone.utc)
    started_at = now.strftime("%Y-%m-%dT%H:%M:%SZ")
    result = "ok"
    skipped_reason = None
    actions: list[dict] = []
    storage_before: Optional[dict] = None
    storage_after: Optional[dict] = None
    log_policy: dict = {}

    guard_state = load_state()

    # 1. Singleton guard lock.
    guard_fd = _acquire_lock(GUARD_LOCK_PATH, exclusive=True, nonblocking=True)
    if guard_fd is None:
        logging.info("storage guard: another instance is running; exiting")
        return 0

    update_fd = None
    dial_fd = None
    try:
        # 2. Shared updater locks.
        update_fd = _acquire_lock(UPDATE_LOCK_PATH, exclusive=False, nonblocking=True)
        dial_fd = _acquire_lock(DIAL_UPDATE_LOCK_PATH, exclusive=False, nonblocking=True)
        if update_fd is None or dial_fd is None:
            logging.info("storage guard: update in progress; skipping run")
            skipped_reason = "update_in_progress"
            result = "skipped"
            _save_partial_state(guard_state, started_at, result, skipped_reason, actions, log_policy)
            return 0

        # 3. Playing check.
        playing = get_playing_status()
        if playing is True:
            logging.info("storage guard: appliance is playing; skipping run")
            skipped_reason = "playing"
            result = "skipped"
            _save_partial_state(guard_state, started_at, result, skipped_reason, actions, log_policy)
            return 0

        # 4. Measure storage.
        try:
            storage_before = measure_storage()
        except Exception as e:
            logging.error("storage guard: could not measure storage: %s", e)
            return 1

        initial_state = classify_storage(storage_before)
        root_dev = os.stat("/").st_dev

        # 5-6. Logrotate timer check.
        timer_status = _logrotate_timer_status()
        if timer_status["exists"] and not (timer_status["enabled"] and timer_status["active"]):
            action_enable_logrotate_timer(actions)

        # 7. SD-card health.
        sd_health = read_sdcard_health()

        # 8. Log-level policy (expiry and ceiling).
        log_policy = run_log_level_policy(
            disk_state=initial_state,
            sd_health=sd_health,
            guard_state=guard_state,
            actions=actions,
            now=now,
        )

        # 9-10. Diagnostic scan.
        largest_files = scan_largest_files(LARGE_FILE_SCAN_ROOTS, root_dev=root_dev)
        deleted_open = scan_deleted_open_files()

        # Cleanup.
        final_state = run_cleanup(
            initial_state=initial_state,
            actions=actions,
            root_dev=root_dev,
            guard_state=guard_state,
            emergency=(initial_state == "emergency"),
        )

        storage_after = measure_storage()
        bytes_deleted = sum(
            a.get("size_bytes", 0)
            for a in actions
            if a.get("name", "").startswith("delete_") and a.get("ok")
        )

        completed_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

        state_to_save = dict(guard_state)
        state_to_save.update({
            "schema_version": 1,
            "last_run_started_at": started_at,
            "last_run_completed_at": completed_at,
            "result": result,
            "skipped_reason": skipped_reason,
            "storage_state_before": initial_state,
            "storage_state_after": final_state,
            "before": storage_before,
            "after": storage_after,
            "bytes_deleted_directly": bytes_deleted,
            "actions": actions[:50],  # cap
            "sd_health": sd_health,
            "log_policy": log_policy,
            "largest_files": largest_files[:LARGE_FILE_REPORT_MAX],
            "deleted_open_files": deleted_open[:20],
        })
        save_state(state_to_save)

        logging.info(
            "storage guard: done. state %s→%s, freed %d bytes, %d actions",
            initial_state, final_state, bytes_deleted, len(actions),
        )
        return 0

    except Exception as e:
        logging.error("storage guard: fatal: %s", e)
        return 1
    finally:
        for fd in (guard_fd, update_fd, dial_fd):
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass


def _save_partial_state(
    guard_state: dict, started_at: str, result: str, skipped_reason: Optional[str],
    actions: list, log_policy: dict,
) -> None:
    completed_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    state_to_save = dict(guard_state)
    state_to_save.update({
        "schema_version": 1,
        "last_run_started_at": started_at,
        "last_run_completed_at": completed_at,
        "result": result,
        "skipped_reason": skipped_reason,
        "actions": actions,
        "log_policy": log_policy,
    })
    save_state(state_to_save)


if __name__ == "__main__":
    sys.exit(main())
