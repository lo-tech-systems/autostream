# ---------------------------------------------------------------------------
# Archive allowlist
# ---------------------------------------------------------------------------

# Mapping from directory path -> permitted base log names.
_ARCHIVE_ALLOWLIST: dict[str, frozenset[str]] = {
    "/var/log/autostream": frozenset(),  # all rotated archives; base name is irrelevant
    "/var/log/nginx": frozenset({"access.log", "error.log"}),
    "/var/log": frozenset({
        "syslog", "auth.log", "kern.log", "daemon.log",
        "user.log", "messages", "debug",
        "mail.log", "mail.warn", "mail.err", "mail.info",
        "dpkg.log", "alternatives.log",
    }),
}

# Compiled archive name pattern: <base>.<N>[.ext] or <base>-<YYYYMMDD>[.ext]
# Note: for /var/log/autostream, the base name varies; we match *any* rotated name.
_ARCHIVE_EXTS = r"(?:\.gz|\.bz2|\.xz|\.zst)?"
_ARCHIVE_NUMBERED_RE = re.compile(
    r"^(.+?)\.(\d+)" + _ARCHIVE_EXTS + r"$"
)
_ARCHIVE_DATED_RE = re.compile(
    r"^(.+?)-(\d{8})" + _ARCHIVE_EXTS + r"$"
)


def _is_eligible_archive(directory: str, filename: str) -> bool:
    """Return True if `filename` in `directory` is an allowlisted rotated archive.

    The active base log (name equals <base> exactly, no numeric/date suffix)
    is never eligible.  Unknown directories are not eligible.
    """
    allowed_bases = _ARCHIVE_ALLOWLIST.get(directory)
    if allowed_bases is None:
        return False

    m = _ARCHIVE_NUMBERED_RE.match(filename) or _ARCHIVE_DATED_RE.match(filename)
    if not m:
        return False

    base = m.group(1)

    # /var/log/autostream: any rotated file with numeric or dated suffix is eligible.
    if directory == "/var/log/autostream":
        return True

    # Nginx and /var/log: base must be an exact permitted name.
    # Compare against the base name without any compression extension.
    return base in allowed_bases


# ---------------------------------------------------------------------------
# Storage measurement
# ---------------------------------------------------------------------------

def measure_storage() -> dict:
    """Return a dict with total/free bytes, percentages, and inode info."""
    du = shutil.disk_usage("/")
    sv = os.statvfs("/")

    total_bytes = du.total
    free_bytes = du.free
    used_bytes = du.used
    free_pct = (free_bytes / total_bytes * 100.0) if total_bytes > 0 else 100.0

    total_inodes = sv.f_files
    free_inodes = sv.f_favail
    free_inode_pct = (free_inodes / total_inodes * 100.0) if total_inodes > 0 else 100.0

    return {
        "total_bytes": total_bytes,
        "free_bytes": free_bytes,
        "used_bytes": used_bytes,
        "free_percent": round(free_pct, 2),
        "free_inodes_percent": round(free_inode_pct, 2),
        "total_inodes": total_inodes,
        "free_inodes": free_inodes,
    }


def classify_storage(m: dict) -> str:
    """Classify storage state: 'normal', 'warning', 'critical', or 'emergency'."""
    free_bytes = m["free_bytes"]
    free_pct = m["free_percent"]
    free_inode_pct = m["free_inodes_percent"]

    if (free_pct < CRITICAL_FREE_PCT_MIN
            or free_bytes < CRITICAL_FREE_BYTES_MIN
            or free_inode_pct < CRITICAL_FREE_INODE_PCT_MIN):
        return "emergency"

    if (free_pct < WARNING_FREE_PCT_MIN
            or free_bytes < WARNING_FREE_BYTES_MIN
            or free_inode_pct < WARNING_FREE_INODE_PCT_MIN):
        return "critical"

    if (free_pct < NORMAL_FREE_PCT_MIN
            or free_bytes < NORMAL_FREE_BYTES_MIN
            or free_inode_pct < NORMAL_FREE_INODE_PCT_MIN):
        return "warning"

    return "normal"


def has_recovered_from_warning(m: dict) -> bool:
    return (
        m["free_bytes"] >= RECOVER_WARN_FREE_BYTES
        and m["free_percent"] >= RECOVER_WARN_FREE_PCT
        and m["free_inodes_percent"] >= RECOVER_WARN_FREE_INODE_PCT
    )


def has_recovered_from_critical(m: dict) -> bool:
    return (
        m["free_bytes"] >= RECOVER_CRIT_FREE_BYTES
        and m["free_percent"] >= RECOVER_CRIT_FREE_PCT
        and m["free_inodes_percent"] >= RECOVER_CRIT_FREE_INODE_PCT
    )


# ---------------------------------------------------------------------------
# SD-card health
# ---------------------------------------------------------------------------

def _parse_sdcard_health_percent(data: dict) -> Optional[int]:
    """Duplicate of autostream_sysutils._parse_sdcard_health_percent (stdlib only)."""
    def _coerce_float(v):
        try:
            return float(v)
        except Exception:
            return None

    def _coerce_bool(v):
        if isinstance(v, bool):
            return v
        if isinstance(v, str):
            if v.strip().lower() in ("true", "yes", "1"):
                return True
            if v.strip().lower() in ("false", "no", "0"):
                return False
        return None

    success = _coerce_bool(data.get("success"))
    if success is not True:
        return None

    remaining = None
    if "enduranceRemainLifePercent" in data:
        remaining = _coerce_float(data.get("enduranceRemainLifePercent"))
    elif "healthStatusPercentUsed" in data:
        used = _coerce_float(data.get("healthStatusPercentUsed"))
        if used is not None:
            remaining = 100.0 - used

    if remaining is None:
        return None
    if remaining < -0.5 or remaining > 100.5:
        return None
    return max(0, min(100, int(round(remaining))))


def read_sdcard_health() -> dict:
    """Return {status, remaining_percent, sampled_at} from sdcardhealth.json.

    status: 'valid', 'stale', 'unavailable', or 'error'.
    """
    path = SDCARD_HEALTH_PATH
    try:
        if not path.is_file():
            return {"status": "unavailable", "remaining_percent": None, "sampled_at": None}

        # Reject symlinks
        if path.is_symlink():
            return {"status": "unavailable", "remaining_percent": None, "sampled_at": None}

        stat = path.stat()
        age_hours = (time.time() - stat.st_mtime) / 3600.0
        if age_hours > SD_HEALTH_STALE_HOURS:
            return {"status": "stale", "remaining_percent": None,
                    "sampled_at": _utc_ts_from_mtime(stat.st_mtime)}

        raw = path.read_text(encoding="utf-8", errors="replace").strip()
        data = json.loads(raw)
        if not isinstance(data, dict):
            return {"status": "unavailable", "remaining_percent": None, "sampled_at": None}

        pct = _parse_sdcard_health_percent(data)
        if pct is None:
            return {"status": "unavailable", "remaining_percent": None, "sampled_at": None}

        return {
            "status": "valid",
            "remaining_percent": pct,
            "sampled_at": _utc_ts_from_mtime(stat.st_mtime),
        }
    except Exception as e:
        return {"status": "error", "remaining_percent": None, "sampled_at": None}


def _utc_ts_from_mtime(mtime: float) -> str:
    return datetime.fromtimestamp(mtime, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _utc_now_str() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _parse_utc_ts(ts: object) -> Optional[datetime]:
    if not isinstance(ts, str):
        return None
    try:
        return datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except ValueError:
        return None


