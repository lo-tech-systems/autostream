def _api_get(path: str) -> Optional[dict]:
    """GET the given path; return the parsed JSON dict or None."""
    url = f"{API_BASE}{path}"
    try:
        req = urllib_request.Request(url, method="GET")
        with urllib_request.urlopen(req, timeout=API_TIMEOUT) as resp:
            if resp.status != 200:
                return None
            ct = (resp.headers.get("Content-Type") or "").split(";")[0].strip()
            if ct != "application/json":
                return None
            body = resp.read(16384).decode("utf-8", errors="replace")
            data = json.loads(body)
            if not isinstance(data, dict):
                return None
            return data
    except (URLError, OSError, json.JSONDecodeError, Exception):
        return None


def _api_put_log_level(level: str) -> Optional[dict]:
    """PUT /api/log-level; return parsed response or None."""
    url = f"{API_BASE}/api/log-level"
    body = json.dumps({"level": level}).encode("utf-8")
    try:
        req = urllib_request.Request(
            url,
            data=body,
            method="PUT",
            headers={"Content-Type": "application/json"},
        )
        with urllib_request.urlopen(req, timeout=API_TIMEOUT) as resp:
            if resp.status != 200:
                return None
            data = json.loads(resp.read(16384).decode("utf-8", errors="replace"))
            if not isinstance(data, dict):
                return None
            return data
    except Exception:
        return None


def get_playing_status() -> Optional[bool]:
    """Return True if playing, False if idle, None if unknown/uncertain.

    Accepts playback state only when the response is exactly ``ok: true`` and
    ``playing`` is a JSON boolean.  Any unreachable, malformed, or explicitly
    uncertain (``ok: false``) response is treated conservatively as None
    rather than as stopped playback (Section 8.3).
    """
    data = _api_get("/api/playing-status")
    if data is None:
        return None
    if data.get("ok") is not True:
        return None
    playing = data.get("playing")
    if not isinstance(playing, bool):
        return None
    return playing


def get_log_level_state() -> Optional[dict]:
    """Return the log-level API state dict, or None if unreachable."""
    data = _api_get("/api/log-level")
    if data is None:
        return None
    if not data.get("ok"):
        return None
    level = str(data.get("level") or "")
    if level not in VALID_LEVELS:
        return None
    return {
        "level": level,
        "changed_by": str(data.get("changed_by") or "user"),
        "changed_at": data.get("changed_at") if isinstance(data.get("changed_at"), str) else None,
    }


# ---------------------------------------------------------------------------
# Log-level policy helpers
# ---------------------------------------------------------------------------

def _level_quieter_than(a: str, b: str) -> bool:
    """Return True if level `a` is quieter (less verbose) than `b`."""
    order = {lvl: i for i, lvl in enumerate(LEVEL_ORDER)}
    return order.get(a, 9999) < order.get(b, 9999)


def _sd_health_ceiling_applies(
    sd_health: dict,
    prev_sd_restricted_at: Optional[str],
    now: datetime,
) -> bool:
    """Return True if SD-card health should apply a warning ceiling.

    Three cases:
    - Fresh trigger: valid reading below SD_HEALTH_LOW_THRESHOLD (< 20%).
    - Hysteresis: valid reading in [20 %, 25 %] when previously restricted.
      This is NOT time-bounded — only clears when health rises strictly above
      SD_HEALTH_RECOVER_THRESHOLD (> 25%).
    - Stale/unavailable retention: non-valid data within SD_HEALTH_RETAIN_HOURS
      of the last valid restricted reading.  Valid in-range readings bypass
      this window entirely (covered by the hysteresis case above).
    """
    status = sd_health.get("status")
    pct = sd_health.get("remaining_percent")

    if status == "valid" and isinstance(pct, int):
        if pct < SD_HEALTH_LOW_THRESHOLD:
            return True  # fresh trigger
        if prev_sd_restricted_at is not None and pct <= SD_HEALTH_RECOVER_THRESHOLD:
            return True  # hysteresis zone [20 %, 25 %] — retain until strictly above 25 %
        # pct > 25 % (fully recovered) or no previous restriction: clear
        return False

    # Status is stale, unavailable, or error: apply 72-hour retention window.
    if prev_sd_restricted_at is not None:
        prev_dt = _parse_utc_ts(prev_sd_restricted_at)
        if prev_dt is not None and (now - prev_dt) < timedelta(hours=SD_HEALTH_RETAIN_HOURS):
            return True

    return False


def compute_desired_ceiling(
    disk_state: str,
    sd_health: dict,
    *,
    prev_sd_restricted_at: Optional[str] = None,
    now: Optional[datetime] = None,
) -> Optional[str]:
    """Return the quietest automatic log-level ceiling, or None if no restriction.

    Pass prev_sd_restricted_at (from persisted log_policy) and now so that
    SD-health hysteresis (25% recovery) and 72-hour stale-data retention apply.
    Without these kwargs the function falls back to a simple threshold check.
    """
    ceilings: list[str] = []

    if disk_state == "warning":
        ceilings.append("info")
    elif disk_state in ("critical", "emergency"):
        ceilings.append("warning")

    _now = now if now is not None else datetime.now(timezone.utc)
    if _sd_health_ceiling_applies(sd_health, prev_sd_restricted_at, _now):
        ceilings.append("warning")

    if not ceilings:
        return None

    # Pick the quietest (most restrictive) ceiling.
    order = {lvl: i for i, lvl in enumerate(LEVEL_ORDER)}
    return min(ceilings, key=lambda lvl: order.get(lvl, 9999))


def compute_expiry_target(api_state: dict, now: datetime) -> Optional[str]:
    """Return the expiry target level, or None if no expiry is due."""
    level = api_state.get("level")
    changed_at = _parse_utc_ts(api_state.get("changed_at"))
    if changed_at is None:
        return None

    elapsed = now - changed_at

    if level in DIAG_LEVELS and elapsed >= timedelta(hours=EXPIRY_TIER1_HOURS):
        return "info"

    if level == "info" and elapsed >= timedelta(hours=EXPIRY_TIER2_HOURS):
        return "warning"

    return None


def apply_expiry_to_saved(saved_level: str, saved_at_str: Optional[str], now: datetime) -> str:
    """Apply expiry rules to a saved restoration candidate level."""
    saved_at = _parse_utc_ts(saved_at_str)
    if saved_at is None:
        return saved_level

    elapsed = now - saved_at

    if saved_level in DIAG_LEVELS and elapsed >= timedelta(hours=EXPIRY_TIER1_HOURS):
        saved_level = "info"
        elapsed = timedelta(0)  # info clock starts at expiry event; no second-tier expiry

    if saved_level == "info" and elapsed >= timedelta(hours=EXPIRY_TIER2_HOURS):
        return "warning"

    return saved_level


