def _find_cmd(candidates: tuple) -> Optional[str]:
    for c in candidates:
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def _run(cmd: list, *, timeout: int = 60, env: Optional[dict] = None) -> dict:
    """Run a command, return {ok, rc, stdout_head, stderr_head}."""
    try:
        merged_env = dict(os.environ)
        if env:
            merged_env.update(env)
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=timeout,
            env=merged_env,
        )
        ok = result.returncode == 0
        return {
            "ok": ok,
            "rc": result.returncode,
            "stdout_head": (result.stdout or "")[:512],
            "stderr_head": (result.stderr or "")[:512],
        }
    except subprocess.TimeoutExpired:
        return {"ok": False, "rc": -1, "stdout_head": "", "stderr_head": "timeout"}
    except FileNotFoundError:
        return {"ok": False, "rc": -1, "stdout_head": "", "stderr_head": "not found"}
    except Exception as e:
        return {"ok": False, "rc": -1, "stdout_head": "", "stderr_head": str(e)[:200]}


_APT_NONINTERACTIVE_ENV = {"DEBIAN_FRONTEND": "noninteractive"}
_APT_LOCK_OPTS = ["-o", "DPkg::Lock::Timeout=0"]


# ---------------------------------------------------------------------------
# Large-file scanning
# ---------------------------------------------------------------------------

def scan_largest_files(roots: tuple, *, root_dev: int) -> list:
    """Scan allowed roots for largest regular files; return sorted list of dicts."""
    found: list[tuple[int, str]] = []  # (size, path)

    def _scan_dir(directory: Path, *, toplevel: bool = False) -> None:
        try:
            entries = list(directory.iterdir())
        except OSError:
            return
        for entry in entries:
            try:
                # Never follow symlinks
                if entry.is_symlink():
                    continue
                st = entry.stat(follow_symlinks=False)
                # Stay on root filesystem
                if st.st_dev != root_dev:
                    continue
                if entry.is_dir(follow_symlinks=False):
                    # For /var/log, only descend into 'nginx' and 'autostream' subdirs
                    if directory == Path("/var/log") and toplevel:
                        if entry.name not in ("nginx", "autostream"):
                            continue
                    _scan_dir(entry)
                elif entry.is_file(follow_symlinks=False):
                    found.append((st.st_size, str(entry)))
            except OSError:
                continue

    for root in roots:
        if not root.is_dir():
            continue
        _scan_dir(root, toplevel=(root == Path("/var/log")))

    found.sort(reverse=True)
    top = found[:LARGE_FILE_REPORT_MAX]
    return [{"size_bytes": sz, "path": p} for sz, p in top]


def scan_deleted_open_files() -> list:
    """Find large deleted-but-open files via /proc. Returns list of dicts."""
    proc = Path("/proc")
    if not proc.is_dir():
        return []
    results = []
    try:
        for pid_dir in proc.iterdir():
            if not pid_dir.name.isdigit():
                continue
            fd_dir = pid_dir / "fd"
            try:
                for fd_link in fd_dir.iterdir():
                    try:
                        target = os.readlink(str(fd_link))
                        if "(deleted)" not in target:
                            continue
                        st = fd_link.stat()
                        if st.st_size < DELETED_OPEN_MIN_BYTES:
                            continue
                        # Get bounded process name
                        try:
                            comm = (pid_dir / "comm").read_text(errors="replace").strip()[:64]
                        except OSError:
                            comm = "unknown"
                        results.append({
                            "pid": pid_dir.name,
                            "comm": comm,
                            "fd": fd_link.name,
                            "size_bytes": st.st_size,
                            "path": target[:256],
                        })
                        if len(results) >= 20:
                            return results
                    except OSError:
                        continue
            except OSError:
                continue
    except OSError:
        pass
    return results


