def update_apmode_flag(in_setup: bool) -> None:
    """Create or remove the AP mode flag file at AP_MODE_FLAG_PATH."""
    try:
        if in_setup:
            if not os.path.exists(AP_MODE_FLAG_PATH):
                with open(AP_MODE_FLAG_PATH, "w", encoding="utf-8") as f:
                    f.write("1\n")
