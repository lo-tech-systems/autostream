# ** LOCAL CONTROL API (WP6, Section 10.1) **

def init_control_token() -> str:
    """Generate the per-boot control token and write it root:autostream 0640.

    The runtime dir is created root:autostream 0750 when needed.  Replacement at
    each startup is authoritative.  Returns the token (also stored in module
    state).  Never logged.
    """
    global _control_token
    _control_token = secrets.token_urlsafe(32)
    try:
        os.makedirs(CONTROL_TOKEN_DIR, exist_ok=True)
        try:
            os.chmod(CONTROL_TOKEN_DIR, 0o750)
        except OSError:
            pass
        wifi_net._atomic_write(CONTROL_TOKEN_PATH, _control_token + "\n", mode=0o640)
        # Best-effort group ownership so the unprivileged Web UI can read it.
        try:
            import grp
            gid = grp.getgrnam("autostream").gr_gid
            os.chown(CONTROL_TOKEN_PATH, 0, gid)
            os.chown(CONTROL_TOKEN_DIR, 0, gid)
        except (KeyError, OSError, ImportError):
            pass
    except Exception as e:
        logger.error("Failed to write control token file: %s", e)
    return _control_token


def remove_control_token() -> None:
    try:
        os.unlink(CONTROL_TOKEN_PATH)
    except OSError:
        pass


def _is_loopback_remote() -> bool:
    return (request.remote_addr or "") in ("127.0.0.1", "127.0.1.1", "::1")


def _control_authorised() -> bool:
    """Require BOTH a loopback source AND a matching per-boot token header.

    Loopback alone is insufficient: during AP mode nginx proxies external
    captive-portal clients to the watcher, so Flask may see loopback.  Tokens are
    compared with hmac.compare_digest.
    """
    if not _is_loopback_remote():
        return False
    supplied = request.headers.get(CONTROL_TOKEN_HEADER, "")
    if not supplied or not _control_token:
        return False
    return hmac.compare_digest(supplied, _control_token)


_VALID_CONTROL_ACTIONS = {"start_setup", "reconnect_saved", "set_log_level"}


@app.route("/network_status", methods=["GET"])
def network_status():
    if not _control_authorised():
        return jsonify({"ok": False, "error": "forbidden"}), 403
    with state_lock:
        snapshot = STATE.network_status_snapshot
    if not snapshot:
        return jsonify({
            "ok": True,
            "schema_version": wifi_net.NETWORK_STATUS_SCHEMA_VERSION,
            "device": {"state": "unknown"},
            "stale": True,
        })
    return jsonify(snapshot)


@app.route("/network_control", methods=["POST"])
def network_control():
    """Queue a disruptive network action; never execute it in the request thread.

    Validates/authenticates, stores one pending action under the state lock,
    signals the monitor loop, and returns a queued response before any interface
    is disconnected.  Rejects unknown actions/fields and a second conflicting
    action while one is pending or in progress.
    """
    if not _control_authorised():
        logger.warning("Rejected /network_control (unauthenticated/non-loopback)")
        return jsonify({"ok": False, "error": "forbidden"}), 403

    payload = request.get_json(silent=True)
    if not isinstance(payload, dict):
        return jsonify({"ok": False, "error": "invalid_body"}), 400
    action = payload.get("action")
    keys = set(payload.keys())

    # Per-action field validation (WP7).  start_setup/reconnect_saved accept
    # only {"action"}; set_log_level accepts {"action","level","ttl_seconds?"}.
    params: dict = {}
    if action in ("start_setup", "reconnect_saved"):
        if keys != {"action"}:
            return jsonify({"ok": False, "error": "invalid_action"}), 400
    elif action == "set_log_level":
        if not keys <= {"action", "level", "ttl_seconds"}:
            return jsonify({"ok": False, "error": "invalid_action"}), 400
        level = payload.get("level")
        ttl = payload.get("ttl_seconds", None)
        error, clamped = validate_log_level_request(level, ttl)
        if error:
            logger.warning("Rejected set_log_level request: %s", error)
            return jsonify({"ok": False, "error": error}), 400
        params = {"level": level, "ttl_seconds": clamped}
    else:
        return jsonify({"ok": False, "error": "invalid_action"}), 400

    with state_lock:
        if STATE.pending_control_action or STATE.control_in_progress:
            return jsonify({"ok": False, "error": "busy"}), 409
        STATE.pending_control_action = action
        STATE.pending_control_params = params
        control_action_event.set()

    logger.info("Queued network control action: %s", action)
    return jsonify({"ok": True, "queued": True, "action": action})


@app.route("/request_ap_mode", methods=["POST"])
def request_ap_mode():
    """Allow the normal (non-setup) WebUI to request AP/setup mode.

    Retained for compatibility but now requires both a loopback source and the
    per-boot control token, so no unauthenticated privileged loopback-only route
    remains behind nginx.
    """
    if not _control_authorised():
        logger.warning("Rejected /request_ap_mode (unauthenticated/non-loopback)")
        return jsonify({"ok": False, "error": "forbidden"}), 403

    reason = ""
    if request.is_json:
        payload = request.get_json(silent=True) or {}
        reason = str(payload.get("reason", "")).strip()
    if not reason:
        reason = (request.form.get("reason") or "").strip()

    with state_lock:
        # Reject early if AP mode is exhausted for this boot cycle and cannot be
        # force-entered (i.e. no recent failed config attempt).  Without this the
        # caller would receive a success response but AP mode would never start.
        if STATE.ap_exhausted and not STATE.force_setup_mode:
            logger.warning("AP mode request rejected: ap_exhausted latch set (reason='%s')", reason or "UserRequest")
            return jsonify({
                "ok": False,
                "error": "ap_exhausted",
                "message": "AP mode is not available until the device is power-cycled.",
            }), 409
        STATE.ap_request_reason = reason
        ap_request_event.set()

    logger.info("AP mode requested via /request_ap_mode (reason='%s')", reason or "UserRequest")
    return jsonify({"ok": True, "queued": True})


# ** TRANSACTIONAL CHANGE-WI-FI FLOW (WP6) **

def _snapshot_rollback() -> None:
    """Record the current committed profile and active adapter for rollback."""
    state = get_configured_network_state()
    with state_lock:
        active_mac = STATE.active_client_mac
        STATE.rollback_connection_name = state.connection_name
        STATE.rollback_connection_uuid = state.connection_uuid
        STATE.rollback_adapter_mac = active_mac


def validate_log_level_request(level, ttl) -> tuple[str, Optional[int]]:
    """Validate a set_log_level request (WP7).

    Returns ``(error, clamped_ttl)``; *error* is "" when valid.  ``debug``
    requires a TTL; provided TTLs must be numeric and are clamped to
    [LOG_LEVEL_TTL_MIN, LOG_LEVEL_TTL_MAX].
    """
    if level not in RUNTIME_LOG_LEVELS:
        return "invalid_level", None
    if ttl is None:
        if level == "debug":
            return "ttl_required_for_debug", None
        return "", None
    if isinstance(ttl, bool) or not isinstance(ttl, (int, float)) or ttl <= 0:
        return "invalid_ttl", None
    clamped = int(max(LOG_LEVEL_TTL_MIN, min(LOG_LEVEL_TTL_MAX, ttl)))
    return "", clamped


def apply_log_level(level: str, ttl_seconds: Optional[int]) -> None:
    """Apply a runtime log level, optionally temporary for *ttl_seconds*.

    Without a TTL the level becomes the runtime level until the service
    restarts or another valid request changes it; the startup default
    (AUTOSTREAM_WIFI_LOG_LEVEL) is preserved for revert.
    """
    levelno = RUNTIME_LOG_LEVELS[level]
    logging.getLogger().setLevel(levelno)
    now = time.monotonic()
    with state_lock:
        if ttl_seconds:
            STATE.temporary_log_level = level
            STATE.temporary_log_level_until = now + ttl_seconds
        else:
            STATE.temporary_log_level = ""
            STATE.temporary_log_level_until = None
            STATE.default_log_level_name = level
    if ttl_seconds:
        logger.info("Runtime log level changed to %s for %ds", level, ttl_seconds)
    else:
        logger.info("Runtime log level changed to %s", level)


def revert_expired_log_level(now: Optional[float] = None) -> None:
    """Revert a temporary runtime log level once its TTL expires (WP7)."""
    if now is None:
        now = time.monotonic()
    with state_lock:
        until = STATE.temporary_log_level_until
        if until is None or now < until:
            return
        default = STATE.default_log_level_name or "info"
        STATE.temporary_log_level = ""
        STATE.temporary_log_level_until = None
    logging.getLogger().setLevel(RUNTIME_LOG_LEVELS.get(default, logging.INFO))
    logger.info("Runtime log level reverted to %s", default)


def process_control_action(action: str, params: Optional[dict] = None) -> None:
    """Consume one queued control action in the monitor loop (Section 10.1)."""
    params = params or {}
    with state_lock:
        STATE.control_in_progress = True
        STATE.last_control_action = action
        STATE.last_control_error = ""
    try:
        if action == "start_setup":
            start_explicit_setup()
            result = "ok"
        elif action == "reconnect_saved":
            result = "ok" if reconnect_saved_network() else "failed"
        elif action == "set_log_level":
            apply_log_level(params.get("level"), params.get("ttl_seconds"))
            result = "ok"
        else:
            result = "failed"
    except Exception as e:
        logger.warning("Control action '%s' raised: %s", action, e)
        result = "failed"
        with state_lock:
            STATE.last_control_error = str(e)
    with state_lock:
        STATE.control_in_progress = False
        STATE.last_control_result = result


def start_explicit_setup() -> None:
    """Begin an explicit Change-Wi-Fi reconfiguration session (Section 11.1).

    Snapshots the current profile/adapter, disconnects the current client
    session (without deleting its profile), enters the built-in hotspot, and
    starts the 30-minute deadline.  Bypasses the once-per-boot ap_exhausted
    latch via force_setup_mode.
    """
    _snapshot_rollback()
    # Disconnect the current client session without deleting its profile.
    with state_lock:
        active_ifname = STATE.active_client_ifname
    if active_ifname:
        run_cmd(["nmcli", "device", "disconnect", active_ifname])
    with state_lock:
        STATE.reconfigure_active = True
        STATE.reconfigure_started_at = time.monotonic()
        STATE.setup_purpose = "explicit_reconfigure"
        STATE.force_setup_mode = True  # bypass ap_exhausted for explicit setup
        STATE.manual_ap_active = True
    logger.info("Explicit network setup starting (explicit_reconfigure)")
    enter_setup_mode(reason="explicit_reconfigure")


def reconnect_saved_network() -> bool:
    """Reconnect to the saved/rollback network and exit hotspot mode on success.

    During explicit reconfiguration the snapshotted rollback profile is restored
    on its previous adapter first; otherwise USB-first deterministic order then
    built-in is used.  On success leave_setup_mode() is called and session state
    cleared; on failure the hotspot is retained.
    """
    with state_lock:
        purpose = STATE.setup_purpose
        rb_name = STATE.rollback_connection_name
        rb_uuid = STATE.rollback_connection_uuid
        rb_mac = STATE.rollback_adapter_mac
    adapters = wifi_net.discover_adapters()

    targets: list = []
    if purpose == "explicit_reconfigure" and rb_name:
        prev = wifi_net.find_adapter_by_mac(adapters, rb_mac)
        if prev is not None:
            targets.append(prev)
        # Then fall back to USB-first, then built-in.
        for a in wifi_net.client_candidate_order(adapters):
            if a not in targets:
                targets.append(a)
        committed = wifi_net.NetworkState(connection_name=rb_name, connection_uuid=rb_uuid)
    else:
        targets = wifi_net.client_candidate_order(adapters)
        committed = get_configured_network_state()

    if not committed.is_configured:
        return False

    # Resolve UUID (lazily persisting if missing) and clear cross-adapter
    # restrictions once, before iterating over target adapters, so a legacy
    # profile bound to a specific interface/MAC can be activated on any adapter.
    committed_uuid = _resolve_committed_uuid(committed)
    if committed_uuid:
        run_cmd(wifi_net.clear_restrictions_cmd(committed_uuid, wifi_net.CROSS_ADAPTER_RESTRICTIONS))

    def _attempt(target) -> bool:
        run_cmd(wifi_net.activate_connection_cmd(
            committed_uuid, committed.connection_name, target.ifname))
        if wait_for_connection(target.ifname, timeout=WAIT_FOR_CONNECTION_TIMEOUT,
                               interval=WAIT_FOR_CONNECTION_INTERVAL) \
                and is_wifi_client_healthy(target.ifname):
            logger.info("Reconnected to saved network on %s", target.ifname)
            return True
        return False

    if attempt_on_targets(targets, _attempt):
        return True

    logger.warning("Reconnect to saved network failed; retaining hotspot")
    return False


def handle_reconfigure_timeout() -> None:
    """30-minute explicit-reconfiguration timeout rollback (Section 11.4)."""
    logger.info("Explicit network setup timed out after %ds; restoring previous", AP_MAX_DURATION)
    if reconnect_saved_network():
        return
    # Restoration failed: retain hotspot, convert to automatic recovery.
    with state_lock:
        STATE.reconfigure_active = False
        STATE.reconfigure_started_at = None
        STATE.setup_purpose = "automatic_recovery"
    logger.warning("Timeout restore failed; remaining in recovery hotspot")


def _clear_reconfigure_state() -> None:
    with state_lock:
        STATE.reconfigure_active = False
        STATE.reconfigure_started_at = None
        STATE.rollback_connection_name = ""
        STATE.rollback_connection_uuid = ""
        STATE.rollback_adapter_mac = ""
        STATE.setup_purpose = "manual"



# ** MAIN NETWORK STATUS MONITORING LOOP **


def _sleep_or_finish_monitor_pass(run_once: bool) -> bool:
    """Sleep between monitor passes, or signal one-pass tests to return."""
    if run_once:
        return True
    time.sleep(NETWORK_MONITOR_INTERVAL)
    return False


def _request_network_down_reboot(now: float, reason: str) -> None:
    """Request a guarded NetworkDown reboot using the shared in-process throttle."""
    with state_lock:
        retry_after = STATE.conn_reboot_retry_after
    if now >= retry_after:
        logger.warning("%s; requesting reboot", reason)
        accepted = reboot_system("NetworkDown")
        with state_lock:
            STATE.conn_reboot_retry_after = (
                float('inf') if accepted
                else now + REBOOT_RATE_LIMIT_RETRY
            )
    elif retry_after == float('inf'):
        logger.debug("NetworkDown reboot accepted; waiting for system to reboot")
    else:
        logger.debug(
            "NetworkDown reboot suppressed; will retry in %.0fs",
            retry_after - now,
        )


def network_monitor_loop(run_once: bool = False):
    """Background loop to check network state and enforce the narrative rules.

    Summary of behaviour:
      - If wired ethernet is usable (carrier plus valid IPv4): never enter
            automatic AP mode; if currently in AP mode, exit it unless the user
            explicitly requested AP via /request_ap_mode.
      - If WiFi is unconfigured OR still disconnected after BOOT_AP_GRACE seconds:
            enter AP mode within the boot window (BOOT_AP_GRACE..BOOT_AP_CUTOFF).
            Unconfigured devices: AP runs indefinitely (no timeout).
            Configured devices that failed to reconnect: AP runs for AP_MAX_DURATION.
      - If WiFi is configured and usable ethernet is down:
            use the kernel's view of the default gateway as a health check.
            If unreachable for > GW_DOWN_RECONNECT_AFTER: periodically attempt reconnect.
            If unreachable for > GW_DOWN_REBOOT_AFTER: reboot.

    Reboot-timer domains:
      - Dead-PHY: 30-minute guarded reboot when genuinely offline; resets can
            still run while ethernet is attached.
      - Generic WiFi gateway-down: 30-minute guarded reboot for configured WiFi
            clients, skipped whenever usable ethernet is present.
      - Global no-active-path catch-all: 12-hour guarded reboot when no usable
            non-hotspot WiFi or ethernet path has been seen during normal
            monitoring. Setup/AP mode suspends this timer; leaving AP rebases it.
    """
    logger.info("Starting network monitor loop")

    # Record boot time on first entry
    with state_lock:
        if STATE.boot_time is None:
            STATE.boot_time = time.monotonic()
        if STATE.last_active_path_seen is None:
            STATE.last_active_path_seen = STATE.boot_time

    last_avahi_check: float = 0.0

    while True:
        now = time.monotonic()
        with state_lock:
            # Only clear manual_ap_active when AP is not running.  While AP is active
            # the flag must persist so the ethernet-suppression check below respects
            # the user's explicit request for the full session, not just one iteration.
            # leave_setup_mode and the AP-lifetime expiry block clear the flag on close.
            if not STATE.setup_mode:
                STATE.manual_ap_active = False
            boot_time = STATE.boot_time or now
            _avahi_ok = not STATE.setup_mode and not STATE.apply_in_progress

        # Avahi mDNS hostname check (reduced frequency; skip during setup and WiFi apply)
        if _avahi_ok and (now - last_avahi_check) >= AVAHI_CHECK_INTERVAL:
            last_avahi_check = now
            check_and_repair_avahi_hostname()

        # mDNS host-record re-announce: catch passive network-path changes (e.g. a
        # USB Wi-Fi adapter removed while ethernet stays up) as well as orchestrated
        # handovers, debounced until the published address set settles.  Runs every
        # pass; skipped during setup and WiFi apply (folded into _avahi_ok).
        if _avahi_ok:
            maybe_reannounce_mdns(now)

        # Handle manual request to enter AP mode (from the normal WebUI via localhost).
        # This overrides the boot-time auto-AP cutoff.
        if ap_request_event.is_set():
            with state_lock:
                reason = STATE.ap_request_reason
                # Clear stored reason once consumed (optional but keeps it tidy)
                STATE.ap_request_reason = ""
                ap_request_event.clear()
                already_in_ap = STATE.setup_mode
            # If we're not already in AP mode, enter it now.
            if not already_in_ap:
                with state_lock:
                    STATE.manual_ap_active = True
                enter_setup_mode(reason=f"manual_request: {reason or 'UserRequest'}")
                if _sleep_or_finish_monitor_pass(run_once):
                    return
                continue
            else:
                with state_lock:
                    STATE.manual_ap_active = True

        # Revert a temporary runtime log level once its TTL expires (WP7).
        revert_expired_log_level(now)

        # Handle queued local-control actions (start_setup / reconnect_saved /
        # set_log_level).  Disruptive actions own the pass; the non-disruptive
        # set_log_level is applied and the pass continues normally.
        if control_action_event.is_set():
            with state_lock:
                action = STATE.pending_control_action
                params = dict(STATE.pending_control_params)
                STATE.pending_control_action = ""
                STATE.pending_control_params = {}
                control_action_event.clear()
            if action:
                process_control_action(action, params)
                if action != "set_log_level":
                    if _sleep_or_finish_monitor_pass(run_once):
                        return
                    continue

        # Enforce the explicit-reconfiguration 30-minute timeout (Section 11.4).
        with state_lock:
            reconfigure_active = STATE.reconfigure_active
            reconfigure_started = STATE.reconfigure_started_at
        if reconfigure_active and reconfigure_started is not None:
            if (now - reconfigure_started) >= AP_MAX_DURATION:
                handle_reconfigure_timeout()
                if _sleep_or_finish_monitor_pass(run_once):
                    return
                continue

        wifi_cfg = is_wifi_configured()
        wired_connected = is_wired_connected()
        wired_ok = any_wired_path_healthy()

        # --- Multi-adapter discovery and active-client resolution (WP5) ---
        adapters = wifi_net.discover_adapters()
        update_known_adapters(adapters)
        active_client = resolve_active_client(adapters)

        # --- Startup USB-adoption window: re-probe when a new USB adapter
        # appears while BOOT_AP_GRACE is still open (Section 4.3).
        # USB firmware/drivers may finish enumeration after the initial
        # startup_connect_usb_first() call; triggering it again for any new
        # USB MAC prevents a USB-only network from falling to hotspot mode.
        boot_age_now = now - boot_time
        if (boot_age_now < BOOT_AP_GRACE
                and wifi_cfg
                and not wired_ok
                and not STATE.setup_mode):
            usb_macs_now = {a.permanent_mac for a in wifi_net.usb_candidates(adapters)}
            new_usb = usb_macs_now - _startup_window_usb_tried_macs
            if new_usb:
                _startup_window_usb_tried_macs.update(usb_macs_now)
                active_is_usb = active_client is not None and active_client.is_usb
                if not active_is_usb:
                    logger.info(
                        "Startup USB-adoption window: new USB adapter(s) appeared %s;"
                        " retrying USB-first connection", sorted(new_usb),
                    )
                    if startup_connect_usb_first():
                        if _sleep_or_finish_monitor_pass(run_once):
                            return
                        continue

        # --- Active-USB failure fallback (immediate/debounced; never gated by
        # playback). Must run BEFORE _set_active_client() so that
        # STATE.active_client_mac still holds the previously recorded USB MAC
        # when the adapter physically disappears from discovery. ---
        if wifi_cfg and not wired_ok and not STATE.setup_mode:
            if handle_usb_failure_fallback(adapters, active_client):
                if _sleep_or_finish_monitor_pass(run_once):
                    return
                continue

        _set_active_client(active_client)
        # Health is scoped to the *active client* adapter; fall back to the
        # built-in interface name for an unconfigured/idle device.
        health_ifname = active_client.ifname if active_client else AP_IFNAME
        wifi_connected = wifi_net.is_wifi_connected(health_ifname) if wifi_cfg else False

        client_ok = (
            is_wifi_client_healthy(health_ifname, wifi_connected=wifi_connected)
            if wifi_cfg
            else False
        )
        active_path_ok = bool(wired_ok or client_ok)
        conn_ok = active_path_ok

        # --- Optional idle-time USB adoption from a healthy built-in client. ---
        if wifi_cfg and conn_ok and not STATE.setup_mode:
            if handle_runtime_usb_adoption(adapters, wired_ok):
                if _sleep_or_finish_monitor_pass(run_once):
                    return
                continue

        # --- Dead-PHY recovery: detect a wedged-but-present client adapter and
        # run the reset ladder.  This MUST run before the ethernet-wins
        # short-circuit so a dead Wi-Fi PHY is reset (and self-heals) even while
        # ethernet is attached.  USB resets are not gated on ethernet; the reboot
        # rung inside the orchestrator is still gated on being offline. ---
        if wifi_cfg:
            if escalate_dead_adapter_recovery(adapters, wired_ok):
                if _sleep_or_finish_monitor_pass(run_once):
                    return
                continue

        with state_lock:
            STATE.wifistate = "configured" if wifi_cfg else "unconfigured"
            STATE.wiredstate = "connected" if wired_connected else "disconnected"
            STATE.connectivity_ok = conn_ok
            if active_path_ok and not STATE.setup_mode:
                STATE.last_active_path_seen = now
                STATE.conn_reboot_retry_after = 0.0
            log_on_change("wifistate", STATE.wifistate, f"WiFi state changed -> {STATE.wifistate}")
            log_on_change("wiredstate", STATE.wiredstate, f"Wired state changed -> {STATE.wiredstate}")
            log_on_change("gateway_reachable", STATE.connectivity_ok, f"Connectivity changed -> {STATE.connectivity_ok}")

        # Publish the runtime status snapshot served by /network_status.
        publish_network_status(adapters, wired_connected, wired_ok)

        # Ethernet suppresses AP mode entirely (unless the user explicitly requested AP).
        # State is read under the lock; leave_setup_mode is called outside to avoid
        # a deadlock (leave_setup_mode also acquires state_lock, which is not re-entrant).
        with state_lock:
            ethernet_wins = wired_ok and not STATE.manual_ap_active
            in_ap_for_eth = STATE.setup_mode
            if ethernet_wins:
                STATE.conn_down_start = None
                STATE.last_reconnect_attempt = None

        if ethernet_wins:
            if in_ap_for_eth:
                leave_setup_mode("Wired ethernet is up; suppressing AP mode")
            if _sleep_or_finish_monitor_pass(run_once):
                return
            continue

        with state_lock:
            if wired_ok and STATE.manual_ap_active:
                # User explicitly requested AP mode; do not auto-suppress it just because
                # ethernet happens to be usable.
                STATE.conn_down_start = None
                STATE.last_reconnect_attempt = None

        # If we're currently in AP mode, enforce the fixed 30-minute lifetime.
        with state_lock:
            in_setup = STATE.setup_mode
            ap_started = STATE.ap_enter_time

        if in_setup and ap_started is not None:
            ap_age = now - ap_started

            # Section 8.6: in automatic-recovery mode, probe for a returned USB
            # adapter on every monitor pass and attempt USB-first reconnection
            # immediately — do not wait for the 30-minute timeout.
            with state_lock:
                purpose = STATE.setup_purpose
                last_reconnect = STATE.last_reconnect_attempt

            if purpose == "automatic_recovery" and wifi_cfg:
                # Use adapters already discovered at the top of this pass.
                usb_now = wifi_net.usb_candidates(adapters)
                if usb_now:
                    reconnect_due = (
                        last_reconnect is None
                        or (now - last_reconnect) >= RECONNECT_ATTEMPT_INTERVAL
                    )
                    if reconnect_due:
                        with state_lock:
                            STATE.last_reconnect_attempt = now
                        _try_recovery_reconnect(adapters)

            # Unconfigured devices (no WiFi profile) stay in AP indefinitely — they have
            # nowhere else to go.  Only apply the timeout for previously-configured devices
            # that failed to reconnect (recovery AP).  Ethernet suppression above handles
            # the wired-ethernet exit path for unconfigured devices.
            if ap_age >= AP_MAX_DURATION and wifi_cfg:
                # Close AP mode; do not allow re-entry this boot (unless forced).
                with state_lock:
                    STATE.ap_exhausted = True
                    STATE.ap_closed_time = now
                    STATE.manual_ap_active = False
                leave_setup_mode(f"AP mode lifetime expired after {ap_age:.0f}s (configured device)")
            if _sleep_or_finish_monitor_pass(run_once):
                return
            continue

        # Decide whether we should enter AP mode during the boot window.
        # Note: AP mode is only allowed once per boot (ap_exhausted).
        with state_lock:
            ap_exhausted = STATE.ap_exhausted
            forced = STATE.force_setup_mode

        if (not in_setup) and (not ap_exhausted) and (not forced):
            boot_age = now - boot_time
            # Auto-setup mode is only entered if:
            #   - WiFi is not configured, OR WiFi is not connected, OR WiFi is
            #     connected but the client is unhealthy (NM activated but no
            #     usable IPv4/gateway — e.g. DHCP failure or router changed)
            #   - still offline AFTER the boot grace period.
            #   - still offline BEFORE the boot cutoff period.
            # This avoids immediately switching to AP mode before NetworkManager /
            # firmware has had a chance to come up.
            offline = (not wifi_cfg) or (not wifi_connected) or (not client_ok)
            should_enter_ap = (
                boot_age >= BOOT_AP_GRACE
                and boot_age <= BOOT_AP_CUTOFF
                and offline
            )

            if boot_age <= BOOT_AP_CUTOFF:
                logger.debug(
                    "Boot window: age=%.0fs/%.0fs, wifi_cfg=%s, connected=%s, client_ok=%s",
                    boot_age, BOOT_AP_CUTOFF, wifi_cfg, wifi_connected, client_ok,
                )

            if offline and boot_age > BOOT_AP_CUTOFF:
                log_on_change(
                    "boot_ap_window_expired", True,
                    f"Boot AP window expired (boot_age={boot_age:.0f}s); "
                    f"device offline but automatic AP mode will not re-enter this boot cycle",
                    logging.WARNING,
                )

            if should_enter_ap:
                enter_setup_mode(
                    reason=f"boot_age={boot_age:.0f}s, wifi_cfg={wifi_cfg}, wifi_connected={wifi_connected}, client_ok={client_ok}"
                )
                if _sleep_or_finish_monitor_pass(run_once):
                    return
                continue

        # Connection reliability monitoring: WiFi configured, usable ethernet down.
        # Use the same "local IPv4 readiness" health indicator (conn_ok) as used elsewhere.
        if wifi_cfg and not wired_ok:
            with state_lock:
                down_start = STATE.conn_down_start
                last_attempt = STATE.last_reconnect_attempt

            if not conn_ok:
                if down_start is None:
                    with state_lock:
                        STATE.conn_down_start = now
                    down_start = now

                down_for = now - down_start

                # Generic gateway-down 30-minute reboot (WP4): this governs a
                # configured client that is connected but has no usable gateway
                # (e.g. DHCP/router change), NOT a wedged/NO-CARRIER adapter —
                # that case is owned by the dead-PHY ladder above.
                if down_for >= GW_DOWN_REBOOT_AFTER:
                    with state_lock:
                        retry_after = STATE.conn_reboot_retry_after
                    if now >= retry_after:
                        logger.warning(
                            "Connectivity unhealthy for %.0fs (threshold %ss); requesting reboot",
                            down_for, GW_DOWN_REBOOT_AFTER,
                        )
                        accepted = reboot_system("NetworkDown")
                        with state_lock:
                            STATE.conn_reboot_retry_after = (
                                float('inf') if accepted
                                else now + REBOOT_RATE_LIMIT_RETRY
                            )
                    elif retry_after == float('inf'):
                        logger.debug("NetworkDown reboot accepted; waiting for system to reboot")
                    else:
                        logger.debug(
                            "NetworkDown reboot suppressed; will retry in %.0fs",
                            retry_after - now,
                        )

                if down_for >= GW_DOWN_RECONNECT_AFTER:
                    if (last_attempt is None) or (now - last_attempt >= RECONNECT_ATTEMPT_INTERVAL):
                        with state_lock:
                            STATE.last_reconnect_attempt = now
                        logger.info("Connectivity unhealthy for %.0fs; attempting reconnect", down_for)
                        connect_to_configured_wifi()
            else:
                with state_lock:
                    STATE.conn_down_start = None
                    STATE.last_reconnect_attempt = None
                    STATE.conn_reboot_retry_after = 0.0
                    STATE.ap_closed_time = None

        with state_lock:
            in_setup = STATE.setup_mode
            last_active_path_seen = STATE.last_active_path_seen

        if not in_setup and last_active_path_seen is not None:
            no_active_for = now - last_active_path_seen
            if no_active_for >= NO_ACTIVE_PATH_REBOOT_AFTER:
                _request_network_down_reboot(
                    now,
                    "No usable network path for %.0fs (threshold %ss)"
                    % (no_active_for, NO_ACTIVE_PATH_REBOOT_AFTER),
                )

        if _sleep_or_finish_monitor_pass(run_once):
            return

def connect_to_configured_wifi() -> bool:
    """Attempt to bring up the configured WiFi client connection on the built-in.

    Returns True if nmcli was invoked (best-effort), False if there is no configured
    connection to try.  Use startup_connect_usb_first() at boot; this function is
    the built-in fallback path called when USB-first selection is not applicable.
    """
    connection_name = get_configured_wifi_connection_name()
    if not connection_name:
        return False

    # If the configured WiFi is already healthy, do not disturb it.
    if is_wifi_client_healthy():
        logger.debug("Configured WiFi '%s' already healthy; no action needed", connection_name)
        return True

    # NOTE: the former `nmcli device disconnect/connect` bounce was removed —
    # it is ineffective for a wedged USB PHY (NO-CARRIER) and the dead-PHY USB
    # reset ladder supersedes it.  Just (re)activate the configured profile.
    logger.info("Attempting to connect to configured WiFi connection '%s'", connection_name)
    r_up = run_cmd(["nmcli", "connection", "up", connection_name])
    if r_up.returncode != 0:
        logger.warning("nmcli connection up '%s' failed (rc=%d): %s", connection_name, r_up.returncode, r_up.stderr.strip())
    return True


def _resolve_committed_uuid(state: "wifi_net.NetworkState") -> str:
    """Return the UUID for the committed profile, resolving and persisting if absent.

    When network.json was written without a UUID (e.g. migrated from the legacy
    ssid file), this resolves the UUID from NetworkManager at operation time and
    atomically persists it so future calls have it immediately.  Returns "" when
    the profile cannot be uniquely identified, in which case restriction clearing
    must be skipped.
    """
    if state.connection_uuid:
        return state.connection_uuid
    if not state.connection_name:
        return ""
    resolved = wifi_net.resolve_connection_uuid_for_name(state.connection_name)
    if not resolved:
        logger.warning(
            "Cannot resolve UUID for committed profile '%s'; "
            "cross-adapter restriction clearing will be skipped",
            state.connection_name,
        )
        return ""
    try:
        wifi_net.save_network_state(
            wifi_net.NetworkState(
                connection_name=state.connection_name,
                connection_uuid=resolved,
            ),
            state_path=NETWORK_STATE_PATH,
            legacy_path=CONFIGURED_SSID,
        )
        logger.info(
            "Lazily resolved and persisted UUID %s for committed profile '%s'",
            resolved, state.connection_name,
        )
    except Exception as e:
        logger.warning(
            "Could not persist resolved UUID for '%s': %s; will still clear restrictions",
            state.connection_name, e,
        )
    return resolved


def startup_connect_usb_first() -> bool:
    """USB-first startup connection (Section 4.3).

    During the boot window, tries the committed profile on each detected managed
    USB adapter in deterministic order.  If any USB adapter validates, the
    built-in client connection is deactivated and USB becomes the sole Wi-Fi
    client.  Falls back to the built-in adapter when no USB is present or all
    USB attempts fail.

    Returns True if a connection was attempted (best-effort), False if unconfigured.
    """
    state = get_configured_network_state()
    if not state.is_configured:
        return False

    if any_wired_path_healthy():
        logger.info("Startup USB-first: usable wired Ethernet present; skipping USB activation")
        return False

    adapters = wifi_net.discover_adapters()
    builtin = wifi_net.resolve_builtin(adapters)
    usb = wifi_net.usb_candidates(adapters)

    # Resolve UUID (lazily persisting if missing) then clear cross-adapter
    # restrictions before any USB activation attempt so a legacy profile bound
    # to built-in by interface-name/MAC/BSSID/band/channel can be activated on
    # a USB interface.  Only cleared when USB adapters are present; modifying
    # an active profile when no cross-adapter move is needed can cause NM to
    # briefly re-activate, disrupting the existing connection.
    uuid = _resolve_committed_uuid(state)
    if uuid and usb:
        run_cmd(wifi_net.clear_restrictions_cmd(uuid, wifi_net.CROSS_ADAPTER_RESTRICTIONS))

    for candidate in usb:
        logger.info(
            "Startup USB-first: trying committed profile on %s (%s)",
            candidate.ifname, candidate.permanent_mac,
        )
        run_cmd(wifi_net.activate_connection_cmd(
            uuid, state.connection_name, candidate.ifname,
        ))
        if (wait_for_connection(candidate.ifname,
                                timeout=WAIT_FOR_CONNECTION_TIMEOUT,
                                interval=WAIT_FOR_CONNECTION_INTERVAL)
                and is_wifi_client_healthy(candidate.ifname)):
            # Deactivate built-in client connection if still active.
            if builtin and wifi_net.is_wifi_connected(builtin.ifname):
                logger.info("Startup USB-first: disconnecting built-in client on %s", builtin.ifname)
                run_cmd(["nmcli", "device", "disconnect", builtin.ifname])
            logger.info("Startup USB-first: connection established on %s", candidate.ifname)
            return True
        logger.debug("Startup USB-first: attempt on %s failed", candidate.ifname)

    if usb:
        logger.info("Startup USB-first: all USB attempts failed; falling back to built-in")
    else:
        logger.debug("Startup USB-first: no USB adapters found; using built-in")

    return connect_to_configured_wifi()


# ** MULTI-ADAPTER FAILURE, FALLBACK, AND RUNTIME USB ADOPTION (WP5) **
#
# All fallback/adoption *policy* lives here in the watcher.  The helper only
# reports facts (discovery, health, scans) and performs bounded primitives.


def query_playing_status() -> Optional[bool]:
    """Return True/False playback state, or None when uncertain (Section 8.3).

    In Dial mode there is no local player, so playback is always treated as
    idle.  On the main appliance the watcher performs a read-only loopback GET
    to /api/playing-status with a short timeout and accepts state only when the
    response is exactly ok:true with a boolean playing.  Any failure, malformed
    body, or explicit uncertainty returns None (defer, never assume idle).
    """
    if _DIAL_MODE:
        return False
    try:
        with urllib.request.urlopen(PLAYING_STATUS_URL, timeout=PLAYING_STATUS_TIMEOUT) as resp:
            raw = resp.read()
        data = json.loads(raw)
    except Exception:
        _warn_playing_status_unavailable()
        return None
    if not isinstance(data, dict) or data.get("ok") is not True:
        _warn_playing_status_unavailable()
        return None
    playing = data.get("playing")
    if not isinstance(playing, bool):
        _warn_playing_status_unavailable()
        return None
    return playing


def _warn_playing_status_unavailable() -> None:
    """Throttled WARNING when playback status is unavailable during pending adoption."""
    now = time.monotonic()
    with state_lock:
        pending = STATE.pending_usb_adoption_mac is not None
        last = STATE.last_playing_status_warn
        if pending and (now - last) >= PLAYING_STATUS_WARN_THROTTLE:
            STATE.last_playing_status_warn = now
            do_warn = True
        else:
            do_warn = False
    if do_warn:
        logger.warning("Playing status unavailable while USB adoption pending; deferring")


def _activate_committed_on(ifname: str) -> bool:
    """Activate the committed profile on *ifname* and validate health.

    Clears cross-adapter NM restrictions (interface-name, MAC, BSSID, band,
    channel) BEFORE activating so a legacy profile bound to the built-in
    adapter can be moved to a USB interface (or vice-versa).  Returns True
    only when the interface becomes a healthy, non-AP client.
    """
    state = get_configured_network_state()
    if not state.is_configured:
        return False
    uuid = _resolve_committed_uuid(state)
    if uuid:
        run_cmd(wifi_net.clear_restrictions_cmd(uuid, wifi_net.CROSS_ADAPTER_RESTRICTIONS))
    run_cmd(wifi_net.activate_connection_cmd(uuid, state.connection_name, ifname))
    return (wait_for_connection(ifname, timeout=WAIT_FOR_CONNECTION_TIMEOUT,
                                interval=WAIT_FOR_CONNECTION_INTERVAL)
            and is_wifi_client_healthy(ifname))


def verify_avahi_after_handover() -> None:
    """Verify the Avahi hostname and flag an mDNS host-record re-announce.

    Reuses the existing hostname verification path, then marks a re-announce as
    pending rather than restarting avahi-daemon directly.  The monitor loop owns
    the actual re-announce (see maybe_reannounce_mdns): it waits for the published
    address set to settle before restarting, so it re-announces only the surviving
    interface's address (never re-poisoning clients with the address that is being
    torn down mid-handover), and de-duplicates with the passive address-change
    detector so a single restart covers both triggers.
    """
    try:
        check_and_repair_avahi_hostname()
        mark_mdns_reannounce_pending("network handover")
    except Exception as e:
        logger.warning("Avahi handover verification failed: %s", e)


def _set_active_client(adapter) -> None:
    with state_lock:
        if adapter is None and STATE.active_usb_unhealthy_checks > 0:
            # Debounce in progress: clear ifname so the loop knows there is no
            # active client, but keep active_client_mac so that the next pass of
            # handle_usb_failure_fallback can still match the recorded USB adapter.
            STATE.active_client_ifname = ""
            return
        changed = STATE.active_client_ifname != (adapter.ifname if adapter else "")
        STATE.active_client_ifname = adapter.ifname if adapter else ""
        STATE.active_client_mac = adapter.permanent_mac if adapter else ""
    if changed and adapter:
        logger.info("Active client adapter changed -> %s (%s)", adapter.ifname, adapter.kind)


def resolve_active_client(adapters: list) -> Optional[object]:
    """Return the adapter currently carrying a non-AP Wi-Fi client connection."""
    for a in adapters:
        if wifi_net.is_wifi_connected(a.ifname):
            return a
    return None


def handle_usb_failure_fallback(adapters: list, active_client) -> bool:
    """Debounced active-USB failure handling (Sections 8.4/8.5).

    Returns True when a transition (built-in fallback or recovery hotspot) was
    performed on this pass; the caller then skips its ordinary reconnect/reboot
    logic for this pass to avoid racing.  This path is never gated by playback.
    """
    with state_lock:
        recorded_mac = STATE.active_client_mac

    active_is_usb = bool(active_client and active_client.is_usb)
    recorded_usb_present = bool(recorded_mac) and any(
        a.is_usb and a.permanent_mac == recorded_mac for a in adapters
    )

    # Case 1: the recorded active USB device is physically absent.
    # Trigger immediate built-in fallback on this single pass.
    if recorded_mac and _recorded_usb(recorded_mac) and not recorded_usb_present:
        logger.info("Active USB adapter (%s) absent; attempting built-in fallback", recorded_mac)
        return _do_builtin_fallback_or_recovery(adapters, reason="active-USB-absent")

    # Case 2 (debounced): the recorded USB adapter is present in the discovered
    # adapter list but NetworkManager has disconnected it (no longer the active
    # client).  Treat identically to a present-but-unhealthy active USB client.
    recorded_usb_disconnected = (
        bool(recorded_mac)
        and _recorded_usb(recorded_mac)
        and recorded_usb_present
        and not active_is_usb
    )

    # No USB involvement at all; reset counter and exit.
    if not active_is_usb and not recorded_usb_disconnected:
        with state_lock:
            STATE.active_usb_unhealthy_checks = 0
        return False

    # Active USB client is healthy; reset counter and exit.
    if active_is_usb and is_wifi_client_healthy(active_client.ifname):
        with state_lock:
            STATE.active_usb_unhealthy_checks = 0
        return False

    # Case 2: USB present but unhealthy or NM-disconnected → two consecutive passes.
    with state_lock:
        STATE.active_usb_unhealthy_checks += 1
        count = STATE.active_usb_unhealthy_checks
    reason_tag = "active-USB-disconnected" if recorded_usb_disconnected else "active-USB-unhealthy"
    logger.debug("%s check %d/%d", reason_tag, count, USB_UNHEALTHY_DEBOUNCE)
    if count >= USB_UNHEALTHY_DEBOUNCE:
        logger.info("USB adapter %s for %d passes; attempting fallback", reason_tag, count)
        with state_lock:
            STATE.active_usb_unhealthy_checks = 0
        return _do_builtin_fallback_or_recovery(adapters, reason=reason_tag)
    return False


# Remember which permanent MACs were last seen as USB, so that an absent active
# adapter can still be classified as USB after it disappears from discovery.
_known_usb_macs: set[str] = set()

# Track USB MACs already attempted during the startup adoption window so that
# startup_connect_usb_first() is triggered at most once per new USB device
# appearing within BOOT_AP_GRACE.
_startup_window_usb_tried_macs: set[str] = set()


def _recorded_usb(mac: str) -> bool:
    return mac in _known_usb_macs


def _do_builtin_fallback_or_recovery(adapters: list, reason: str) -> bool:
    """Attempt built-in LAN fallback; enter recovery hotspot if it fails."""
    builtin = wifi_net.resolve_builtin(adapters)
    if builtin is not None and _activate_committed_on(builtin.ifname):
        with state_lock:
            STATE.using_builtin_fallback = True
            STATE.conn_down_start = None
            STATE.last_reconnect_attempt = None
        _set_active_client(builtin)
        logger.info("Built-in LAN fallback connected (%s)", reason)
        verify_avahi_after_handover()
        return True

    logger.warning("Built-in LAN fallback failed (%s); entering recovery hotspot", reason)
    with state_lock:
        STATE.setup_purpose = "automatic_recovery"
    enter_setup_mode(reason=f"automatic_recovery: {reason}")
    return True


def _try_recovery_reconnect(adapters: list) -> None:
    """USB-first reconnect attempt during automatic-recovery hotspot (Section 8.6).

    Tries the committed profile on USB adapters first, then built-in.  On
    success, calls leave_setup_mode() so nginx returns to the application
    backend without waiting for the 30-minute timeout.  On failure, retains
    the hotspot; the caller schedules the next retry via RECONNECT_ATTEMPT_INTERVAL.
    """
    state = get_configured_network_state()
    if not state.is_configured:
        return
    # Only probe USB adapters while the recovery hotspot is running on the
    # built-in radio.  Activating a client on the built-in while it hosts the
    # AP would displace the hotspot; that path is handled by the 30-minute
    # timeout rollback in handle_reconfigure_timeout/leave_setup_mode.
    candidates = wifi_net.usb_candidates(adapters)
    if not candidates:
        logger.debug("Auto-recovery: no USB candidates; hotspot retained")
        return

    # Resolve UUID (lazily persisting if missing) and clear cross-adapter
    # restrictions once before probing USB candidates.
    recovery_uuid = _resolve_committed_uuid(state)
    if recovery_uuid:
        run_cmd(wifi_net.clear_restrictions_cmd(recovery_uuid, wifi_net.CROSS_ADAPTER_RESTRICTIONS))

    for candidate in candidates:
        logger.info("Auto-recovery: probing USB %s", candidate.ifname)
        run_cmd(wifi_net.activate_connection_cmd(
            recovery_uuid, state.connection_name, candidate.ifname,
        ))
        if (wait_for_connection(candidate.ifname,
                                timeout=WAIT_FOR_CONNECTION_TIMEOUT,
                                interval=WAIT_FOR_CONNECTION_INTERVAL)
                and is_wifi_client_healthy(candidate.ifname)):
            _set_active_client(candidate)
            leave_setup_mode("automatic_recovery: adapter returned and reconnected")
            verify_avahi_after_handover()
            logger.info("Auto-recovery resolved on %s", candidate.ifname)
            return
    logger.debug("Auto-recovery probe failed; retaining hotspot")


def handle_runtime_usb_adoption(adapters: list, wired_connected: bool) -> bool:
    """Optional idle-time adoption of a newly available USB adapter (Section 8.2).

    Adopts USB only when: Ethernet is not active; built-in carries a healthy
    Wi-Fi client (or built-in fallback is active); no USB is already the active
    client; the same deterministic USB candidate has been present for two passes;
    and (main appliance) playback is confirmed idle.  Returns True if a handover
    was performed.
    """
    now = time.monotonic()
    with state_lock:
        retry_after = STATE.usb_adoption_retry_after
        in_setup = STATE.setup_mode
    if in_setup or wired_connected:
        _clear_pending_adoption()
        return False
    if retry_after and now < retry_after:
        return False

    usb = wifi_net.usb_candidates(adapters)
    if not usb:
        _clear_pending_adoption()
        return False
    candidate = usb[0]

    active_client = resolve_active_client(adapters)
    # Do not switch from a healthy USB client to another USB adapter.
    if active_client is not None and active_client.is_usb:
        _clear_pending_adoption()
        return False
    # Built-in must currently carry a healthy client (direct or fallback).
    builtin = wifi_net.resolve_builtin(adapters)
    if builtin is None or not is_wifi_client_healthy(builtin.ifname):
        _clear_pending_adoption()
        return False

    # Two-pass stability on the same deterministic candidate.
    with state_lock:
        if STATE.pending_usb_adoption_mac == candidate.permanent_mac:
            STATE.pending_usb_adoption_checks += 1
        else:
            STATE.pending_usb_adoption_mac = candidate.permanent_mac
            STATE.pending_usb_adoption_checks = 1
        checks = STATE.pending_usb_adoption_checks
    if checks < USB_ADOPTION_STABLE_PASSES:
        return False

    # Playback gating (main appliance only).
    playing = query_playing_status()
    if playing is None:
        logger.debug("USB adoption deferred: playback status uncertain")
        return False
    if playing:
        log_on_change("usb_adopt_deferred_playing", True,
                      "USB adoption deferred because playback is active")
        return False

    # Transactional handover: validate USB before deactivating built-in.
    logger.info("Runtime USB adoption starting on %s", candidate.ifname)
    if _activate_committed_on(candidate.ifname):
        # Deactivate the previous built-in client connection.
        run_cmd(["nmcli", "device", "disconnect", builtin.ifname])
        with state_lock:
            STATE.using_builtin_fallback = False
        _set_active_client(candidate)
        _clear_pending_adoption()
        logger.info("Runtime USB adoption succeeded on %s", candidate.ifname)
        verify_avahi_after_handover()
        return True

    logger.warning("Runtime USB adoption failed on %s; retaining built-in", candidate.ifname)
    with state_lock:
        STATE.usb_adoption_retry_after = now + RECONNECT_ATTEMPT_INTERVAL
    _clear_pending_adoption()
    return False


def _clear_pending_adoption() -> None:
    with state_lock:
        STATE.pending_usb_adoption_mac = None
        STATE.pending_usb_adoption_checks = 0


def update_known_adapters(adapters: list) -> None:
    """Track USB MACs and log adapter-set changes at INFO on transition."""
    macs = frozenset(a.permanent_mac for a in adapters if a.permanent_mac)
    for a in adapters:
        if a.is_usb and a.permanent_mac:
            _known_usb_macs.add(a.permanent_mac)
    with state_lock:
        prev = STATE.last_detected_adapter_macs
        STATE.last_detected_adapter_macs = macs
    if prev is not None and prev != macs:
        logger.info("Detected Wi-Fi adapter set changed: %s", sorted(macs))


