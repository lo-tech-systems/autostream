def enter_setup_mode(reason: str = "") -> None:
    """Transition into SetupMode and start AP mode, if permitted.

    For configured devices: AP mode runs for up to AP_MAX_DURATION (30 min).  Once
    that window closes, AP will not be re-entered automatically until the device is
    power-cycled (ap_exhausted latch).  force_setup_mode bypasses this to allow
    re-entry after a failed WiFi configuration attempt.

    For unconfigured devices: AP mode runs indefinitely (no timeout applied by the
    monitor loop) until the user successfully configures a network or wired ethernet
    appears.
    """
    with state_lock:
        if STATE.setup_mode:
            return
        if STATE.ap_exhausted and not STATE.force_setup_mode:
            # AP mode has been used up for this boot cycle (configured-device path).
            # force_setup_mode is set by apply_wifi_async on a failed config attempt
            # to allow re-entry despite the latch.
            log_on_change(
                "enter_setup_blocked", True,
                "AP mode requested but ap_exhausted latch is set; ignoring until reboot",
                logging.WARNING,
            )
            return
        STATE.setup_mode = True
        STATE.ap_enter_time = time.monotonic()

    logger.info("Entering SetupMode. Reason: %s", reason)
    start_ap_mode()
    update_apmode_flag(True)

def leave_setup_mode(reason: str = "") -> None:
    """Transition out of SetupMode and stop AP mode, if currently active."""
    with state_lock:
        if not STATE.setup_mode:
            return
        STATE.setup_mode = False
        STATE.ap_enter_time = None
        STATE.ap_closed_time = time.monotonic()
        STATE.force_setup_mode = False
        STATE.manual_ap_active = False

    logger.info("Leaving SetupMode. Reason: %s", reason)
    # Tear down the AP before removing the flag so nginx does not route traffic
    # to the main webui while the setup SSID is still broadcasting.
    stop_ap_mode()
    update_apmode_flag(False)

