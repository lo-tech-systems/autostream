def resolve_recovery_ifname() -> Optional[str]:
    """Return the resolved built-in (recovery) interface name, or None.

    The recovery hotspot must always use the built-in radio; a USB adapter must
    never become the only recovery path.  Returns None when no built-in adapter
    can be identified (the caller logs an error and does not host an AP on USB).
    """
    try:
        adapters = wifi_net.discover_adapters()
    except Exception as e:
        logger.warning("Adapter discovery failed while resolving recovery interface: %s", e)
        adapters = []
    builtin = wifi_net.resolve_builtin(adapters)
    if builtin is not None:
        return builtin.ifname
    logger.warning("No built-in Wi-Fi adapter identified for recovery hotspot")
    return None

