def _commit_network_state(conn_name: str, conn_uuid: str = "") -> None:
    """Persist a successfully validated connection to both state files.

    Writes /etc/autostream-network.json (authoritative) plus the legacy
    /opt/autostream/ssid mirror.  Resolves the NetworkManager UUID when not
    supplied so future activation/deletion can prefer ``uuid <...>``.
    """
    if not conn_uuid:
        try:
            conn_uuid = wifi_net.resolve_connection_uuid_for_name(conn_name)
        except Exception:
            conn_uuid = ""
    try:
        wifi_net.save_network_state(
            wifi_net.NetworkState(connection_name=conn_name, connection_uuid=conn_uuid),
            state_path=NETWORK_STATE_PATH,
            legacy_path=CONFIGURED_SSID,
        )
        logger.info(
            "Committed network state for connection '%s' (uuid=%s)",
            conn_name, conn_uuid or "unresolved",
        )
    except Exception as e:
        logger.error("Could not persist network state for '%s': %s", conn_name, e)


def _try_candidate_on_adapter(ssid: str, password: str, target) -> bool:
    """Create, activate and validate a candidate profile on one adapter.

    Implements the rollback-safe candidate sequence (Section 6.5). The PSK never
    appears in logs. On success the new connection is committed (name+UUID) and
    the legacy mirror is updated; on failure only the candidate profile is
    deleted by UUID, leaving the previous committed profile untouched.
    """
    ifname = target.ifname
    con_name = wifi_net.generate_candidate_name()

    # 1-2) create + configure the uniquely named candidate.
    cmds, log_cmds = wifi_net.configure_candidate_cmds(con_name, ifname, ssid, password)
    for cmd, log_cmd in zip(cmds, log_cmds):
        r = run_cmd(cmd, log_cmd=log_cmd)
        if r.returncode != 0:
            logger.warning("Candidate profile setup step failed on %s", ifname)
            # Best-effort cleanup of a partially created profile by name.
            run_cmd(["nmcli", "connection", "delete", con_name])
            return False

    # 3) obtain its UUID.
    uuid = wifi_net.get_profile_uuid(con_name)
    if not uuid:
        logger.warning("Could not resolve candidate UUID for '%s'", con_name)
        run_cmd(["nmcli", "connection", "delete", con_name])
        return False

    # 4) clear cross-adapter restrictions EXCEPT connection.interface-name,
    #    which may remain set until the first activation succeeds.
    pre_keys = tuple(
        k for k in wifi_net.CROSS_ADAPTER_RESTRICTIONS
        if k != "connection.interface-name"
    )
    run_cmd(wifi_net.clear_restrictions_cmd(uuid, pre_keys))

    # 5) activate explicitly on the target interface.
    r_up = run_cmd(wifi_net.activate_connection_cmd(uuid, con_name, ifname))
    if r_up.returncode != 0:
        logger.warning("Candidate activation failed on %s (rc=%d)", ifname, r_up.returncode)

    # 6) validate local IPv4 + interface-specific gateway.
    ip_ok = wait_for_connection(
        ifname,
        timeout=WAIT_FOR_CONNECTION_TIMEOUT,
        interval=WAIT_FOR_CONNECTION_INTERVAL,
    )
    logger.info("Candidate %s: ip_ready=%s", ifname, ip_ok)
    gw_ok = ip_ok and is_wifi_client_healthy(ifname)
    logger.info("Candidate %s: gw_healthy=%s", ifname, gw_ok)
    ok = gw_ok

    if not ok:
        # 9) on failure delete only the candidate; keep the previous committed profile.
        logger.warning("Candidate validation failed on %s; deleting candidate", ifname)
        run_cmd(wifi_net.delete_connection_cmd(uuid))
        return False

    # 7) clear connection.interface-name so the committed profile is portable.
    run_cmd(wifi_net.clear_restrictions_cmd(uuid, ("connection.interface-name",)))

    # 8) commit name/UUID + legacy mirror.
    _commit_network_state(con_name, uuid)
    logger.info("WiFi candidate committed on %s (ssid='%s')", ifname, ssid)
    return True


def attempt_on_targets(targets: list, attempt_fn) -> bool:
    """Try client activation on target adapters with per-target AP handling."""
    hotspot_adapter = resolve_hotspot_adapter(wifi_net.discover_adapters())
    for target in targets:
        with state_lock:
            in_setup_now = STATE.setup_mode
        is_hotspot_target = hotspot_adapter is not None and target.ifname == hotspot_adapter.ifname
        ap_stopped_for_hotspot = False
        if in_setup_now and is_hotspot_target:
            stop_ap_mode()
            ap_stopped_for_hotspot = True

        if attempt_fn(target):
            _set_active_client(target)
            leave_setup_mode("WiFi client connection succeeded")
            verify_avahi_after_handover()
            return True

        if ap_stopped_for_hotspot:
            logger.warning(
                "Client attempt on hotspot adapter (%s) failed after AP teardown; recreating hotspot",
                target.ifname,
            )
            # The hotspot session is intact (stop_ap_mode tore down only the
            # nmcli AP, not STATE.hotspot); just restart the radio side.
            with state_lock:
                STATE.setup_mode = True
            start_ap_mode()
            update_apmode_flag(True)

    return False


def configure_wifi_with_nmcli(ssid: str, password: str) -> bool:
    """Apply submitted credentials using the rollback-safe candidate sequence.

    Does NOT use ``nmcli device wifi connect`` (which would reuse/modify an
    existing profile and undermine rollback). A uniquely named candidate profile
    is created, validated, and only committed on success (Section 6.5).

    Adapter order follows Section 6.4: USB adapters that saw the SSID first, then
    built-in, then best-effort. If a USB attempt fails and built-in saw the SSID,
    built-in is attempted once before giving up.
    """
    merged, builtin_scan_known = scan_all_networks()
    adapters = wifi_net.discover_adapters()
    order = wifi_net.connection_target_order(ssid, adapters, merged, builtin_scan_known)
    if not order:
        logger.warning("No usable Wi-Fi adapter to apply credentials for '%s'", ssid)
        return False

    return attempt_on_targets(
        order,
        lambda target: _try_candidate_on_adapter(ssid, password, target),
    )


def wait_for_connection(ifname: str = AP_IFNAME, timeout: int = 20, interval: int = 2) -> bool:
    """Wait up to 'timeout' seconds for *local* IPv4 readiness on *ifname*.

    Success means NetworkManager reports the interface connected/activated with
    a non-link-local RFC1918 IPv4 address. (The ongoing health monitor uses the
    gateway heuristic separately.)
    """
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if is_local_ipv4_ready(ifname):
            return True
        time.sleep(interval)
    logger.info("Timed out waiting %ds for local IPv4 on %s", timeout, ifname)
    return False


def _write_dnsmasq_runtime(recovery_ifname: str) -> bool:
    """Validate the recovery interface and write the runtime dnsmasq config.

    Returns True on success.  Logs WARNING and returns False on any failure so
    the caller can abort dnsmasq startup rather than starting it with a stale
    or wrong config.
    """
    # Validate against discovered adapters: must match the resolved hotspot adapter.
    resolved = resolve_recovery_ifname()
    if resolved is not None and recovery_ifname != resolved:
        logger.warning(
            "Refusing dnsmasq runtime config: %s is not the resolved hotspot adapter (%s)",
            recovery_ifname, resolved,
        )
        return False
    try:
        wifi_net.write_dnsmasq_runtime_config(
            DNSMASQ_TEMPLATE_PATH, DNSMASQ_RUNTIME_PATH, recovery_ifname,
        )
        logger.info("Wrote dnsmasq runtime config for interface %s", recovery_ifname)
        return True
    except Exception as e:
        logger.warning("dnsmasq runtime setup failed: %s", e)
        return False


def start_ap_mode() -> None:
    """Put the WiFi adapter into open AP (hotspot) mode using nmcli.

    The SSID is autostream_XXXX where XXXX are the last four hex digits of the
    adapter's MAC address. The hotspot is open (no password). The Flask app
    acts as the captive portal HTTP server; DNS/DHCP redirection is assumed to
    be handled elsewhere.
    """
    with ap_mode_lock:
        # Guard against a race where leave_setup_mode ran (from apply_wifi_async or the
        # ethernet-suppression path) between enter_setup_mode setting setup_mode=True and
        # this function acquiring ap_mode_lock.  In that case stop_ap_mode has already
        # run and setup_mode is False; starting AP now would leave it running unmanaged.
        with state_lock:
            if not STATE.setup_mode:
                logger.warning("start_ap_mode: setup_mode cleared before AP could start; aborting")
                return

        logger.info("Enabling AP mode for SetupMode")

        # Use the built-in radio when available; fall back to the sole managed
        # USB adapter on hardware without a built-in radio (e.g. Pi 2).  If
        # neither can be identified unambiguously, abort rather than selecting
        # an arbitrary interface.
        recovery_ifname = resolve_recovery_ifname()
        if recovery_ifname is None:
            logger.error(
                "Cannot start hotspot: no suitable Wi-Fi adapter identified "
                "(no built-in radio, no unambiguous USB adapter); aborting AP mode"
            )
            with state_lock:
                STATE.setup_mode = False
                STATE.hotspot = None
            return

        ssid = get_ap_ssid(recovery_ifname)

        # Delete any existing connection with the same name (also takes it down).
        run_cmd(["nmcli", "connection", "delete", AP_CONNECTION_NAME])

        # Create the connection on the hotspot interface.
        logger.info(
            "Creating AP connection '%s' with SSID '%s' on %s",
            AP_CONNECTION_NAME, ssid, recovery_ifname,
        )
        run_cmd([
            "nmcli", "connection", "add",
            "type", "wifi",
            "ifname", recovery_ifname,
            "con-name", AP_CONNECTION_NAME,
            "autoconnect", "no",
            "ssid", ssid,
            "802-11-wireless.mode", "ap",
            "ipv4.method", "manual",
            "ipv4.addresses", "192.168.4.1/24",
            "ipv4.never-default", "yes",
            "ipv6.method", "ignore",
        ])

        # Generate the runtime dnsmasq config bound to the validated recovery
        # interface, then start the dedicated dnsmasq service that reads it.
        # Only start dnsmasq when the runtime config was written successfully;
        # starting it against a stale or missing config would serve wrong data.
        dnsmasq_ready = _write_dnsmasq_runtime(recovery_ifname)

        # Bring up the AP connection
        run_cmd(["nmcli", "connection", "up", AP_CONNECTION_NAME, "ifname", recovery_ifname])
        if dnsmasq_ready:
            run_cmd(["systemctl", "start", DNSMASQ_SERVICE])
        else:
            logger.warning("dnsmasq not started because runtime config write failed")

        # Hostname may change at runtime; construct the portal URL dynamically.
        current_host = get_system_hostname()
        logger.info("Setup portal expected at http://%s.local/setup while in AP mode", current_host)


def stop_ap_mode() -> None:
    """Tear down AP mode.

    This is primarily used when leaving SetupMode via the monitor loop.
    """
    with ap_mode_lock:
        logger.info("Disabling AP mode after leaving SetupMode")
        # Stop the dedicated dnsmasq service before removing its runtime config
        # so the service never observes a half-deleted file.
        run_cmd(["systemctl", "stop", DNSMASQ_SERVICE])
        wifi_net.remove_dnsmasq_runtime_config(DNSMASQ_RUNTIME_PATH)
        run_cmd(["nmcli", "connection", "delete", AP_CONNECTION_NAME])


def scan_wifi_networks(ifname: str = AP_IFNAME):
    """Scan one interface and return ``[{"ssid", "signal"}]`` (legacy shape).

    Retained for backward compatibility; the captive portal uses the combined
    multi-adapter scan below.
    """
    cmd = ["nmcli", "-t", "-f", "SSID,SIGNAL", "device", "wifi", "list", "ifname", ifname]
    result = run_cmd(cmd)
    if result.returncode != 0:
        logger.warning("Error scanning WiFi networks: %s", result.stderr.strip())
        return []
    strongest = wifi_net.parse_scan_output(result.stdout)
    return sorted(
        ({"ssid": s, "signal": sig} for s, sig in strongest.items()),
        key=lambda n: n["signal"], reverse=True,
    )


def scan_all_networks() -> tuple[list[dict], bool]:
    """Live-scan every detected, managed Wi-Fi adapter and merge by exact SSID.

    Returns ``(networks, builtin_scan_known)`` where each network record carries
    ssid/signal/builtin_visible/usb_visible/adapter_macs (Section 6.1).  No
    caching is performed; an individual adapter scan failure marks that
    adapter's visibility unknown for this response only.
    """
    adapters = wifi_net.discover_adapters()
    builtin = wifi_net.resolve_builtin(adapters)
    usb = wifi_net.usb_candidates(adapters)

    builtin_scan = wifi_net.scan_adapter(builtin) if builtin is not None else None
    builtin_scan_known = builtin_scan is not None

    usb_scans = [wifi_net.scan_adapter(a) for a in usb]
    merged = wifi_net.merge_scans(
        builtin_scan,
        usb_scans,
        builtin_mac=(builtin.permanent_mac if builtin else ""),
        usb_macs=[a.permanent_mac for a in usb],
    )
    return merged, builtin_scan_known


def apply_wifi_async(ssid: str, pw: str) -> None:
    try:
        with state_lock:
            STATE.last_apply_result = "applying"
            STATE.last_apply_error = ""
        logger.info("Async apply starting for SSID '%s'", ssid)

        time.sleep(0.5)

        # The candidate transaction already validates local IPv4 and the
        # interface-specific gateway on the chosen adapter before committing,
        # so a True result means connectivity has been verified.
        success = configure_wifi_with_nmcli(ssid, pw)
        if success:
            with state_lock:
                STATE.last_apply_result = "ok"
                STATE.last_apply_error = ""
            # A successful new connection ends the hotspot session entirely
            # (leave_setup_mode in attempt_on_targets clears STATE.hotspot).
            logger.info("WiFi configuration and connectivity verified")
        else:
            with state_lock:
                STATE.last_apply_result = "failed"
                STATE.last_apply_error = "nmcli-failed"
                # Re-enter with whatever purpose the interrupted session held
                # (configure_wifi_with_nmcli keeps setup_mode set on failure, so
                # this re-entry is normally a no-op); fall back to FIRST_RUN.
                purpose = STATE.hotspot.purpose if STATE.hotspot else HotspotPurpose.FIRST_RUN
            logger.warning("WiFi configuration failed; returning to SetupMode")
            enter_setup_mode(purpose, reason="nmcli failed to configure WiFi")
    finally:
        with state_lock:
            STATE.apply_in_progress = False

# ** TRANSACTIONAL CHANGE-WI-FI FLOW (WP6) **

def _snapshot_rollback() -> "RollbackSnapshot":
    """Return the current committed profile + active adapter as a rollback target."""
    state = get_configured_network_state()
    with state_lock:
        active_mac = STATE.active_client_mac
    return RollbackSnapshot(
        connection_name=state.connection_name,
        connection_uuid=state.connection_uuid,
        adapter_mac=active_mac,
    )


def apply_log_level(level: str, ttl_seconds: Optional[int]) -> None:
    """Apply a runtime log level, optionally temporary for *ttl_seconds*.

    Without a TTL the level becomes the runtime level until the service
    restarts or another valid request changes it; the startup default
    (AUTOSTREAM_WIFI_LOG_LEVEL) is preserved for revert.
    """
    levelno = RUNTIME_LOG_LEVELS[level]
    logging.getLogger().setLevel(levelno)
    now = time.monotonic()
    with state_lock:
        if ttl_seconds:
            STATE.temporary_log_level = level
            STATE.temporary_log_level_until = now + ttl_seconds
        else:
            STATE.temporary_log_level = ""
            STATE.temporary_log_level_until = None
            STATE.default_log_level_name = level
    if ttl_seconds:
        logger.info("Runtime log level changed to %s for %ds", level, ttl_seconds)
    else:
        logger.info("Runtime log level changed to %s", level)


def revert_expired_log_level(now: Optional[float] = None) -> None:
    """Revert a temporary runtime log level once its TTL expires (WP7)."""
    if now is None:
        now = time.monotonic()
    with state_lock:
        until = STATE.temporary_log_level_until
        if until is None or now < until:
            return
        default = STATE.default_log_level_name or "info"
        STATE.temporary_log_level = ""
        STATE.temporary_log_level_until = None
    logging.getLogger().setLevel(RUNTIME_LOG_LEVELS.get(default, logging.INFO))
    logger.info("Runtime log level reverted to %s", default)


def process_control_action(action: str, params: Optional[dict] = None) -> None:
    """Consume one queued control action in the monitor loop (Section 10.1)."""
    params = params or {}
    with state_lock:
        STATE.control_in_progress = True
        STATE.last_control_action = action
        STATE.last_control_error = ""
    try:
        if action == "start_setup":
            start_explicit_setup()
            result = "ok"
        elif action == "reconnect_saved":
            result = "ok" if reconnect_saved_network() else "failed"
        elif action == "set_log_level":
            apply_log_level(params.get("level"), params.get("ttl_seconds"))
            result = "ok"
        else:
            result = "failed"
    except Exception as e:
        logger.warning("Control action '%s' raised: %s", action, e)
        result = "failed"
        with state_lock:
            STATE.last_control_error = str(e)
    with state_lock:
        STATE.control_in_progress = False
        STATE.last_control_result = result


def start_explicit_setup() -> None:
    """Begin an explicit Change-Wi-Fi reconfiguration session (Section 11.1).

    Snapshots the current profile/adapter, disconnects the current client
    session (without deleting its profile), and enters an EXPLICIT_RECONFIGURE
    hotspot.  The 30-minute deadline, no-eth-suppression, and rollback policy all
    come from PURPOSE_TABLE[EXPLICIT_RECONFIGURE] (Section 2.3).
    """
    rollback = _snapshot_rollback()
    # Disconnect the current client session without deleting its profile.
    with state_lock:
        active_ifname = STATE.active_client_ifname
    if active_ifname:
        run_cmd(["nmcli", "device", "disconnect", active_ifname])
    logger.info("Explicit network setup starting (explicit_reconfigure)")
    enter_setup_mode(HotspotPurpose.EXPLICIT_RECONFIGURE,
                     reason="explicit_reconfigure", rollback=rollback)


def reconnect_saved_network() -> bool:
    """Reconnect to the saved/rollback network and exit hotspot mode on success.

    During explicit reconfiguration the snapshotted rollback profile is restored
    on its previous adapter first; otherwise USB-first deterministic order then
    built-in is used.  On success leave_setup_mode() is called and session state
    cleared; on failure the hotspot is retained.
    """
    with state_lock:
        session = STATE.hotspot
    purpose = session.purpose if session else None
    rollback = session.rollback if session else None
    rb_name = rollback.connection_name if rollback else ""
    rb_uuid = rollback.connection_uuid if rollback else ""
    rb_mac = rollback.adapter_mac if rollback else ""
    adapters = wifi_net.discover_adapters()

    targets: list = []
    if purpose == HotspotPurpose.EXPLICIT_RECONFIGURE and rb_name:
        prev = wifi_net.find_adapter_by_mac(adapters, rb_mac)
        if prev is not None:
            targets.append(prev)
        # Then fall back to USB-first, then built-in.
        for a in wifi_net.client_candidate_order(adapters):
            if a not in targets:
                targets.append(a)
        committed = wifi_net.NetworkState(connection_name=rb_name, connection_uuid=rb_uuid)
    else:
        targets = wifi_net.client_candidate_order(adapters)
        committed = get_configured_network_state()

    if not committed.is_configured:
        return False

    # Resolve UUID (lazily persisting if missing) and clear cross-adapter
    # restrictions once, before iterating over target adapters, so a legacy
    # profile bound to a specific interface/MAC can be activated on any adapter.
    committed_uuid = _resolve_committed_uuid(committed)
    if committed_uuid:
        run_cmd(wifi_net.clear_restrictions_cmd(committed_uuid, wifi_net.CROSS_ADAPTER_RESTRICTIONS))

    def _attempt(target) -> bool:
        run_cmd(wifi_net.activate_connection_cmd(
            committed_uuid, committed.connection_name, target.ifname))
        if wait_for_connection(target.ifname, timeout=WAIT_FOR_CONNECTION_TIMEOUT,
                               interval=WAIT_FOR_CONNECTION_INTERVAL) \
                and is_wifi_client_healthy(target.ifname):
            logger.info("Reconnected to saved network on %s", target.ifname)
            return True
        return False

    if attempt_on_targets(targets, _attempt):
        return True

    logger.warning("Reconnect to saved network failed; retaining hotspot")
    return False


def handle_reconfigure_timeout() -> None:
    """30-minute explicit-reconfiguration timeout rollback (Section 11.4)."""
    logger.info("Explicit network setup timed out after %ds; restoring previous", AP_MAX_DURATION)
    if reconnect_saved_network():
        return
    # Restoration failed: retain the hotspot but convert it to an automatic
    # USB-loss recovery session (probes for return, eth-suppressible, no rollback).
    with state_lock:
        if STATE.hotspot is not None:
            STATE.hotspot.purpose = HotspotPurpose.USB_LOSS_RECOVERY
            STATE.hotspot.rollback = None
    logger.warning("Timeout restore failed; remaining in recovery hotspot")



# ** MAIN NETWORK STATUS MONITORING LOOP **


@dataclass(frozen=True)
class Facts:
    """One immutable per-tick snapshot of network facts (Section 2.5).

    Gathered once at the top of each monitor pass via gather_facts() so every
    in-pass decision reads the same view of the world (no within-tick
    inconsistency) and the dominant subprocess cost on the Pi Zero (discovery,
    wired probes, address enumeration) is paid once per pass rather than per
    decision site.  Playback is intentionally NOT a field here: it is resolved
    lazily via a per-pass memoised callable (see _make_playing_status_memo)
    because it is comparatively expensive and not always needed.
    """
    wifi_configured: bool
    adapters: list
    wired_connected: bool
    wired_ok: bool
    active_client: Optional[object]
    addresses: dict
    taken_at: float


def gather_facts() -> "Facts":
    """Gather the single immutable Facts snapshot for one monitor pass.

    The sole caller of discover_adapters/is_wired_connected/any_wired_path_healthy/
    resolve_active_client/list_interface_addresses for the pass.  Downstream
    decisions read the returned Facts rather than re-querying these helpers.
    """
    adapters = wifi_net.discover_adapters()
    return Facts(
        wifi_configured=is_wifi_configured(),
        adapters=adapters,
        wired_connected=is_wired_connected(),
        wired_ok=any_wired_path_healthy(),
        active_client=resolve_active_client(adapters),
        addresses=wifi_net.list_interface_addresses(),
        taken_at=time.monotonic(),
    )


def next_mode(state, facts) -> "Mode":
    """The permanent pure forward mode classifier: state + facts -> Mode (constraint 10).

    Pure: reads *state* fields and *facts* (needs only ``facts.wired_ok`` and
    ``facts.taken_at``) plus module constants; it does not mutate STATE, call
    subprocesses, run effects, or depend on the ``w`` seam — so it can lift into a
    pure ``platform/wifi_policy.py`` unchanged.  The loop *applies* the returned
    value by setting ``STATE.mode`` each pass, and it is published as
    ``device.mode``.  Together with PURPOSE_TABLE it is the explicit-model
    decision core the refactor settles on.

    Precedence mirrors the live loop: hotspot wins, then an accepted reboot, then
    a usable path means ONLINE, then the boot grace window means BOOT, otherwise
    the configured-but-offline device is OFFLINE_RECONNECTING.
    """
    if state.setup_mode:
        return Mode.HOTSPOT
    if state.conn_reboot_retry_after == float("inf"):
        return Mode.REBOOT_PENDING
    if bool(facts.wired_ok) or bool(state.connectivity_ok):
        return Mode.ONLINE
    boot_time = state.boot_time
    if boot_time is not None and (facts.taken_at - boot_time) < BOOT_AP_GRACE:
        return Mode.BOOT
    return Mode.OFFLINE_RECONNECTING


# ** RECOVERY LADDER (recovery-ladder unification) **
#
# The recovery decision is a second pure classifier alongside next_mode:
# next_recovery_action(state, recovery_facts) -> RecoveryAction (WP2).  Like
# next_mode it reads a pre-gathered immutable snapshot and module constants only
# (constraint 10) so it can lift into wifi_policy.py unchanged.  RecoveryFacts is
# that snapshot; gather_recovery_facts() is its sole (effectful) gatherer.


@dataclass(frozen=True)
class RecoveryFacts:
    """One immutable per-tick snapshot for the recovery-ladder classifier.

    Adapter identity is carried as ifnames (hashable, pure data); the apply layer
    re-resolves adapter objects from the live Facts.adapters when it needs them.
    ``preferred_usb_ifname`` is the first deterministic USB candidate still worth
    engaging as a client (present, managed, not quarantined, not no-IP-suppressed)
    — the "USB budget spent -> drop to onboard" rung falls out of this being "".
    """
    adapters_by_ifname: dict          # ifname -> wifi_recovery.AdapterRecoveryFacts
    onboard_ifname: str               # "" when no built-in radio
    usb_ifnames: tuple                # USB candidate ifnames, deterministic order
    preferred_usb_ifname: str         # first usable USB, else ""
    hotspot_ifname: str               # AP-hosting adapter while in setup, else ""
    active_ifname: str                # active client ifname, else ""
    saved_configured: bool            # a client profile is committed
    wired_ok: bool
    taken_at: float


def gather_recovery_facts(facts: "Facts") -> "RecoveryFacts":
    """Gather the recovery-ladder snapshot from the per-pass Facts.

    Reuses Facts.adapters (single discover per pass) and derives the per-adapter
    recovery facts via the shared wifi_recovery helper so the classifier and the
    status snapshot agree exactly.
    """
    now = facts.taken_at
    adapters = facts.adapters
    by_ifname = {a.ifname: _adapter_recovery_facts(a, now) for a in adapters}

    builtin = wifi_net.resolve_builtin(adapters)
    usb = wifi_net.usb_candidates(adapters)
    hotspot = resolve_hotspot_adapter(adapters)
    with state_lock:
        in_setup = STATE.setup_mode

    preferred_usb = ""
    for a in usb:
        rf = by_ifname.get(a.ifname)
        if rf is not None and rf.managed and not rf.quarantined and not rf.noip_suppressed:
            preferred_usb = a.ifname
            break

    return RecoveryFacts(
        adapters_by_ifname=by_ifname,
        onboard_ifname=builtin.ifname if builtin is not None else "",
        usb_ifnames=tuple(a.ifname for a in usb),
        preferred_usb_ifname=preferred_usb,
        hotspot_ifname=(hotspot.ifname if (in_setup and hotspot is not None) else ""),
        active_ifname=facts.active_client.ifname if facts.active_client else "",
        saved_configured=facts.wifi_configured,
        wired_ok=bool(facts.wired_ok),
        taken_at=now,
    )


class RecoveryKind(Enum):
    """The single recovery remediation the ladder selects for this pass."""
    HOLD = "hold"                      # active path fine / Ethernet / defer to dead-PHY reset
    ACTIVATE_USB = "activate_usb"      # (re)activate the committed profile on the preferred USB
    ACTIVATE_ONBOARD = "activate_onboard"  # run the client on the built-in radio (drop AP if hosting)
    ENTER_HOTSPOT = "enter_hotspot"    # last resort: no radio can carry a client


@dataclass(frozen=True)
class RecoveryAction:
    """One recovery decision — pure data returned by next_recovery_action()."""
    kind: RecoveryKind
    ifname: str = ""                              # target radio for ACTIVATE_*
    purpose: "Optional[HotspotPurpose]" = None    # for ENTER_HOTSPOT
    drop_hotspot: bool = False                    # ACTIVATE_* must tear down the AP on ifname first
    reason: str = ""


def next_recovery_action(state, facts) -> "RecoveryAction":
    """Pure recovery-ladder classifier: state + RecoveryFacts -> RecoveryAction.

    Like next_mode() this reads a pre-gathered immutable snapshot and module
    constants only (constraint 10): no STATE mutation, no subprocess, no effects,
    no ``w`` seam — so it lifts into wifi_policy.py unchanged.  It owns the
    *client-path-vs-hotspot* priority ladder (Ethernet > preferred USB > onboard >
    hotspot-last-resort) that was previously scattered across the boot-entry,
    USB-failure fallback, and recovery-hotspot probe sites.  The low-level USB
    reset/quarantine/reboot *mechanics* remain owned by the dead-PHY module; a
    wedged USB with no onboard alternative is deferred to it via HOLD.
    """
    by = facts.adapters_by_ifname
    active = facts.active_ifname
    active_rf = by.get(active) if active else None
    in_hotspot = bool(facts.hotspot_ifname)

    # Ethernet wins; the recovery ladder does not engage.
    if facts.wired_ok:
        return RecoveryAction(RecoveryKind.HOLD, reason="wired_ok")

    # Unconfigured: nothing to reconnect; a first-run hotspot is the only option.
    if not facts.saved_configured:
        if in_hotspot:
            return RecoveryAction(RecoveryKind.HOLD, reason="unconfigured_hotspot_up")
        return RecoveryAction(RecoveryKind.ENTER_HOTSPOT,
                              purpose=HotspotPurpose.FIRST_RUN, reason="unconfigured")

    # Active client already healthy -> nothing to recover (idle USB adoption is a
    # separate, playback-gated optimisation, not part of failure recovery).
    if active_rf is not None and active_rf.healthy and not in_hotspot:
        return RecoveryAction(RecoveryKind.HOLD, reason="active_healthy")

    preferred_usb = facts.preferred_usb_ifname
    usb_rf = by.get(preferred_usb) if preferred_usb else None
    usb_has_carrier = usb_rf is not None and usb_rf.link_down is not True
    onboard = facts.onboard_ifname

    # (1) USB is the highest-priority client path.  A usable (carrier-up) preferred
    #     USB that is not already our active client -> (re)activate it.
    if usb_has_carrier and active != preferred_usb:
        return RecoveryAction(RecoveryKind.ACTIVATE_USB, ifname=preferred_usb,
                              drop_hotspot=(preferred_usb == facts.hotspot_ifname),
                              reason="usb_preferred")
    # (1b) USB is the active client but unhealthy with carrier (associating / no-IP):
    #      hold — the no-IP ledger governs and promotes onboard once suppressed.
    if usb_has_carrier and active == preferred_usb:
        return RecoveryAction(RecoveryKind.HOLD, reason="usb_active_no_ip")

    # (2) No usable USB right now (absent / quarantined / no-IP-suppressed / wedged).
    #     Try the onboard radio as a client before any hotspot — this is the
    #     boot-entry onboard-first rule AND the exit edge from a recovery hotspot.
    if onboard and active != onboard:
        return RecoveryAction(RecoveryKind.ACTIVATE_ONBOARD, ifname=onboard,
                              drop_hotspot=(onboard == facts.hotspot_ifname),
                              reason="onboard_before_hotspot")

    # (3) A wedged/quarantined USB with no onboard alternative -> leave it to the
    #     dead-PHY reset/quarantine/reboot ladder (it owns a resettable USB PHY).
    if usb_rf is not None and not onboard:
        return RecoveryAction(RecoveryKind.HOLD, reason="usb_only_defer_reset_ladder")

    # (4) No radio can carry a client -> last-resort recovery hotspot.
    if not in_hotspot:
        return RecoveryAction(RecoveryKind.ENTER_HOTSPOT,
                              purpose=HotspotPurpose.BOOT_RECOVERY, reason="no_client_path")
    return RecoveryAction(RecoveryKind.HOLD, reason="hotspot_last_resort")


def _make_playing_status_memo():
    """Return a closure that resolves playback at most once per pass.

    query_playing_status() performs a loopback HTTP GET, so callers that gate on
    playback share one memoised result for the pass instead of re-querying.
    """
    cache: dict = {}

    def memo() -> Optional[bool]:
        if "value" not in cache:
            cache["value"] = query_playing_status()
        return cache["value"]

    return memo


def _sleep_or_finish_monitor_pass(run_once: bool) -> bool:
    """Sleep between monitor passes, or signal one-pass tests to return."""
    if run_once:
        return True
    time.sleep(NETWORK_MONITOR_INTERVAL)
    return False


def _request_network_down_reboot(now: float, reason: str) -> None:
    """Request a guarded NetworkDown reboot using the shared in-process throttle."""
    with state_lock:
        retry_after = STATE.conn_reboot_retry_after
    if now >= retry_after:
        logger.warning("%s; requesting reboot", reason)
        accepted = reboot_system("NetworkDown")
        with state_lock:
            STATE.conn_reboot_retry_after = (
                float('inf') if accepted
                else now + REBOOT_RATE_LIMIT_RETRY
            )
    elif retry_after == float('inf'):
        logger.debug("NetworkDown reboot accepted; waiting for system to reboot")
    else:
        logger.debug(
            "NetworkDown reboot suppressed; will retry in %.0fs",
            retry_after - now,
        )


# ** MONITOR-LOOP HANDLER DECOMPOSITION (loop-handlers plan) **
#
# The monitor loop is an ordered set of handlers, each returning a Verdict over
# one of three per-pass context types (strictly more info per stage), plus a small
# driver-owned LoopState for the one value that must persist across passes.  The
# handlers are extracted in place first; the run_steps driver lands last.


class Verdict(Enum):
    """A handler's result: it either owned the pass or falls through."""
    OWN_PASS = "own_pass"   # transition performed; driver sleeps/returns, loop restarts
    CONTINUE = "continue"   # fall through to the next handler in the same pass


@dataclass(frozen=True)
class PreFactsContext:
    """Phase A context (event/timer), before gather_facts().

    ``avahi_ok`` (``not setup_mode and not apply_in_progress``) is read in the same
    top-of-pass state_lock block as ``boot_time`` so the avahi/mDNS handlers gate on
    it without re-reading STATE (which would change the lock/read timing).
    """
    now: float
    boot_time: float
    avahi_ok: bool


@dataclass(frozen=True)
class FactsContext:
    """Phase B-early context: PreFactsContext + the per-pass Facts and playback memo.

    Carries no health fields, so a handler that must run before
    _set_active_client() (step_usb_failure_fallback) structurally cannot read them.
    """
    pre: PreFactsContext
    facts: "Facts"
    playing: object            # per-pass memoised playback resolver (callable)

    @property
    def now(self) -> float: return self.pre.now
    @property
    def boot_time(self) -> float: return self.pre.boot_time
    @property
    def avahi_ok(self) -> bool: return self.pre.avahi_ok


@dataclass(frozen=True)
class HealthContext:
    """Phase B-late context: FactsContext + the five health fields.

    Produced by finalize_active_client_and_health() after _set_active_client().
    """
    fctx: FactsContext
    health_ifname: str
    wifi_connected: bool
    client_ok: bool
    conn_ok: bool
    active_path_ok: bool

    @property
    def now(self) -> float: return self.fctx.now
    @property
    def boot_time(self) -> float: return self.fctx.boot_time
    @property
    def avahi_ok(self) -> bool: return self.fctx.avahi_ok
    @property
    def facts(self) -> "Facts": return self.fctx.facts
    @property
    def playing(self) -> object: return self.fctx.playing


@dataclass
class LoopState:
    """Driver-owned state that persists across passes (not per-pass context).

    Home for cross-pass loop-locals so handlers never smuggle persistent state
    through a per-pass context.  Currently just the avahi hostname-check rate limit.
    """
    last_avahi_check: float = 0.0


def finalize_active_client_and_health(fctx: "FactsContext") -> "HealthContext":
    """Named phase boundary (not a Verdict handler): set the active client and
    compute the five health fields, returning the HealthContext for Phase B-late.

    Wraps _set_active_client() plus the health computation; it may mutate
    STATE.active_client_* but never owns the pass.
    """
    facts = fctx.facts
    active_client = facts.active_client
    wifi_cfg = facts.wifi_configured

    _set_active_client(active_client)
    # Health is scoped to the *active client* adapter; fall back to the built-in
    # interface name for an unconfigured/idle device.
    health_ifname = active_client.ifname if active_client else AP_IFNAME
    wifi_connected = wifi_net.is_wifi_connected(health_ifname) if wifi_cfg else False
    client_ok = (
        is_wifi_client_healthy(health_ifname, wifi_connected=wifi_connected)
        if wifi_cfg
        else False
    )
    active_path_ok = bool(facts.wired_ok or client_ok)
    conn_ok = active_path_ok
    return HealthContext(
        fctx, health_ifname=health_ifname, wifi_connected=wifi_connected,
        client_ok=client_ok, conn_ok=conn_ok, active_path_ok=active_path_ok,
    )


def network_monitor_loop(run_once: bool = False):
    """Background loop to check network state and enforce the narrative rules.

    Summary of behaviour:
      - If wired ethernet is usable (carrier plus valid IPv4): never enter
            automatic AP mode; if currently in AP mode, exit it unless the user
            explicitly requested AP via /request_ap_mode.
      - If WiFi is unconfigured OR still disconnected after BOOT_AP_GRACE seconds:
            enter AP mode within the boot window (BOOT_AP_GRACE..BOOT_AP_CUTOFF).
            Unconfigured devices: AP runs indefinitely (no timeout).
            Configured devices that failed to reconnect: AP runs for AP_MAX_DURATION.
      - If WiFi is configured and usable ethernet is down:
            use the kernel's view of the default gateway as a health check.
            If unreachable for > GW_DOWN_RECONNECT_AFTER: periodically attempt reconnect.
            If unreachable for > GW_DOWN_REBOOT_AFTER: reboot.

    Reboot-timer domains:
      - Dead-PHY: 30-minute guarded reboot when genuinely offline; resets can
            still run while ethernet is attached.
      - Generic WiFi gateway-down: 30-minute guarded reboot for configured WiFi
            clients, skipped whenever usable ethernet is present.
      - Global no-active-path catch-all: 12-hour guarded reboot when no usable
            non-hotspot WiFi or ethernet path has been seen during normal
            monitoring. Setup/AP mode suspends this timer; leaving AP rebases it.
    """
    logger.info("Starting network monitor loop")

    # Record boot time on first entry
    with state_lock:
        if STATE.boot_time is None:
            STATE.boot_time = time.monotonic()
        if STATE.last_active_path_seen is None:
            STATE.last_active_path_seen = STATE.boot_time

    loop_state = LoopState()

    while True:
        now = time.monotonic()
        with state_lock:
            boot_time = STATE.boot_time or now
            _avahi_ok = not STATE.setup_mode and not STATE.apply_in_progress
        pre = PreFactsContext(now=now, boot_time=boot_time, avahi_ok=_avahi_ok)

        # Avahi mDNS hostname check (reduced frequency; skip during setup and WiFi apply)
        if _avahi_ok and (now - loop_state.last_avahi_check) >= AVAHI_CHECK_INTERVAL:
            loop_state.last_avahi_check = now
            check_and_repair_avahi_hostname()

        # mDNS host-record re-announce: catch passive network-path changes (e.g. a
        # USB Wi-Fi adapter removed while ethernet stays up) as well as orchestrated
        # handovers, debounced until the published address set settles.  Runs every
        # pass; skipped during setup and WiFi apply (folded into _avahi_ok).
        if _avahi_ok:
            maybe_reannounce_mdns(now)

        # Handle manual request to enter AP mode (from the normal WebUI via localhost).
        # This overrides the boot-time auto-AP cutoff.
        if ap_request_event.is_set():
            with state_lock:
                reason = STATE.ap_request_reason
                # Clear stored reason once consumed (optional but keeps it tidy)
                STATE.ap_request_reason = ""
                ap_request_event.clear()
                already_in_ap = STATE.setup_mode
            # If we're not already in AP mode, enter a MANUAL hotspot now.  A
            # MANUAL session is not torn down by Ethernet (Section 2.3).
            if not already_in_ap:
                enter_setup_mode(HotspotPurpose.MANUAL,
                                 reason=f"manual_request: {reason or 'UserRequest'}")
                if _sleep_or_finish_monitor_pass(run_once):
                    return
                continue

        # Revert a temporary runtime log level once its TTL expires (WP7).
        revert_expired_log_level(now)

        # Handle queued local-control actions (start_setup / reconnect_saved /
        # set_log_level).  Disruptive actions own the pass; the non-disruptive
        # set_log_level is applied and the pass continues normally.
        if control_action_event.is_set():
            with state_lock:
                action = STATE.pending_control_action
                params = dict(STATE.pending_control_params)
                STATE.pending_control_action = ""
                STATE.pending_control_params = {}
                control_action_event.clear()
            if action:
                process_control_action(action, params)
                if action != "set_log_level":
                    if _sleep_or_finish_monitor_pass(run_once):
                        return
                    continue

        # Enforce the explicit-reconfiguration 30-minute timeout (Section 11.4).
        with state_lock:
            session = STATE.hotspot
        if (session is not None
                and session.purpose == HotspotPurpose.EXPLICIT_RECONFIGURE
                and (now - session.entered_at) >= AP_MAX_DURATION):
            handle_reconfigure_timeout()
            if _sleep_or_finish_monitor_pass(run_once):
                return
            continue

        # Single immutable per-tick snapshot (WP1, Section 2.5): one
        # discover_adapters / wired probe / address enumeration for the whole
        # pass.  Every decision below reads these locals, not fresh subprocess
        # calls.  Playback is resolved lazily through the per-pass memo.
        facts = gather_facts()
        wifi_cfg = facts.wifi_configured
        wired_connected = facts.wired_connected
        wired_ok = facts.wired_ok
        adapters = facts.adapters
        active_client = facts.active_client
        playing_status = _make_playing_status_memo()
        fctx = FactsContext(pre, facts, playing_status)

        # --- Multi-adapter discovery and active-client resolution (WP5) ---
        update_known_adapters(adapters)

        # --- Startup USB-adoption window: re-probe when a new USB adapter
        # appears while BOOT_AP_GRACE is still open (Section 4.3).
        # USB firmware/drivers may finish enumeration after the initial
        # startup_connect_usb_first() call; triggering it again for any new
        # USB MAC prevents a USB-only network from falling to hotspot mode.
        boot_age_now = now - boot_time
        if (boot_age_now < BOOT_AP_GRACE
                and wifi_cfg
                and not wired_ok
                and not STATE.setup_mode):
            usb_macs_now = {a.permanent_mac for a in wifi_net.usb_candidates(adapters)}
            new_usb = usb_macs_now - _startup_window_usb_tried_macs
            if new_usb:
                _startup_window_usb_tried_macs.update(usb_macs_now)
                active_is_usb = active_client is not None and active_client.is_usb
                if not active_is_usb:
                    logger.info(
                        "Startup USB-adoption window: new USB adapter(s) appeared %s;"
                        " retrying USB-first connection", sorted(new_usb),
                    )
                    if startup_connect_usb_first():
                        if _sleep_or_finish_monitor_pass(run_once):
                            return
                        continue

        # --- Active-USB failure fallback (immediate/debounced; never gated by
        # playback). Must run BEFORE _set_active_client() so that
        # STATE.active_client_mac still holds the previously recorded USB MAC
        # when the adapter physically disappears from discovery. ---
        if wifi_cfg and not wired_ok and not STATE.setup_mode:
            if handle_usb_failure_fallback(adapters, active_client):
                if _sleep_or_finish_monitor_pass(run_once):
                    return
                continue

        # Named phase boundary: set the active client and compute health once,
        # producing the HealthContext the Phase B-late handlers read.  Unpacked to
        # locals here (handlers land in later WPs).
        hctx = finalize_active_client_and_health(fctx)
        health_ifname = hctx.health_ifname
        wifi_connected = hctx.wifi_connected
        client_ok = hctx.client_ok
        conn_ok = hctx.conn_ok
        active_path_ok = hctx.active_path_ok

        # --- Optional idle-time USB adoption from a healthy built-in client. ---
        if wifi_cfg and conn_ok and not STATE.setup_mode:
            if handle_runtime_usb_adoption(adapters, wired_ok, playing_fn=playing_status):
                if _sleep_or_finish_monitor_pass(run_once):
                    return
                continue

        # --- Dead-PHY recovery: detect a wedged-but-present client adapter and
        # run the reset ladder.  This runs before the ethernet-wins short-circuit
        # so a genuinely dead Wi-Fi PHY is reset even while ethernet is attached.
        # But when wired Ethernet wins and the Wi-Fi client has already been
        # dropped (wired-wins, Section 2.7), the idle radio is administratively
        # down by design — leave it down rather than spending reset budget on it.
        if wifi_cfg and not (wired_ok and active_client is None):
            if escalate_dead_adapter_recovery(adapters, wired_ok):
                if _sleep_or_finish_monitor_pass(run_once):
                    return
                continue

        with state_lock:
            STATE.wifistate = "configured" if wifi_cfg else "unconfigured"
            STATE.wiredstate = "connected" if wired_connected else "disconnected"
            STATE.connectivity_ok = conn_ok
            if active_path_ok and not STATE.setup_mode:
                STATE.last_active_path_seen = now
                STATE.conn_reboot_retry_after = 0.0
            # Apply the pure forward classifier: STATE.mode is authoritative.
            STATE.mode = next_mode(STATE, facts)
            log_on_change("device_mode", STATE.mode, f"Mode changed -> {STATE.mode.value}")
            log_on_change("wifistate", STATE.wifistate, f"WiFi state changed -> {STATE.wifistate}")
            log_on_change("wiredstate", STATE.wiredstate, f"Wired state changed -> {STATE.wiredstate}")
            log_on_change("gateway_reachable", STATE.connectivity_ok, f"Connectivity changed -> {STATE.connectivity_ok}")

        # Publish the runtime status snapshot served by /network_status.  Pass
        # the per-tick addresses so the status builder does not re-enumerate.
        publish_network_status(adapters, wired_connected, wired_ok, facts.addresses)

        # Ethernet suppresses AP mode entirely (unless the user explicitly requested AP).
        # State is read under the lock; leave_setup_mode is called outside to avoid
        # a deadlock (leave_setup_mode also acquires state_lock, which is not re-entrant).
        with state_lock:
            # Ethernet suppresses an automatic-purpose hotspot, but a
            # user-initiated one (MANUAL / EXPLICIT_RECONFIGURE) is left up.
            ethernet_wins = wired_ok and not _hotspot_blocks_eth(STATE.hotspot)
            in_ap_for_eth = STATE.setup_mode
            if ethernet_wins:
                STATE.conn_down_start = None
                STATE.last_reconnect_attempt = None

        if ethernet_wins:
            if in_ap_for_eth:
                leave_setup_mode("Wired ethernet is up; suppressing AP mode")
            with state_lock:
                active_wifi_ifname = STATE.active_client_ifname
                skip_disconnect = (
                    STATE.apply_in_progress or STATE.setup_mode or in_ap_for_eth
                )
            # Wired wins (Section 2.7): when usable Ethernet is present, run on it
            # and drop the redundant Wi-Fi client — regardless of subnet — so there
            # is one deterministic path and one mDNS address.  The single gate is
            # playback: switching the active interface changes the appliance IP and
            # would break an in-flight AirPlay/OwnTone stream, so defer (do not
            # disconnect) while streaming or while playback is uncertain.
            if active_wifi_ifname and not skip_disconnect:
                if playing_status() is False:
                    logger.info(
                        "Usable wired Ethernet present; disconnecting idle WiFi client %s",
                        active_wifi_ifname,
                    )
                    run_cmd(["nmcli", "device", "disconnect", active_wifi_ifname])
                    _set_active_client(None)
            if _sleep_or_finish_monitor_pass(run_once):
                return
            continue

        with state_lock:
            if wired_ok and _hotspot_blocks_eth(STATE.hotspot):
                # A user-initiated hotspot (MANUAL / EXPLICIT) is held up even
                # though ethernet is usable; do not let conn timers fire.
                STATE.conn_down_start = None
                STATE.last_reconnect_attempt = None

        # If we're currently hosting a hotspot, enforce its purpose-driven policy
        # from PURPOSE_TABLE (Section 2.3): probe-for-return and deadline.
        with state_lock:
            in_setup = STATE.setup_mode
            session = STATE.hotspot

        if in_setup and session is not None:
            policy = PURPOSE_TABLE[session.purpose]
            ap_age = now - session.entered_at

            # Recovery purposes (BOOT_RECOVERY / USB_LOSS_RECOVERY) probe for the
            # saved network's return rather than waiting for the deadline
            # (Section 8.6 / 2.8; defect 1 — BOOT_RECOVERY now probes).  With a
            # second radio the probe runs without dropping the AP; on single-radio
            # hardware the scan is rate-limited and only when the saved SSID is
            # visible is the expensive tear-down→join→rebuild performed (WP6).
            # User-initiated hotspots wait policy.probe_grace_s after entry before
            # probing, so the watcher does not rejoin the very network the user
            # opened the portal to change before they can select a new one.
            if policy.probes_return and wifi_cfg and ap_age >= policy.probe_grace_s:
                _attempt_recovery_reconnect(adapters, now)

            # Session lifetime: FIRST_RUN (deadline None) stays up indefinitely
            # — an unconfigured device has nowhere else to go; every other
            # purpose closes after its 30-minute deadline.
            if policy.deadline_s is not None and ap_age >= policy.deadline_s:
                leave_setup_mode(
                    f"Hotspot lifetime expired after {ap_age:.0f}s ({session.purpose.value})")
            if _sleep_or_finish_monitor_pass(run_once):
                return
            continue

        # Decide whether we should enter the hotspot during the boot window.
        # There is no once-per-boot budget (defect 2): a recovery hotspot is
        # enterable whenever offline; the boot window only gates this initial
        # auto-entry so NM/firmware get a chance to come up first.
        with state_lock:
            in_setup = STATE.setup_mode

        if not in_setup:
            boot_age = now - boot_time
            # Auto-setup mode is only entered if:
            #   - WiFi is not configured, OR WiFi is not connected, OR WiFi is
            #     connected but the client is unhealthy (NM activated but no
            #     usable IPv4/gateway — e.g. DHCP failure or router changed)
            #   - still offline AFTER the boot grace period.
            #   - still offline BEFORE the boot cutoff period.
            # This avoids immediately switching to AP mode before NetworkManager /
            # firmware has had a chance to come up.
            offline = (not wifi_cfg) or (not wifi_connected) or (not client_ok)
            should_enter_ap = (
                boot_age >= BOOT_AP_GRACE
                and boot_age <= BOOT_AP_CUTOFF
                and offline
            )

            if boot_age <= BOOT_AP_CUTOFF:
                logger.debug(
                    "Boot window: age=%.0fs/%.0fs, wifi_cfg=%s, connected=%s, client_ok=%s",
                    boot_age, BOOT_AP_CUTOFF, wifi_cfg, wifi_connected, client_ok,
                )

            if offline and boot_age > BOOT_AP_CUTOFF:
                log_on_change(
                    "boot_ap_window_expired", True,
                    f"Boot AP window expired (boot_age={boot_age:.0f}s); "
                    f"device offline but automatic boot-window AP entry has passed",
                    logging.WARNING,
                )

            if should_enter_ap:
                # Recovery-ladder unification: before committing a radio to a
                # recovery hotspot, try the highest-priority *client* path the
                # ladder selects (preferred USB, else the onboard radio).  A
                # configured device with a wedged/failed USB but a working onboard
                # must run on the onboard rather than tie it up as an AP for 30
                # minutes (field log 30-Jun-2026).  Only an ACTIVATE_* that comes
                # up healthy short-circuits the hotspot; HOLD / ENTER_HOTSPOT (and a
                # failed activation) fall through so an offline device still gets a
                # setup portal.
                raction = next_recovery_action(STATE, gather_recovery_facts(facts))
                if raction.kind in (RecoveryKind.ACTIVATE_USB,
                                    RecoveryKind.ACTIVATE_ONBOARD) \
                        and _apply_client_activation(raction, facts):
                    if _sleep_or_finish_monitor_pass(run_once):
                        return
                    continue
                # Defect 1: a configured-but-offline device enters BOOT_RECOVERY
                # (which probes for the saved network's return), not FIRST_RUN;
                # an unconfigured device enters FIRST_RUN (nothing saved to probe).
                purpose = (HotspotPurpose.BOOT_RECOVERY if wifi_cfg
                           else HotspotPurpose.FIRST_RUN)
                enter_setup_mode(
                    purpose,
                    reason=f"boot_age={boot_age:.0f}s, wifi_cfg={wifi_cfg}, wifi_connected={wifi_connected}, client_ok={client_ok}",
                )
                if _sleep_or_finish_monitor_pass(run_once):
                    return
                continue

        # Connection reliability monitoring: WiFi configured, usable ethernet down.
        # Use the same "local IPv4 readiness" health indicator (conn_ok) as used elsewhere.
        if wifi_cfg and not wired_ok:
            with state_lock:
                down_start = STATE.conn_down_start
                last_attempt = STATE.last_reconnect_attempt

            if not conn_ok:
                first_entry = down_start is None
                if first_entry:
                    # Entering OFFLINE_RECONNECTING (Section 2.7): attempt one
                    # prompt reconnect immediately rather than waiting for the
                    # 5-minute gateway-down threshold.  This is how Wi-Fi comes
                    # back after a wired-wins disconnect once Ethernet drops,
                    # without a policy flag or a 5-minute wait.
                    with state_lock:
                        STATE.conn_down_start = now
                        STATE.last_reconnect_attempt = now
                    down_start = now
                    logger.info("Connectivity lost; attempting prompt reconnect on entry")
                    connect_to_configured_wifi()

                down_for = now - down_start

                # Generic gateway-down 30-minute reboot (WP4): this governs a
                # configured client that is connected but has no usable gateway
                # (e.g. DHCP/router change), NOT a wedged/NO-CARRIER adapter —
                # that case is owned by the dead-PHY ladder above.
                if down_for >= GW_DOWN_REBOOT_AFTER:
                    _request_network_down_reboot(
                        now,
                        "Connectivity unhealthy for %.0fs (threshold %ss)"
                        % (down_for, GW_DOWN_REBOOT_AFTER),
                    )

                if (not first_entry) and down_for >= GW_DOWN_RECONNECT_AFTER:
                    if (last_attempt is None) or (now - last_attempt >= RECONNECT_ATTEMPT_INTERVAL):
                        with state_lock:
                            STATE.last_reconnect_attempt = now
                        logger.info("Connectivity unhealthy for %.0fs; attempting reconnect", down_for)
                        connect_to_configured_wifi()
            else:
                with state_lock:
                    STATE.conn_down_start = None
                    STATE.last_reconnect_attempt = None
                    STATE.conn_reboot_retry_after = 0.0

        with state_lock:
            in_setup = STATE.setup_mode
            last_active_path_seen = STATE.last_active_path_seen

        if not in_setup and last_active_path_seen is not None:
            no_active_for = now - last_active_path_seen
            if no_active_for >= NO_ACTIVE_PATH_REBOOT_AFTER:
                _request_network_down_reboot(
                    now,
                    "No usable network path for %.0fs (threshold %ss)"
                    % (no_active_for, NO_ACTIVE_PATH_REBOOT_AFTER),
                )

        if _sleep_or_finish_monitor_pass(run_once):
            return

def connect_to_configured_wifi() -> bool:
    """Attempt to bring up the configured WiFi client connection on the built-in.

    Returns True if nmcli was invoked (best-effort), False if there is no configured
    connection to try.  Use startup_connect_usb_first() at boot; this function is
    the built-in fallback path called when USB-first selection is not applicable.
    """
    connection_name = get_configured_wifi_connection_name()
    if not connection_name:
        return False

    # If the configured WiFi is already healthy, do not disturb it.
    if is_wifi_client_healthy():
        logger.debug("Configured WiFi '%s' already healthy; no action needed", connection_name)
        return True

    # NOTE: the former `nmcli device disconnect/connect` bounce was removed —
    # it is ineffective for a wedged USB PHY (NO-CARRIER) and the dead-PHY USB
    # reset ladder supersedes it.  Just (re)activate the configured profile.
    logger.info("Attempting to connect to configured WiFi connection '%s'", connection_name)
    r_up = run_cmd(["nmcli", "connection", "up", connection_name])
    if r_up.returncode != 0:
        logger.warning("nmcli connection up '%s' failed (rc=%d): %s", connection_name, r_up.returncode, r_up.stderr.strip())
    return True


def _resolve_committed_uuid(state: "wifi_net.NetworkState") -> str:
    """Return the UUID for the committed profile, resolving and persisting if absent.

    When network.json was written without a UUID (e.g. migrated from the legacy
    ssid file), this resolves the UUID from NetworkManager at operation time and
    atomically persists it so future calls have it immediately.  Returns "" when
    the profile cannot be uniquely identified, in which case restriction clearing
    must be skipped.
    """
    if state.connection_uuid:
        return state.connection_uuid
    if not state.connection_name:
        return ""
    resolved = wifi_net.resolve_connection_uuid_for_name(state.connection_name)
    if not resolved:
        logger.warning(
            "Cannot resolve UUID for committed profile '%s'; "
            "cross-adapter restriction clearing will be skipped",
            state.connection_name,
        )
        return ""
    try:
        wifi_net.save_network_state(
            wifi_net.NetworkState(
                connection_name=state.connection_name,
                connection_uuid=resolved,
            ),
            state_path=NETWORK_STATE_PATH,
            legacy_path=CONFIGURED_SSID,
        )
        logger.info(
            "Lazily resolved and persisted UUID %s for committed profile '%s'",
            resolved, state.connection_name,
        )
    except Exception as e:
        logger.warning(
            "Could not persist resolved UUID for '%s': %s; will still clear restrictions",
            state.connection_name, e,
        )
    return resolved


def startup_connect_usb_first() -> bool:
    """USB-first startup connection (Section 4.3).

    During the boot window, tries the committed profile on each detected managed
    USB adapter in deterministic order.  If any USB adapter validates, the
    built-in client connection is deactivated and USB becomes the sole Wi-Fi
    client.  Falls back to the built-in adapter when no USB is present or all
    USB attempts fail.

    Returns True if a connection was attempted (best-effort), False if unconfigured.
    """
    state = get_configured_network_state()
    if not state.is_configured:
        return False

    if any_wired_path_healthy():
        logger.info("Startup USB-first: usable wired Ethernet present; skipping USB activation")
        return False

    adapters = wifi_net.discover_adapters()
    builtin = wifi_net.resolve_builtin(adapters)
    usb = wifi_net.usb_candidates(adapters)

    # Resolve UUID (lazily persisting if missing) then clear cross-adapter
    # restrictions before any USB activation attempt so a legacy profile bound
    # to built-in by interface-name/MAC/BSSID/band/channel can be activated on
    # a USB interface.  Only cleared when USB adapters are present; modifying
    # an active profile when no cross-adapter move is needed can cause NM to
    # briefly re-activate, disrupting the existing connection.
    uuid = _resolve_committed_uuid(state)
    if uuid and usb:
        run_cmd(wifi_net.clear_restrictions_cmd(uuid, wifi_net.CROSS_ADAPTER_RESTRICTIONS))

    for candidate in usb:
        logger.info(
            "Startup USB-first: trying committed profile on %s (%s)",
            candidate.ifname, candidate.permanent_mac,
        )
        run_cmd(wifi_net.activate_connection_cmd(
            uuid, state.connection_name, candidate.ifname,
        ))
        if (wait_for_connection(candidate.ifname,
                                timeout=WAIT_FOR_CONNECTION_TIMEOUT,
                                interval=WAIT_FOR_CONNECTION_INTERVAL)
                and is_wifi_client_healthy(candidate.ifname)):
            # Deactivate built-in client connection if still active.
            if builtin and wifi_net.is_wifi_connected(builtin.ifname):
                logger.info("Startup USB-first: disconnecting built-in client on %s", builtin.ifname)
                run_cmd(["nmcli", "device", "disconnect", builtin.ifname])
            wifi_recovery.clear_noip_failures(_self_module(), candidate.stable_id)
            logger.info("Startup USB-first: connection established on %s", candidate.ifname)
            return True
        wifi_recovery.record_noip_failure(_self_module(), candidate.stable_id, time.monotonic())
        logger.debug("Startup USB-first: attempt on %s failed", candidate.ifname)

    if usb:
        logger.info("Startup USB-first: all USB attempts failed; falling back to built-in")
    else:
        logger.debug("Startup USB-first: no USB adapters found; using built-in")

    return connect_to_configured_wifi()


# ** MULTI-ADAPTER FAILURE, FALLBACK, AND RUNTIME USB ADOPTION (WP5) **
#
# All fallback/adoption *policy* lives here in the watcher.  The helper only
# reports facts (discovery, health, scans) and performs bounded primitives.


def query_playing_status() -> Optional[bool]:
    """Return True/False playback state, or None when uncertain (Section 8.3).

    In Dial mode there is no local player, so playback is always treated as
    idle.  On the main appliance the watcher performs a read-only loopback GET
    to /api/playing-status with a short timeout and accepts state only when the
    response is exactly ok:true with a boolean playing.  Any failure, malformed
    body, or explicit uncertainty returns None (defer, never assume idle).
    """
    if _DIAL_MODE:
        return False
    try:
        with urllib.request.urlopen(PLAYING_STATUS_URL, timeout=PLAYING_STATUS_TIMEOUT) as resp:
            raw = resp.read()
        data = json.loads(raw)
    except Exception:
        _warn_playing_status_unavailable()
        return None
    if not isinstance(data, dict) or data.get("ok") is not True:
        _warn_playing_status_unavailable()
        return None
    playing = data.get("playing")
    if not isinstance(playing, bool):
        _warn_playing_status_unavailable()
        return None
    return playing


def _warn_playing_status_unavailable() -> None:
    """Throttled WARNING when playback status is unavailable during pending adoption."""
    now = time.monotonic()
    with state_lock:
        pending = STATE.pending_usb_adoption_mac is not None
        last = STATE.last_playing_status_warn
        if pending and (now - last) >= PLAYING_STATUS_WARN_THROTTLE:
            STATE.last_playing_status_warn = now
            do_warn = True
        else:
            do_warn = False
    if do_warn:
        logger.warning("Playing status unavailable while USB adoption pending; deferring")


def _activation_network_absent(result) -> bool:
    """True when nmcli reported the target SSID is not currently visible.

    A hard "network could not be found" activation failure means waiting the full
    WAIT_FOR_CONNECTION_TIMEOUT for an IPv4 lease is pointless — the join never
    started — so the recovery ladder should fail this rung immediately and climb
    to the next one (e.g. the onboard) far sooner.  Field log 30-Jun-2026: 45s was
    wasted after every "could not be found" probe of a wedged USB.
    """
    if result is None or getattr(result, "returncode", 0) == 0:
        return False
    stderr = (getattr(result, "stderr", "") or "").lower()
    return "could not be found" in stderr or "no network with ssid" in stderr


def _activate_committed_on(ifname: str) -> bool:
    """Activate the committed profile on *ifname* and validate health.

    Clears cross-adapter NM restrictions (interface-name, MAC, BSSID, band,
    channel) BEFORE activating so a legacy profile bound to the built-in
    adapter can be moved to a USB interface (or vice-versa).  Returns True
    only when the interface becomes a healthy, non-AP client.
    """
    state = get_configured_network_state()
    if not state.is_configured:
        return False
    uuid = _resolve_committed_uuid(state)
    if uuid:
        run_cmd(wifi_net.clear_restrictions_cmd(uuid, wifi_net.CROSS_ADAPTER_RESTRICTIONS))
    # Mark the slow transition posture (WP1 groundwork; inert until WP7).  The
    # single-threaded loop cannot re-enter this blocking effect today, so the
    # flag changes no behaviour yet — it exists so WP7's worker path can prevent
    # duplicate concurrent transitions.
    with state_lock:
        STATE.transitioning = True
    try:
        r_up = run_cmd(wifi_net.activate_connection_cmd(uuid, state.connection_name, ifname))
        # Probe-patience: a "network not found" activation cannot yield an IP, so
        # skip the IPv4 wait and fail fast (frees the ladder to climb sooner).
        if _activation_network_absent(r_up):
            logger.info("Committed network not visible on %s; skipping IPv4 wait", ifname)
            return False
        return (wait_for_connection(ifname, timeout=WAIT_FOR_CONNECTION_TIMEOUT,
                                    interval=WAIT_FOR_CONNECTION_INTERVAL)
                and is_wifi_client_healthy(ifname))
    finally:
        with state_lock:
            STATE.transitioning = False


def verify_avahi_after_handover() -> None:
    """Verify the Avahi hostname and flag an mDNS host-record re-announce.

    Reuses the existing hostname verification path, then marks a re-announce as
    pending rather than restarting avahi-daemon directly.  The monitor loop owns
    the actual re-announce (see maybe_reannounce_mdns): it waits for the published
    address set to settle before restarting, so it re-announces only the surviving
    interface's address (never re-poisoning clients with the address that is being
    torn down mid-handover), and de-duplicates with the passive address-change
    detector so a single restart covers both triggers.
    """
    try:
        check_and_repair_avahi_hostname()
        mark_mdns_reannounce_pending("network handover")
    except Exception as e:
        logger.warning("Avahi handover verification failed: %s", e)


def _set_active_client(adapter) -> None:
    with state_lock:
        if adapter is None and STATE.active_usb_unhealthy_checks > 0:
            # Debounce in progress: clear ifname so the loop knows there is no
            # active client, but keep active_client_mac so that the next pass of
            # handle_usb_failure_fallback can still match the recorded USB adapter.
            STATE.active_client_ifname = ""
            return
        changed = STATE.active_client_ifname != (adapter.ifname if adapter else "")
        STATE.active_client_ifname = adapter.ifname if adapter else ""
        STATE.active_client_mac = adapter.permanent_mac if adapter else ""
    if changed and adapter:
        logger.info("Active client adapter changed -> %s (%s)", adapter.ifname, adapter.kind)


def resolve_active_client(adapters: list) -> Optional[object]:
    """Return the adapter currently carrying a non-AP Wi-Fi client connection."""
    for a in adapters:
        if wifi_net.is_wifi_connected(a.ifname):
            return a
    return None


def handle_usb_failure_fallback(adapters: list, active_client) -> bool:
    """Active-USB failure handling via the adapter-remediation overlay (WP5a).

    The overlay (wifi_recovery.diagnose_client_failure) diagnoses the active
    client and returns a ClientFailed event; this loop site applies the
    connectivity transition.  Returns True when a transition was performed on
    this pass; the caller then skips its ordinary reconnect/reboot logic for
    this pass.  Never gated by playback.
    """
    event = wifi_recovery.diagnose_client_failure(_self_module(), adapters, active_client)
    if event is None:
        return False
    return apply_client_failed(event, adapters)


def apply_client_failed(event, adapters: list) -> bool:
    """Apply an overlay ClientFailed event (Section 3.1a).

    ClientFailed with an alternate path → built-in fallback to ONLINE; without →
    HOTSPOT(USB_LOSS_RECOVERY).  _do_builtin_fallback_or_recovery encodes both
    (try built-in, else recovery hotspot), so the apply is a single call; the
    has_alt_path hint is carried on the event for status/diagnostics.
    """
    logger.info(
        "Overlay ClientFailed(%s) on %s; applying fallback transition",
        event.reason, event.ifname or event.mac or "?",
    )
    return _do_builtin_fallback_or_recovery(adapters, reason=event.reason)


# Remember which permanent MACs were last seen as USB, so that an absent active
# adapter can still be classified as USB after it disappears from discovery.
_known_usb_macs: set[str] = set()

# Track USB MACs already attempted during the startup adoption window so that
# startup_connect_usb_first() is triggered at most once per new USB device
# appearing within BOOT_AP_GRACE.
_startup_window_usb_tried_macs: set[str] = set()


def _do_builtin_fallback_or_recovery(adapters: list, reason: str) -> bool:
    """Attempt built-in LAN fallback; enter recovery hotspot if it fails."""
    builtin = wifi_net.resolve_builtin(adapters)
    if builtin is not None and _activate_committed_on(builtin.ifname):
        with state_lock:
            STATE.using_builtin_fallback = True
            STATE.conn_down_start = None
            STATE.last_reconnect_attempt = None
        _set_active_client(builtin)
        logger.info("Built-in LAN fallback connected (%s)", reason)
        verify_avahi_after_handover()
        return True

    logger.warning("Built-in LAN fallback failed (%s); entering recovery hotspot", reason)
    enter_setup_mode(HotspotPurpose.USB_LOSS_RECOVERY, reason=f"usb_loss_recovery: {reason}")
    return True


def _apply_client_activation(action: "RecoveryAction", facts: "Facts") -> bool:
    """Apply an ACTIVATE_USB / ACTIVATE_ONBOARD recovery action (WP3).

    Tears down the hotspot on the target radio first when the action requires it
    (the exit edge out of a recovery hotspot), activates the committed profile on
    ``action.ifname``, and on a healthy result adopts it as the active client and
    leaves setup mode.  Returns True only when the client came up healthy.  On
    failure: a USB activation records a no-IP failure (so the ladder promotes the
    onboard once the USB budget is spent); a torn-down AP is rebuilt so the portal
    stays available.
    """
    ifname = action.ifname
    if not ifname:
        return False

    dropped_ap = False
    with state_lock:
        in_setup = STATE.setup_mode
    if action.drop_hotspot and in_setup:
        stop_ap_mode()
        dropped_ap = True

    if _activate_committed_on(ifname):
        adapters = wifi_net.discover_adapters()
        adapter = wifi_net.find_adapter_by_ifname(adapters, ifname)
        if adapter is not None:
            _set_active_client(adapter)
            wifi_recovery.clear_noip_failures(_self_module(), adapter.stable_id)
        with state_lock:
            # Onboard counts as a fallback only when a USB path also exists (a
            # broken configured USB); a lone onboard client is not "degraded".
            usb_present = any(a.is_usb for a in facts.adapters)
            STATE.using_builtin_fallback = (
                action.kind == RecoveryKind.ACTIVATE_ONBOARD and usb_present
            )
            STATE.conn_down_start = None
            STATE.last_reconnect_attempt = None
        leave_setup_mode(f"recovery: client up on {ifname} ({action.reason})")
        verify_avahi_after_handover()
        logger.info("Recovery: client activated on %s (%s)", ifname, action.reason)
        return True

    # Activation failed.  Rebuild the AP if we tore it down so the portal stays up.
    if dropped_ap:
        with state_lock:
            STATE.setup_mode = True
        start_ap_mode()
        update_apmode_flag(True)
    # Record a no-IP failure only for USB so the ladder eventually promotes the
    # onboard; do not suppress the onboard fallback (it is retried, rate-limited).
    if action.kind == RecoveryKind.ACTIVATE_USB:
        adapter = wifi_net.find_adapter_by_ifname(facts.adapters, ifname)
        stable_id = adapter.stable_id if adapter is not None else ifname
        wifi_recovery.record_noip_failure(_self_module(), stable_id, facts.taken_at)
    logger.info("Recovery: client activation failed on %s (%s)", ifname, action.reason)
    return False


def _try_recovery_reconnect(adapters: list) -> None:
    """USB-first reconnect attempt during automatic-recovery hotspot (Section 8.6).

    Tries the committed profile on USB adapters first, then built-in.  On
    success, calls leave_setup_mode() so nginx returns to the application
    backend without waiting for the 30-minute timeout.  On failure, retains
    the hotspot; the caller schedules the next retry via RECONNECT_ATTEMPT_INTERVAL.
    """
    state = get_configured_network_state()
    if not state.is_configured:
        return
    # Only probe USB adapters while the recovery hotspot is running on the
    # built-in radio.  Activating a client on the built-in while it hosts the
    # AP would displace the hotspot; that path is handled by the 30-minute
    # timeout rollback in handle_reconfigure_timeout/leave_setup_mode.
    candidates = wifi_net.usb_candidates(adapters)
    if not candidates:
        logger.debug("Auto-recovery: no USB candidates; hotspot retained")
        return

    # Resolve UUID (lazily persisting if missing) and clear cross-adapter
    # restrictions once before probing USB candidates.
    recovery_uuid = _resolve_committed_uuid(state)
    if recovery_uuid:
        run_cmd(wifi_net.clear_restrictions_cmd(recovery_uuid, wifi_net.CROSS_ADAPTER_RESTRICTIONS))

    for candidate in candidates:
        logger.info("Auto-recovery: probing USB %s", candidate.ifname)
        r_up = run_cmd(wifi_net.activate_connection_cmd(
            recovery_uuid, state.connection_name, candidate.ifname,
        ))
        if _activation_network_absent(r_up):
            logger.info("Auto-recovery: saved network not visible on %s; skipping IPv4 wait",
                        candidate.ifname)
            wifi_recovery.record_noip_failure(_self_module(), candidate.stable_id, time.monotonic())
            continue
        if (wait_for_connection(candidate.ifname,
                                timeout=WAIT_FOR_CONNECTION_TIMEOUT,
                                interval=WAIT_FOR_CONNECTION_INTERVAL)
                and is_wifi_client_healthy(candidate.ifname)):
            _set_active_client(candidate)
            wifi_recovery.clear_noip_failures(_self_module(), candidate.stable_id)
            leave_setup_mode("automatic_recovery: adapter returned and reconnected")
            verify_avahi_after_handover()
            logger.info("Auto-recovery resolved on %s", candidate.ifname)
            return
        wifi_recovery.record_noip_failure(_self_module(), candidate.stable_id, time.monotonic())
    logger.debug("Auto-recovery probe failed; retaining hotspot")


def _saved_network_ssid() -> str:
    """Return the SSID of the committed network profile, or "" if unknown."""
    state = get_configured_network_state()
    name = state.connection_uuid or state.connection_name
    return wifi_net.get_connection_ssid(name) if name else ""


def _saved_ssid_visible(hotspot_adapter) -> bool:
    """True when the saved SSID is visible in a scan on the hotspot radio.

    Scanning works in AP mode on the onboard radio without dropping the AP, so a
    single-radio recovery hotspot can cheaply check for the network's return
    before committing to the expensive tear-down→join (Section 2.8).
    """
    ssid = _saved_network_ssid()
    if not ssid:
        return False
    scan = wifi_net.scan_adapter(hotspot_adapter)
    return scan is not None and ssid in scan


def _single_radio_recovery_join(hotspot) -> bool:
    """Drop the AP, join the saved network on the sole radio, rebuild on failure.

    The hotspot session stays intact across stop_ap_mode (it tears down only the
    nmcli AP), so a failed join simply rebuilds the hotspot; a successful join
    leaves setup mode.
    """
    logger.info("Recovery: single-radio rejoin on %s (saved SSID visible)", hotspot.ifname)
    stop_ap_mode()
    if _activate_committed_on(hotspot.ifname):
        adapters = wifi_net.discover_adapters()
        recovered = wifi_net.find_adapter_by_ifname(adapters, hotspot.ifname)
        if recovered is not None:
            _set_active_client(recovered)
            wifi_recovery.clear_noip_failures(_self_module(), recovered.stable_id)
        leave_setup_mode("recovery: single-radio rejoin succeeded")
        verify_avahi_after_handover()
        return True
    logger.warning("Single-radio recovery join failed on %s; rebuilding hotspot", hotspot.ifname)
    with state_lock:
        STATE.setup_mode = True
    start_ap_mode()
    update_apmode_flag(True)
    return False


def _usable_second_radio(adapters: list, hotspot_if, now: float):
    """Return a non-hotspot radio still worth probing as a client, else None.

    A wedged (no-carrier), quarantined, or no-IP-suppressed second radio (e.g. a
    dead USB dongle) is NOT usable and must not block the onboard drop-AP rejoin.
    That was the field-log trap (30-Jun-2026): a dead USB was probed for the full
    30-minute hotspot lifetime while the AP-hosting onboard — which could reach the
    network — was never tried as a client.  Usability is read from the shared
    recovery facts so this agrees exactly with next_recovery_action().
    """
    for a in adapters:
        if not a.managed or a.ifname == hotspot_if:
            continue
        rf = _adapter_recovery_facts(a, now)
        if rf.link_down is not True and not rf.quarantined and not rf.noip_suppressed:
            return a
    return None


def _attempt_recovery_reconnect(adapters: list, now: float) -> None:
    """Scan-gated recovery reconnect from within a recovery hotspot (WP6, §2.8).

    With a *usable* second (non-hotspot) client-capable radio, probe it without
    dropping the AP (existing behaviour), bounded by RECONNECT_ATTEMPT_INTERVAL.
    Otherwise — single-radio hardware, or the only second radio is a dead/
    quarantined USB — scan for the saved SSID on the AP-hosting (onboard) radio on
    a RECOVERY_SCAN_INTERVAL cadence and only perform the tear-down→join (also
    join-interval bounded) when the SSID is visible.  This onboard climb is the
    exit edge back to a client that the dead-second-radio case previously lacked.
    """
    hotspot = resolve_hotspot_adapter(adapters)
    hotspot_if = hotspot.ifname if hotspot else None
    usable_other = _usable_second_radio(adapters, hotspot_if, now)

    with state_lock:
        last_reconnect = STATE.last_reconnect_attempt
    join_due = (last_reconnect is None
                or (now - last_reconnect) >= RECONNECT_ATTEMPT_INTERVAL)

    if usable_other is not None:
        # Usable second radio present: probe it (USB-first) without dropping the AP.
        if join_due:
            with state_lock:
                STATE.last_reconnect_attempt = now
            _try_recovery_reconnect(adapters)
        return

    if hotspot is None:
        return

    # Single radio: rate-limit the (cheap) scan independently of the loop tick.
    with state_lock:
        last_scan = STATE.last_recovery_scan
    scan_due = last_scan is None or (now - last_scan) >= RECOVERY_SCAN_INTERVAL
    if not scan_due:
        return
    with state_lock:
        STATE.last_recovery_scan = now
    if not _saved_ssid_visible(hotspot):
        logger.debug("Recovery scan: saved SSID not visible on %s; AP retained", hotspot.ifname)
        return
    if not join_due:
        return
    with state_lock:
        STATE.last_reconnect_attempt = now
    _single_radio_recovery_join(hotspot)


def handle_runtime_usb_adoption(adapters: list, wired_connected: bool,
                                playing_fn=None) -> bool:
    """Optional idle-time adoption of a newly available USB adapter (Section 8.2).

    Adopts USB only when: Ethernet is not active; built-in carries a healthy
    Wi-Fi client (or built-in fallback is active); no USB is already the active
    client; the same deterministic USB candidate has been present for two passes;
    and (main appliance) playback is confirmed idle.  Returns True if a handover
    was performed.  *playing_fn* is the per-pass memoised playback resolver; it
    defaults to query_playing_status for direct callers/tests.
    """
    if playing_fn is None:
        playing_fn = query_playing_status
    now = time.monotonic()
    with state_lock:
        in_setup = STATE.setup_mode
    if in_setup or wired_connected:
        _clear_pending_adoption()
        return False

    usb = wifi_net.usb_candidates(adapters)
    if not usb:
        _clear_pending_adoption()
        return False
    candidate = usb[0]

    # Escalating no-IP back-off (WP5b): a dongle that repeatedly associates but
    # cannot get an IP is held back (and eventually stopped) instead of thrashing
    # adoption every cycle.
    if wifi_recovery.noip_retry_suppressed(_self_module(), candidate.stable_id, now):
        return False

    active_client = resolve_active_client(adapters)
    # Do not switch from a healthy USB client to another USB adapter.
    if active_client is not None and active_client.is_usb:
        _clear_pending_adoption()
        return False
    # Built-in must currently carry a healthy client (direct or fallback).
    builtin = wifi_net.resolve_builtin(adapters)
    if builtin is None or not is_wifi_client_healthy(builtin.ifname):
        _clear_pending_adoption()
        return False

    # Two-pass stability on the same deterministic candidate.
    with state_lock:
        if STATE.pending_usb_adoption_mac == candidate.permanent_mac:
            STATE.pending_usb_adoption_checks += 1
        else:
            STATE.pending_usb_adoption_mac = candidate.permanent_mac
            STATE.pending_usb_adoption_checks = 1
        checks = STATE.pending_usb_adoption_checks
    if checks < USB_ADOPTION_STABLE_PASSES:
        return False

    # Playback gating (main appliance only).
    playing = playing_fn()
    if playing is None:
        logger.debug("USB adoption deferred: playback status uncertain")
        return False
    if playing:
        log_on_change("usb_adopt_deferred_playing", True,
                      "USB adoption deferred because playback is active")
        return False

    # Transactional handover: validate USB before deactivating built-in.
    logger.info("Runtime USB adoption starting on %s", candidate.ifname)
    if _activate_committed_on(candidate.ifname):
        # Deactivate the previous built-in client connection.
        run_cmd(["nmcli", "device", "disconnect", builtin.ifname])
        with state_lock:
            STATE.using_builtin_fallback = False
        _set_active_client(candidate)
        _clear_pending_adoption()
        wifi_recovery.clear_noip_failures(_self_module(), candidate.stable_id)
        logger.info("Runtime USB adoption succeeded on %s", candidate.ifname)
        verify_avahi_after_handover()
        return True

    logger.warning("Runtime USB adoption failed on %s; retaining built-in", candidate.ifname)
    # Record the no-IP failure to escalate the back-off (replaces the fixed
    # usb_adoption_retry_after interval) and surface the DEGRADED_NO_IP status.
    wifi_recovery.record_noip_failure(_self_module(), candidate.stable_id, now)
    _clear_pending_adoption()
    return False


def _clear_pending_adoption() -> None:
    with state_lock:
        STATE.pending_usb_adoption_mac = None
        STATE.pending_usb_adoption_checks = 0


def update_known_adapters(adapters: list) -> None:
    """Track USB MACs and log adapter-set changes at INFO on transition."""
    macs = frozenset(a.permanent_mac for a in adapters if a.permanent_mac)
    for a in adapters:
        if a.is_usb and a.permanent_mac:
            _known_usb_macs.add(a.permanent_mac)
    with state_lock:
        prev = STATE.last_detected_adapter_macs
        STATE.last_detected_adapter_macs = macs
    if prev is not None and prev != macs:
        logger.info("Detected Wi-Fi adapter set changed: %s", sorted(macs))
    # Drop no-IP ledgers for adapters that are no longer present so a replaced
    # or removed dongle starts fresh (the back-off ceiling releases, WP5b).  The
    # ledger is keyed by stable_id (permanent MAC, else ifname), so prune by the
    # present stable_ids — not just permanent MACs — or a MAC-less adapter's
    # ledger would be dropped every pass.
    present_stable_ids = {a.stable_id for a in adapters if a.stable_id}
    wifi_recovery.prune_noip_ledgers(_self_module(), present_stable_ids)


