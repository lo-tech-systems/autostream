# /etc/sudoers.d/autostream_dial
#
# Enumerated sudo privileges for the autostream service user.
# Four verbs only.  write-playing-service and remove-playing-service are NOT
# included — those manage the autostream appliance's playing announcement and
# are not needed on a dial-only device (co-installation is unsupported).
#
# This file is part of autostream dial.
# Copyright (c) 2025-2026 Lo-tech Systems Limited. All rights reserved.
#

autostream ALL=(root) NOPASSWD: /usr/local/libexec/autostream/autostream_admin update-dial-service * * *
autostream ALL=(root) NOPASSWD: /usr/local/libexec/autostream/autostream_admin run-updater
autostream ALL=(root) NOPASSWD: /usr/local/libexec/autostream/autostream_admin toggle-dial-update-timer enable
autostream ALL=(root) NOPASSWD: /usr/local/libexec/autostream/autostream_admin toggle-dial-update-timer disable
