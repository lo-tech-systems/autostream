# Allow the autostream web user to run ONLY the autostream_admin helper
# in its intended modes, as root, without a password.

User_Alias AUTOSTREAM_WEB = autostream
User_Alias AUTOSTREAM_NGINX = www-data

# add allowed reasons explicitly
Cmnd_Alias AUTOSTREAM_ADMIN_REBOOT_AU         = /usr/local/libexec/autostream/autostream_admin reboot AutostreamUpdate
Cmnd_Alias AUTOSTREAM_ADMIN_REBOOT_URN        = /usr/local/libexec/autostream/autostream_admin reboot UserRequestNormal
Cmnd_Alias AUTOSTREAM_ADMIN_REBOOT_URN_DELAY  = /usr/local/libexec/autostream/autostream_admin reboot --delay 3 UserRequestNormal
Cmnd_Alias AUTOSTREAM_ADMIN_REBOOT_URSE       = /usr/local/libexec/autostream/autostream_admin reboot UserRequestSystemError
Cmnd_Alias AUTOSTREAM_ADMIN_REBOOT_URSE_DELAY = /usr/local/libexec/autostream/autostream_admin reboot --delay 3 UserRequestSystemError
Cmnd_Alias AUTOSTREAM_ADMIN_REBOOT_ND         = /usr/local/libexec/autostream/autostream_admin reboot NetworkDown

# allow owntone service restart
Cmnd_Alias AUTOSTREAM_ADMIN_OWNTONE     = /usr/local/libexec/autostream/autostream_admin restart-owntone

# allow read-only access to update status for offline nginx pages
Cmnd_Alias AUTOSTREAM_ADMIN_UPDATE_STATUS = /usr/local/libexec/autostream/autostream_admin update-status
Cmnd_Alias AUTOSTREAM_ADMIN_VERSION_INFO  = /usr/local/libexec/autostream/autostream_admin version-info

# allow the webui to change the hostname (note - hostname regex is enforced within autostream_admin)
Cmnd_Alias AUTOSTREAM_ADMIN_HOST        = /usr/local/libexec/autostream/autostream_admin sethostname *

# allow factory reset (scheduling only — no arguments, no --execute flag)
Cmnd_Alias AUTOSTREAM_ADMIN_FACTORY_RESET = /usr/local/libexec/autostream/autostream_admin factory-reset

# allow toggling the autostream auto-update timer
Cmnd_Alias AUTOSTREAM_ADMIN_TOGGLE_TIMER_EN = /usr/local/libexec/autostream/autostream_admin toggle-update-timer enable
Cmnd_Alias AUTOSTREAM_ADMIN_TOGGLE_TIMER_DI = /usr/local/libexec/autostream/autostream_admin toggle-update-timer disable

# Full list of allowed actions for autostream user:
Cmnd_Alias AUTOSTREAM_ADMIN = AUTOSTREAM_ADMIN_REBOOT_AU,         \
                              AUTOSTREAM_ADMIN_REBOOT_URN,        \
                              AUTOSTREAM_ADMIN_REBOOT_URN_DELAY,  \
                              AUTOSTREAM_ADMIN_REBOOT_URSE,       \
                              AUTOSTREAM_ADMIN_REBOOT_URSE_DELAY, \
                              AUTOSTREAM_ADMIN_REBOOT_ND,         \
                              AUTOSTREAM_ADMIN_OWNTONE,           \
                              AUTOSTREAM_ADMIN_UPDATE_STATUS,     \
                              AUTOSTREAM_ADMIN_VERSION_INFO,      \
                              AUTOSTREAM_ADMIN_HOST,              \
                              AUTOSTREAM_ADMIN_FACTORY_RESET,     \
                              AUTOSTREAM_ADMIN_TOGGLE_TIMER_EN,   \
                              AUTOSTREAM_ADMIN_TOGGLE_TIMER_DI

Defaults!AUTOSTREAM_ADMIN env_reset
Defaults!AUTOSTREAM_ADMIN secure_path="/usr/sbin:/usr/bin:/sbin:/bin"
Defaults!AUTOSTREAM_ADMIN !requiretty

AUTOSTREAM_WEB ALL=(root) NOPASSWD: AUTOSTREAM_ADMIN

# Dial mDNS service management (playing-state announcement)
autostream ALL=(root) NOPASSWD: /usr/local/libexec/autostream/autostream_admin write-playing-service *
autostream ALL=(root) NOPASSWD: /usr/local/libexec/autostream/autostream_admin remove-playing-service

# Also allow the NGINX user to reboot the host and trigger factory reset
# and read the latest update status for the offline updating page
AUTOSTREAM_NGINX ALL=(root) NOPASSWD: AUTOSTREAM_ADMIN_REBOOT_URSE_DELAY, AUTOSTREAM_ADMIN_FACTORY_RESET, AUTOSTREAM_ADMIN_UPDATE_STATUS
