[Unit]
Description=Autostream audio monitor daemon
After=sound.target systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=simple
User=autostream
Group=autostream
UMask=022
WorkingDirectory=/opt/autostream

# Media path must outrank default-priority housekeeping; see autostream.service
# and owntone.service for the rest of the ladder.
Nice=-12

# FIFO format-switch: optional file supplying AUTOSTREAM_MONITOR_ARGS
# (currently only ever "--compatible" or empty). The leading "-" makes a
# missing file non-fatal, so a fresh install with no file yet still starts
# the monitor in native (default) mode. Written by autostream_player_service
# (core/autostream_player_service.py, reconcile_monitor_format()) as the
# autostream user -- /etc/autostream is owned by autostream:autostream.
EnvironmentFile=-/etc/autostream/monitor_args.env

# Long-lived audio capture daemon used by autostream_core.py
ExecStart=/opt/autostream/monitor/autostream_monitor $AUTOSTREAM_MONITOR_ARGS

Restart=on-failure
RestartSec=5

StandardOutput=append:/var/log/autostream/autostream_monitor.log
StandardError=append:/var/log/autostream/autostream_monitor.log

TimeoutStopSec=10

# Prefer killing this daemon over other processes in a worst-case OOM (auto-restarts in 5s)
OOMScoreAdjust=200

[Install]
WantedBy=multi-user.target
