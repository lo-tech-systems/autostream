[Unit]
Description=Autostream audio coordinator
After=sound.target autostream_monitor.service vibra-mini.service
Wants=autostream_monitor.service vibra-mini.service
# Deliberately NOT Requires=autostream_monitor.service: a hard Requires=
# means systemd stops autostream.service whenever autostream_monitor.service
# is stopped for ANY reason -- including a plain `systemctl restart
# autostream_monitor` (stop-then-start), which propagates a SIGTERM to this
# unit too, killing the very admin call that requested the monitor restart.
# That restart is routine: core/autostream_player_service.py's
# reconcile_monitor_format() fires it via the "restart-monitor" admin
# verb whenever the monitor's --compatible arg needs to change, and
# autostream's own MonitorClient already has reconnect/resync machinery
# built specifically to ride out a monitor restart or crash -- so autostream
# does not need, and must not take, a hard dependency on the monitor's
# lifecycle. Wants= (above) plus After= still give correct boot-time
# ordering (start the monitor first, but don't fail/stop autostream if it
# isn't up) without coupling the two services' running state together.

[Service]
# Run as the autostream user
User=autostream
Group=autostream

# Project directory
WorkingDirectory=/opt/autostream

ExecStart=/opt/autostream/venv/bin/python3 /opt/autostream/autostream_webui.py /etc/autostream/autostream.json

# Restart if it crashes
Restart=on-failure
RestartSec=5

# Environment (optional – make sure arecord & python3 are in PATH)
Environment=PYTHONUNBUFFERED=1

# Publish now-playing metadata (title/artist/album and cover art) to OwnTone
# over the <audio_fifo>.metadata pipe, so AirPlay receivers such as an Apple TV
# can show what is playing. Without this the pipe is never created and OwnTone
# logs that it cannot open it.
Environment=AUTOSTREAM_ENABLE_PIPE_METADATA=1

# Let script handle its own logging, but also capture stdout/stderr in journal
StandardOutput=journal
StandardError=journal

# Give it a bit of time to shut down cleanly
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
