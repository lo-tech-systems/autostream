[Unit]
Description=Detect a SD Card Health Probe That Did Not Complete Before This Boot
After=local-fs.target
Before=timers.target autostream.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/autostream/autostream_sdcardhealth boot-check

[Install]
WantedBy=multi-user.target
