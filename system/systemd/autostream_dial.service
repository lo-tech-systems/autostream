[Unit]
Description=autostream dial
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=autostream
WorkingDirectory=/opt/autostream
ExecStart=/opt/autostream/venv/bin/python /opt/autostream/dial_main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autostream-dial

[Install]
WantedBy=multi-user.target
