[Unit]
Description=vibra-mini Shazam recognition daemon for Autostream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autostream
Group=autostream
UMask=077
WorkingDirectory=/opt/autostream

ExecStart=/opt/autostream/vibra/bin/vibra-mini --socket /tmp/vibra-mini.sock --log-level info

Restart=on-failure
RestartSec=5

StandardOutput=append:/var/log/autostream/vibra-mini.log
StandardError=append:/var/log/autostream/vibra-mini.log

TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
