[Unit]
Description=WiFi Setup State Machine (AP Mode + Captive Portal based WiFi Config)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
UMask=022
WorkingDirectory=/opt/autostream

ExecStart=/opt/autostream/autostream_wifi_watcher

Environment=APP_AP_PREFIX=autostream
Environment=APP_TITLE=autostream
Environment=APP_CHECK_CPU=yes
Environment=APP_DNSMASQ_TEMPLATE=/usr/local/share/autostream/dnsmasq/autostream-setup.conf
Environment=APP_DNSMASQ_RUNTIME=/run/autostream/autostream-setup.conf
# APP_APMODE_FLAG and APP_DNSMASQ_SERVICE are intentionally unset here so the
# defaults (/tmp/apmode and autostream_dnsmasq.service) are used, preserving
# existing nginx and autostream_updater AP-mode check behaviour.

# Log level for the wifi watcher. Valid values: fatal, log, warning, info, debug, spam
#Environment=AUTOSTREAM_WIFI_LOG_LEVEL=info

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
