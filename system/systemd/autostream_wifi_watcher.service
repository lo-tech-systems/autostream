[Unit]
Description=WiFi Setup State Machine (AP Mode + Captive Portal based WiFi Config)
After=NetworkManager.service autostream_update_retry.service
Wants=NetworkManager.service
# D-WP0: with Phase D (client profiles autoconnect=no) the watcher process is the
# sole Wi-Fi reconnection agent, so a crash or clean exit that stops it must never
# be permanent.  StartLimitIntervalSec=0 disables the start-rate limiter so the
# service always retries and can never land in "start-limit-hit".
StartLimitIntervalSec=0

[Service]
Type=simple
UMask=022
WorkingDirectory=/opt/autostream

ExecStart=/opt/autostream/autostream_wifi_watcher

Environment=APP_AP_PREFIX=autostream
Environment=APP_TITLE=autostream
Environment=APP_CHECK_CPU=yes
Environment=APP_DNSMASQ_TEMPLATE=/usr/local/share/autostream/dnsmasq/autostream-setup.conf
Environment=APP_DNSMASQ_RUNTIME=/run/autostream/autostream-setup.conf
# APP_APMODE_FLAG and APP_DNSMASQ_SERVICE are intentionally unset here so the
# defaults (/tmp/apmode and autostream_dnsmasq.service) are used, preserving
# existing nginx and autostream_updater AP-mode check behaviour.

# Log level for the wifi watcher. Valid values: fatal, log, warning, info, debug, spam
#Environment=AUTOSTREAM_WIFI_LOG_LEVEL=info

# D-WP0: Restart=always (was on-failure) so a *clean* exit — e.g. app.run()
# returning — also restarts the watcher; under Phase D nothing else rejoins Wi-Fi
# or raises a hotspot if this process stops.
Restart=always
RestartSec=5
# WatchdogSec/Type=notify (restart of a *wedged*, not crashed, process) is
# deferred to the follow-on async-activation workstream (WS1): today the monitor
# loop blocks synchronously up to ~45s per adapter during activation, so a
# watchdog would fire mid-activation and cause spurious restarts.  WS1 moves
# activation off the loop thread and adds sd_notify pings that continue during a
# job, at which point WatchdogSec becomes safe.  Until then a wedged process is
# recovered by the watcher's own reboot domains (request_guarded_reboot).

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
