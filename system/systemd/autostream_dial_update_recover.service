# /etc/systemd/system/autostream_dial_update_recover.service
#
# Boot-time oneshot for the update lifecycle.  It runs before the dial, the
# Wi-Fi watcher, the updater and nginx so that, before any of them starts:
#   - a staged update is swapped in (new code tree and virtualenv), and its
#     health check is scheduled;
#   - a swap that never reached a verdict is rolled back;
#   - an update run cut short by a power loss is retried, or marked failed.
#
# It runs under the system interpreter, not the virtualenv: the virtualenv is
# one of the things it switches, and it must work whichever one the symlink
# points at.
#
# After=local-fs.target ensures /var/lib/autostream/ and /opt/autostream are
# mounted.  Enabled unconditionally by the installer.
#
# This file is part of autostream dial.
# Copyright (c) 2025-2026 Lo-tech Systems Limited. All rights reserved.
#

[Unit]
Description=Swap in, verify, roll back or retry an autostream dial update
DefaultDependencies=no
After=local-fs.target
Before=autostream_dial.service autostream_dial_wifi_watcher.service autostream_dial_updater.service nginx.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300
ExecStart=/usr/bin/python3 /usr/local/libexec/autostream/autostream_dial_updater boot
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autostream-dial-recover

[Install]
WantedBy=multi-user.target
