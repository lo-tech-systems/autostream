[Unit]
Description=WiFi Setup State Machine for autostream dial
After=NetworkManager.service
Wants=NetworkManager.service
# Client profiles are configured autoconnect=no, so the watcher process is the
# sole Wi-Fi reconnection agent, and a crash or clean exit that stops it must
# never be permanent.  StartLimitIntervalSec=0 disables the start-rate limiter so
# the service always retries and can never land in "start-limit-hit".
StartLimitIntervalSec=0

[Service]
Type=simple
UMask=022
WorkingDirectory=/opt/autostream
ExecStart=/opt/autostream/autostream_wifi_watcher

Environment=APP_AP_PREFIX=autostream-dial
Environment=APP_APMODE_FLAG=/tmp/autostream-dial-apmode
Environment=APP_DNSMASQ_SERVICE=autostream_dial_dnsmasq.service
Environment=APP_DNSMASQ_TEMPLATE=/usr/local/share/autostream/dnsmasq/autostream-dial-setup.conf
Environment=APP_DNSMASQ_RUNTIME=/run/autostream/autostream-dial-setup.conf
Environment="APP_TITLE=autostream dial"
Environment=APP_CHECK_CPU=no
Environment=APP_BANNER_IMAGE=/autostream-dial-badge.png
Environment=APP_DIAL_MODE=1

# Restart=always (rather than on-failure) so a *clean* exit — e.g. app.run()
# returning — also restarts the watcher; nothing else rejoins Wi-Fi or raises a
# hotspot if this process stops.
Restart=always
RestartSec=5
# WatchdogSec/Type=notify (restart of a *wedged*, not crashed, process) is not
# used yet: today the monitor loop blocks synchronously up to ~45s per adapter
# during activation, so a watchdog would fire mid-activation and cause spurious
# restarts.  Moving activation off the loop thread and adding sd_notify pings
# that continue during a job would make WatchdogSec safe.  Until then a wedged
# process is recovered by the watcher's own reboot domains
# (request_guarded_reboot).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autostream-dial-wifi

[Install]
WantedBy=multi-user.target
